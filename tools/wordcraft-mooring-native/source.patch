diff --git a/crates/ui-egui/src/mooring_boundary.rs b/crates/ui-egui/src/mooring_boundary.rs
new file mode 100644
index 00000000..67696271
--- /dev/null
+++ b/crates/ui-egui/src/mooring_boundary.rs
@@ -0,0 +1,159 @@
+//! EXPERIMENTAL inactive native command seam. A local UX gate, never authority.
+use crate::WordApp;
+use serde_json::Value;
+use std::{rc::Rc, sync::Arc};
+use wordcraft_doc::Document;
+use wordcraft_engine::{CmdError, Session};
+
+/// Synchronous app-owned hooks. Pure before/validate may NEVER emit a proposal.
+/// A successful outer command emits its original client update only afterwards.
+/// There is no transport, host Saved or authentication contract in this trait.
+pub enum NativeHistoryError {
+    /// Pure local refusal, no new original was emitted; history stays intact.
+    Refused(String),
+    /// Original capture may have happened; retain Draft and block further edits.
+    Draft,
+}
+pub trait NativeCommandBridge {
+    fn can_edit(&self) -> bool;
+    fn before(&self, session: &Session, id: &str, params: &Value) -> Result<(), CmdError>;
+    fn validate(&self, before: &Document, after: &Document) -> Result<(), CmdError>;
+    fn authored(&self, before: &Document, after: &Document) -> Result<(), String>;
+    /// LOCAL failure diagnostic only. It may stop UI, never grant authority or Saved.
+    fn capture_failed(&self) {}
+    /// LOCAL SDK history only, never native file history or a host receipt.
+    fn history(&self, _before: &Document, _id: &str) -> Result<Document, NativeHistoryError> {
+        Err(NativeHistoryError::Refused("collaborative history unavailable".into()))
+    }
+}
+impl WordApp {
+    /// Prototype attachment only; caller labels are not host authority.
+    pub fn attach_mooring_bridge(&mut self, bridge: Rc<dyn NativeCommandBridge>) -> Result<(), String> {
+        if self.mooring_bridge.is_some() {
+            return Err("existing original draft controller must be retained".into());
+        }
+        self.session.require_outer_text_boundary().map_err(|error| error.to_string())?;
+        self.mooring_bridge = Some(bridge);
+        Ok(())
+    }
+}
+
+fn text_command(id: &str) -> bool {
+    matches!(id, "text.insert" | "text.backspace" | "text.delete" | "format.bold" | "format.italic" | "edit.undo" | "edit.redo")
+}
+impl WordApp {
+    pub(crate) fn mooring_early_gate(&self, id: &str) -> Result<(), String> {
+        let Some(bridge) = &self.mooring_bridge else { return Ok(()) };
+        let can_edit =
+            std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| bridge.can_edit())).map_err(|_| "native edit gate failed".to_string())?;
+        if self.session.mooring_read_command(id) || (!self.mooring_blocked && can_edit && text_command(id)) {
+            Ok(())
+        } else {
+            Err("unqualified collaborative command".into())
+        }
+    }
+    pub(crate) fn mooring_execute_native(&mut self, id: &str, params: &Value) -> Result<Value, String> {
+        let Some(bridge) = self.mooring_bridge.clone() else {
+            return self.session.run(id, params).map_err(|e| e.to_string());
+        };
+        if self.session.mooring_read_command(id) {
+            return self.session.run(id, params).map_err(|e| e.to_string());
+        }
+        if matches!(id, "edit.undo" | "edit.redo") {
+            let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| bridge.history(&self.session.doc, id)));
+            match result {
+                Ok(Err(NativeHistoryError::Refused(reason))) => return Err(reason),
+                Ok(Ok(projected)) if self.apply_mooring_text_projection(&projected).is_ok() => {
+                    return Ok(serde_json::json!({"localDraft":true}));
+                }
+                _ => {}
+            }
+            self.mooring_blocked = true;
+            self.status("Unsaved Draft: original history capture failed");
+            let _ = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| bridge.capture_failed()));
+            return Err("unsaved draft retained".into());
+        }
+        let before = self.session.doc.clone();
+        let result = self
+            .session
+            .run_guarded_text_command(id, params, |session| bridge.before(session, id, params), |before, after| bridge.validate(before, after))
+            .map_err(|e| e.to_string())?;
+        // Native rollback is no longer legal: an authored original proposal may
+        // already exist. Failure leaves native local Draft visible for recovery.
+        let emitted = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| bridge.authored(&before, &self.session.doc)));
+        if !matches!(emitted, Ok(Ok(()))) {
+            self.mooring_blocked = true;
+            self.status("Unsaved Draft: original proposal capture failed");
+            let _ = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| bridge.capture_failed()));
+            return Err("unsaved draft retained".into());
+        }
+        Ok(result)
+    }
+}
+
+impl WordApp {
+    /// No host receipt exists in this prototype; file saves cannot imply Saved.
+    pub fn mooring_local_state(&self) -> Option<&'static str> {
+        self.mooring_bridge.as_ref().map(|_| if self.mooring_blocked { "unsaved_draft" } else { "draft" })
+    }
+}
+
+impl WordApp {
+    /// LOCAL projection after the SDK validated actual host bytes or authored
+    /// its original undo/redo. This is not a host receipt or transport check.
+    /// Only existing paragraph text/runs may change. Session/document identity,
+    /// native history and every other native field remain owned by this app.
+    pub fn apply_mooring_text_projection(&mut self, expected: &Document) -> Result<(), String> {
+        if self.mooring_bridge.is_none() || self.mooring_blocked || expected.body.len() != self.session.doc.body.len() || expected.body.len() > 4096 {
+            return Err("invalid collaborative projection".into());
+        }
+        let mut projected = self.session.doc.clone();
+        for (old, new) in projected.body.iter_mut().zip(&expected.body) {
+            let (wordcraft_doc::Block::Para(old), wordcraft_doc::Block::Para(new)) = (Arc::make_mut(old), new.as_ref()) else {
+                return Err("unsupported collaborative projection".into());
+            };
+            old.text.clone_from(&new.text);
+            old.runs.clone_from(&new.runs);
+        }
+        if serde_json::to_value(&projected).map_err(|_| "invalid collaborative projection")?
+            != serde_json::to_value(expected).map_err(|_| "invalid collaborative projection")?
+        {
+            return Err("collaborative metadata changed".into());
+        }
+        // Complete precondition above BEFORE touching actual native objects.
+        for (old, new) in self.session.doc.body.iter_mut().zip(&expected.body) {
+            let (wordcraft_doc::Block::Para(old), wordcraft_doc::Block::Para(new)) = (Arc::make_mut(old), new.as_ref()) else {
+                return Err("unsupported collaborative projection".into());
+            };
+            old.text.clone_from(&new.text);
+            old.runs.clone_from(&new.runs);
+            old.touch();
+        }
+        for pos in [&mut self.session.sel.anchor, &mut self.session.sel.focus] {
+            if pos.story != wordcraft_doc::StoryRef::Body || pos.path.0.len() != 1 {
+                continue;
+            }
+            if let Some(text) =
+                pos.path.0.first().and_then(|i| self.session.doc.body.get(*i as usize)).and_then(|b| b.as_para()).map(|p| p.text.as_str())
+            {
+                pos.off = pos.off.min(text.len());
+                while !text.is_char_boundary(pos.off) {
+                    pos.off = pos.off.saturating_sub(1);
+                }
+            }
+        }
+        self.session.touch();
+        self.session.relayout();
+        Ok(())
+    }
+}
+
+impl WordApp {
+    /// Retain local original Draft while immediately denying further mutation.
+    pub fn stop_mooring_bridge(&mut self) {
+        if self.mooring_bridge.is_some() {
+            self.mooring_blocked = true;
+            self.status("Unsaved Draft: collaboration stopped");
+        }
+    }
+}
