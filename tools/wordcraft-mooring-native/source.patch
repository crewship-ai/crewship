+//! Bounded native boundary proof only. No CRDT proposal is emitted here.
+use super::*;
+use serde_json::json;
+fn native(s: &Session) -> Value {
+    serde_json::to_value(&s.doc).unwrap()
+}
+fn snapshot(s: &Session) -> Value {
+    json!({"native":native(s),"selection":s.sel,"pending":s.pending,"prefs":s.prefs,"rev":s.rev,"dirty":s.dirty,"typing_open":s.typing_open,"join_next":s.join_next,"last_command":s.last_command,"recording":s.recording,"history":s.history.iter().map(|x|json!({"label":x.label,"doc":x.doc,"sel":x.sel,"pending":x.pending,"column":format!("{:?}",x.column)})).collect::<Vec<_>>(),"redo":s.redo.iter().map(|x|json!({"label":x.label,"doc":x.doc,"sel":x.sel,"pending":x.pending,"column":format!("{:?}",x.column)})).collect::<Vec<_>>(),"evicted":s.undo_evicted})
+}
+fn unchanged_metadata(before: &Document, after: &Document) -> Result<(), CmdError> {
+    let mut before = serde_json::to_value(before).map_err(|_| CmdError::Failed("native serialization".into()))?;
+    let mut after = serde_json::to_value(after).map_err(|_| CmdError::Failed("native serialization".into()))?;
+    for native in [&mut before, &mut after] {
+        for block in native.get_mut("body").and_then(Value::as_array_mut).ok_or_else(|| CmdError::Failed("native body".into()))? {
+            let block = block.as_object_mut().ok_or_else(|| CmdError::Failed("native block".into()))?;
+            block.remove("text");
+            block.remove("runs");
+        }
+    }
+    if before != after {
+        return Err(CmdError::Disabled("unsupported structural/native mutation".into()));
+    }
+    Ok(())
+}
+fn session() -> Session {
+    Session::new(wordcraft_doc::Document::new())
+}
