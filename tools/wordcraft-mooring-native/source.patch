+#[cfg(all(test, not(target_arch = "wasm32")))]
+mod tests {
+    use crate::{Services, WordApp, mooring_boundary::NativeCommandBridge};
+    use serde_json::{Value, json};
+    use std::{
+        rc::Rc,
+        sync::Arc,
+        time::{Duration, Instant},
+    };
+    use wordcraft_doc::Document;
+    use wordcraft_engine::{CmdError, Session};
+    struct Bridge;
+    impl NativeCommandBridge for Bridge {
+        fn can_edit(&self) -> bool {
+            true
+        }
+        fn before(&self, _: &Session, _: &str, _: &Value) -> Result<(), CmdError> {
+            Ok(())
+        }
+        fn validate(&self, _: &Document, _: &Document) -> Result<(), CmdError> {
+            Ok(())
+        }
+        fn authored(&self, _: &Document, _: &Document) -> Result<(), String> {
+            Ok(())
+        }
+    }
+    fn own_root(label: &str) -> std::path::PathBuf {
+        let nonce = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_nanos();
+        std::env::temp_dir().join(format!("wordcraft-mooring-synthetic-{label}-{}-{nonce}", std::process::id()))
+    }
+    #[test]
+    fn actual_wordapp_pending_native_restore_must_prevent_attachment_without_losing_snapshot() {
+        let root = own_root("recovery");
+        let id = "0123456789abcdef0123456789abcdef";
+        std::fs::create_dir_all(root.join(id)).unwrap();
+        let snapshot = json!({"version":1,"generation":1,"info":{"id":id,"name":"Owned synthetic recovery only","savedAt":"2026-10-24T05:00:00Z"},"document":Document::from_text("RECOVERY MUST NOT REPLACE COLLABORATIVE DOC")});
+        let source = serde_json::to_vec(&snapshot).unwrap();
+        let file = root.join(id).join("snapshot-00000000000000000001.json");
+        std::fs::write(&file, &source).unwrap();
+        let mut session = Session::new(Document::from_text("original collaborative native"));
+        session.enable_recovery(root.clone(), Arc::new(|| {})).unwrap();
+        let until = Instant::now() + Duration::from_secs(5);
+        while !session.recovery_ready() {
+            session.recovery_tick();
+            assert!(Instant::now() < until);
+            std::thread::sleep(Duration::from_millis(2));
+        }
+        assert_eq!(session.recovery_documents().len(), 1);
+        session.run("file.recover", &json!({"restore":id})).unwrap();
+        let mut app = WordApp::new(session, Services::default());
+        let before = app.session.document_id();
+        let attached = app.attach_mooring_bridge(Rc::new(Bridge));
+        let ctx = egui::Context::default();
+        let until = Instant::now() + Duration::from_secs(5);
+        while app.session.document_id() == before {
+            ctx.run_ui(egui::RawInput::default(), |ui| app.logic(ui.ctx())).drop_without_applying_deltas();
+            assert!(Instant::now() < until, "restore never delivered");
+            std::thread::sleep(Duration::from_millis(2));
+        }
+        let result = json!({"attached":attached.is_ok(),"native_document_replaced_by_actual_pending_restore":app.session.document_id()!=before,"source_snapshot_bytes_preserved":std::fs::read(&file).unwrap()==source,"local_state":app.mooring_local_state()});
+        assert!(attached.is_err(), "attached with live native recovery then adopted snapshot: {result}");
+        assert_eq!(app.mooring_local_state(), None);
+        assert_eq!(std::fs::read(&file).unwrap(), source);
+        drop(app);
+        std::fs::remove_dir_all(&root).unwrap();
+    }
+    #[test]
+    fn actual_wordapp_attached_mode_rejects_later_recovery_before_worker_creation() {
+        let mut app = WordApp::new(Session::new(Document::from_text("original")), Services::default());
+        app.attach_mooring_bridge(Rc::new(Bridge)).unwrap();
+        let root = own_root("late-recovery");
+        let result = app.session.enable_recovery(root.clone(), Arc::new(|| {}));
+        assert!(result.is_err(), "native recovery worker accepted after attachment");
+        assert!(!root.exists());
+    }
+}
