@@ -0,0 +1,202 @@
+//! Local browser adapter only. Parent owns authentication, WS and receipt trust.
+use js_sys::Function;
+use std::{
+    cell::{Cell, RefCell},
+    rc::Rc,
+};
+use wasm_bindgen::prelude::*;
+use wordcraft_doc::{Document, StoryRef};
+use wordcraft_engine::{CmdError, Session};
+use wordcraft_ui_egui::mooring_boundary::{NativeCommandBridge, NativeHistoryError};
+
+const MAX_NATIVE: usize = 16 * 1024 * 1024;
+fn captured(doc: &Document) -> Result<String, String> {
+    // NEW native capture boundary: preserve actual f32 expansion in a JSON STRING.
+    let value = serde_json::to_value(doc).map_err(|_| "native capture failed")?;
+    let raw = serde_json::to_string(&value).map_err(|_| "native capture failed")?;
+    if raw.len() > MAX_NATIVE {
+        return Err("native capture exceeds budget".into());
+    }
+    Ok(raw)
+}
+fn document(raw: &str) -> Result<Document, String> {
+    if raw.len() > MAX_NATIVE {
+        return Err("native input exceeds budget".into());
+    }
+    let value: serde_json::Value = serde_json::from_str(raw).map_err(|_| "invalid native input")?;
+    let doc: Document = serde_json::from_value(value.clone()).map_err(|_| "invalid native input")?;
+    if serde_json::to_value(&doc).map_err(|_| "invalid native input")? != value {
+        return Err("lossy native input refused".into());
+    }
+    Ok(doc)
+}
+fn callback(value: &JsValue, key: &str) -> Result<Function, JsValue> {
+    js_sys::Reflect::get(value, &JsValue::from_str(key))?.dyn_into::<Function>().map_err(|_| JsValue::from_str("missing local SDK callback"))
+}
+fn invoke(fun: &Function, args: &[JsValue]) -> Result<JsValue, JsValue> {
+    let array = js_sys::Array::new();
+    for arg in args {
+        array.push(arg);
+    }
+    fun.apply(&JsValue::NULL, &array)
+}
+pub(crate) struct Collaboration {
+    pub(crate) initial: Document,
+    ids: Vec<String>,
+    stopped: Cell<bool>,
+    failure_reported: Cell<bool>,
+    pending: RefCell<Option<Document>>,
+    can_edit: Function,
+    before: Function,
+    validate: Function,
+    authored: Function,
+    history: Function,
+    failed: Function,
+}
+impl Collaboration {
+    pub(crate) fn take_projection(&self) -> Option<Document> {
+        self.pending.borrow_mut().take()
+    }
+    pub(crate) fn stopped(&self) -> bool {
+        self.stopped.get()
+    }
+    pub(crate) fn stop(&self) {
+        self.stopped.set(true);
+    }
+    pub(crate) fn fail(&self) {
+        self.stop();
+        if !self.failure_reported.replace(true) {
+            // Diagnostic only. Stop first and retain originals even if JS throws.
+            let _ = self.failed.call0(&JsValue::NULL);
+        }
+    }
+}
+/// A local handle, never a bearer/capability or a Saved checkpoint installer.
+#[wasm_bindgen]
+pub struct WordCraftCollaborativeHandle {
+    state: Rc<Collaboration>,
+}
+#[wasm_bindgen]
+impl WordCraftCollaborativeHandle {
+    /// Caller MUST first validate host frame/closed data in the SDK and project
+    /// the SAME producer. This native handle verifies only text/runs projection.
+    pub fn project_native(&self, raw: &str) -> Result<(), JsValue> {
+        if self.state.stopped.get() {
+            return Err(JsValue::from_str("projection unavailable"));
+        }
+        let doc = document(raw).map_err(|e| JsValue::from_str(&e))?;
+        // All original peer bytes have already been merged into the SAME SDK producer.
+        // Coalesce display-only projections; retain the complete latest native state.
+        *self.state.pending.borrow_mut() = Some(doc);
+        Ok(())
+    }
+    pub fn stop(&self) {
+        self.state.stop();
+    }
+}
+/// Called ONCE after the isolated child SDK validated authenticated-parent
+/// bootstrap. No token, URL, transport or permission proof is accepted here.
+#[wasm_bindgen]
+pub fn start_collaborative(native_json: &str, stable_ids_json: &str, callbacks: JsValue) -> Result<WordCraftCollaborativeHandle, JsValue> {
+    if !super::web::collaborative_mode() {
+        return Err(JsValue::from_str("collaborative startup not selected"));
+    }
+    if stable_ids_json.len() > 262144 {
+        return Err(JsValue::from_str("invalid stable IDs"));
+    }
+    let initial = document(native_json).map_err(|e| JsValue::from_str(&e))?;
+    let ids: Vec<String> = serde_json::from_str(stable_ids_json).map_err(|_| JsValue::from_str("invalid stable IDs"))?;
+    if ids.len() != initial.body.len()
+        || ids.len() > 4096
+        || ids.is_empty()
+        || ids.iter().any(|id| id.is_empty() || id.len() > 128 || !id.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'_' || b == b'-'))
+        || ids.iter().collect::<std::collections::BTreeSet<_>>().len() != ids.len()
+    {
+        return Err(JsValue::from_str("invalid stable IDs"));
+    }
+    let state = Rc::new(Collaboration {
+        initial,
+        ids,
+        stopped: Cell::new(false),
+        failure_reported: Cell::new(false),
+        pending: RefCell::new(None),
+        can_edit: callback(&callbacks, "can_edit")?,
+        before: callback(&callbacks, "before")?,
+        validate: callback(&callbacks, "validate")?,
+        authored: callback(&callbacks, "authored")?,
+        history: callback(&callbacks, "history")?,
+        failed: callback(&callbacks, "failed")?,
+    });
+    super::web::start_collaborative(state.clone())?;
+    Ok(WordCraftCollaborativeHandle { state })
+}
+impl NativeCommandBridge for Collaboration {
+    fn capture_failed(&self) {
+        self.fail();
+    }
+    fn can_edit(&self) -> bool {
+        !self.stopped.get() && self.pending.borrow().is_none() && self.can_edit.call0(&JsValue::NULL).ok().and_then(|v| v.as_bool()) == Some(true)
+    }
+    fn before(&self, session: &Session, id: &str, _params: &serde_json::Value) -> Result<(), CmdError> {
+        if !self.can_edit() {
+            return Err(CmdError::Disabled("collaborative reader".into()));
+        }
+        let (start, end) = session.sel.ordered();
+        if start.story != StoryRef::Body || end.story != StoryRef::Body || start.path.0.len() != 1 || start.path != end.path {
+            return Err(CmdError::Disabled("unsupported collaborative selection".into()));
+        }
+        let target = start
+            .path
+            .0
+            .first()
+            .and_then(|index| self.ids.get(*index as usize))
+            .ok_or_else(|| CmdError::Disabled("invalid collaborative selection".into()))?;
+        let raw = captured(&session.doc).map_err(CmdError::Disabled)?;
+        invoke(
+            &self.before,
+            &[
+                JsValue::from_str(&raw),
+                JsValue::from_str(target),
+                JsValue::from_str(&start.off.to_string()),
+                JsValue::from_str(&end.off.to_string()),
+                JsValue::from_str(id),
+            ],
+        )
+        .map_err(|_| CmdError::Disabled("local selection refused".into()))?;
+        Ok(())
+    }
+    fn validate(&self, before: &Document, after: &Document) -> Result<(), CmdError> {
+        let a = captured(before).map_err(CmdError::Disabled)?;
+        let b = captured(after).map_err(CmdError::Disabled)?;
+        if invoke(&self.validate, &[JsValue::from_str(&a), JsValue::from_str(&b)]).ok().and_then(|v| v.as_bool()) != Some(true) {
+            return Err(CmdError::Disabled("complete native postcondition refused".into()));
+        }
+        Ok(())
+    }
+    fn authored(&self, before: &Document, after: &Document) -> Result<(), String> {
+        let a = captured(before)?;
+        let b = captured(after)?;
+        if invoke(&self.authored, &[JsValue::from_str(&a), JsValue::from_str(&b)]).ok().and_then(|v| v.as_bool()) != Some(true) {
+            self.stop();
+            return Err("original capture failed".into());
+        }
+        Ok(())
+    }
+    fn history(&self, before: &Document, id: &str) -> Result<Document, NativeHistoryError> {
+        if !self.can_edit() {
+            return Err(NativeHistoryError::Refused("collaborative reader".into()));
+        }
+        let raw = captured(before).map_err(|_| NativeHistoryError::Draft)?;
+        let result = invoke(&self.history, &[JsValue::from_str(&raw), JsValue::from_str(id)]);
+        match result {
+            Ok(value) => document(&value.as_string().ok_or(NativeHistoryError::Draft)?).map_err(|_| NativeHistoryError::Draft),
