+    fn exact_read_navigation_ids_preserve_native_and_never_inherit_pure_external_actions() {
+        let (mut app, bridge) = app(false, false);
+        let before = native(&app);
+        for (id, params) in [
+            ("caret.docEnd", json!({})),
+            ("caret.left", json!({})),
+            ("select.all", json!({})),
+            ("view.state", json!({})),
+            ("view.zoom100", json!({})),
+            ("view.zoomIn", json!({})),
+            ("view.pageWidth", json!({})),
+            ("document.text", json!({})),
+            ("document.inspect", json!({})),
+            ("format.state", json!({})),
+            ("file.info", json!({})),
+        ] {
+            assert!(app.run(id, params).is_ok(), "audited {id} refused");
+            assert_eq!(native(&app), before);
+            assert!(app.session.ui_requests.is_empty());
+        }
+        for id in [
+            "view.newWindow",
+            "view.split",
+            "view.interfaceTheme",
+            "view.zoom",
+            "view.fullScreen",
+            "caret.pastCitation",
+            "select.column",
+            "select.objects",
+            "document.setText",
+            "file.save",
+            "engine.execute",
+            "ui.newWindow",
+            "view.futurePureWindow",
+        ] {
+            assert!(!app.session.mooring_read_command(id), "unqualified {id} inherited");
+            assert!(app.run(id, json!({})).is_err(), "unqualified {id} reached UI");
+            assert!(app.session.run(id, &json!({})).is_err(), "unqualified {id} bypassed UI");
+            assert_eq!(native(&app), before);
+            assert!(app.session.ui_requests.is_empty());
