+    let before = snapshot(&s);
+    let result = s.run_guarded_text_command(
+        "text.insert",
+        &json!({"text":"X"}),
+        |_| Err(CmdError::Disabled("reader".into())),
+        |_, _| panic!("reader reached post gate"),
