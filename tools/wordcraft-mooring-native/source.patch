+    #[test]
+    fn actual_wordapp_cannot_emit_unqualified_new_window_request() {
+        let (mut app, bridge) = app(true, false);
+        let before = native(&app);
+        let result = app.session.run("view.newWindow", &json!({}));
+        let emitted = app.session.ui_requests.clone();
+        assert!(result.is_err(), "unqualified NewWindow request emitted: {emitted:?}");
+        assert!(emitted.is_empty());
