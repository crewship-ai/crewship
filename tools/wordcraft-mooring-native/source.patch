@@ -0,0 +1,240 @@
+#[cfg(test)]
+mod tests {
+    use crate::{
+        Services, WordApp,
+        mooring_boundary::{NativeCommandBridge, NativeHistoryError},
+    };
+    use serde_json::{Value, json};
+    use std::{cell::Cell, rc::Rc};
+    use wordcraft_doc::Document;
+    use wordcraft_engine::{CmdError, Session};
+    struct Bridge {
+        writer: bool,
+        refuse: bool,
+        proposals: Cell<usize>,
+        original: Document,
+    }
+    impl NativeCommandBridge for Bridge {
+        fn can_edit(&self) -> bool {
+            self.writer
+        }
+        fn before(&self, _: &Session, _: &str, _: &Value) -> Result<(), CmdError> {
+            if self.writer { Ok(()) } else { Err(CmdError::Disabled("reader".into())) }
+        }
+        fn validate(&self, _: &Document, _: &Document) -> Result<(), CmdError> {
+            if self.refuse { Err(CmdError::Disabled("native postcondition refused".into())) } else { Ok(()) }
+        }
+        fn history(&self, _: &Document, _: &str) -> Result<Document, NativeHistoryError> {
+            Ok(self.original.clone())
+        }
+        fn authored(&self, _: &Document, _: &Document) -> Result<(), String> {
+            self.proposals.set(self.proposals.get() + 1);
+            Ok(())
+        }
+    }
+    fn app(writer: bool, refuse: bool) -> (WordApp, Rc<Bridge>) {
+        let mut app = WordApp::new(Session::new(Document::from_text("aa")), Services::default());
+        let bridge = Rc::new(Bridge { writer, refuse, proposals: Cell::new(0), original: app.session.doc.clone() });
+        app.attach_mooring_bridge(bridge.clone()).unwrap();
+        (app, bridge)
+    }
+    fn native(app: &WordApp) -> Value {
+        serde_json::to_value(&app.session.doc).unwrap()
+    }
+    #[test]
+    fn actual_wordapp_collaborative_undo_reaches_source_controller_without_native_history() {
+        let (mut app, bridge) = app(true, false);
+        let before = native(&app);
+        app.run("text.insert", json!({"text":"x","raw":true})).unwrap();
+        assert_eq!(bridge.proposals.get(), 1);
+        app.execute("edit.undo", json!({})).expect("outer collaborative own-insert undo must reach the original source controller");
+        assert_eq!(native(&app), before);
+        assert_eq!(app.mooring_local_state(), Some("draft"));
+    }
+    #[test]
+    fn actual_peer_projection_retains_identity_and_refuses_metadata_before_mutation() {
+        let (mut app, _) = app(true, false);
+        let identity = app.session.document_id();
+        let mut peer = Session::new(app.session.doc.clone());
+        peer.run("text.insert", &json!({"text":"PEER","raw":true})).unwrap();
+        let expected = serde_json::to_value(&peer.doc).unwrap();
+        app.apply_mooring_text_projection(&peer.doc).unwrap();
+        assert_eq!(native(&app), expected);
+        assert_eq!(app.session.document_id(), identity);
+        assert!(crate::widgets::enabled(&app, "edit.redo"));
+        let mut hostile = peer.doc.clone();
+        hostile.core.title = "changed metadata".into();
+        assert!(app.apply_mooring_text_projection(&hostile).is_err());
+        assert_eq!(native(&app), expected);
+        app.stop_mooring_bridge();
+        assert!(app.apply_mooring_text_projection(&peer.doc).is_err());
+        assert!(app.execute("edit.redo", json!({})).is_err());
+        assert_eq!(native(&app), expected);
+    }
+    #[test]
+    fn actual_wordapp_reader_refuses_before_edit() {
+        let (mut app, b) = app(false, false);
+        let before = native(&app);
+        let rev = app.session.rev();
+        assert!(app.run("text.insert", json!({"text":"x","raw":true})).is_err());
+        assert_eq!(native(&app), before);
+        assert_eq!(app.session.rev(), rev);
+        assert_eq!(b.proposals.get(), 0);
+    }
+    #[test]
+    fn actual_wordapp_postcondition_restores_native_without_emission() {
+        let (mut app, b) = app(true, true);
+        let before = native(&app);
+        assert!(app.run("text.insert", json!({"text":"x","raw":true})).is_err());
+        assert_eq!(native(&app), before);
+        assert_eq!(b.proposals.get(), 0);
+    }
+    #[test]
+    fn actual_wordapp_success_emits_once_after_complete_native() {
+        let (mut app, b) = app(true, false);
+        assert!(app.run("text.insert", json!({"text":"x","raw":true})).is_ok());
+        assert_eq!(b.proposals.get(), 1);
+    }
+    #[test]
+    fn direct_session_mutation_cannot_bypass_actual_wordapp_mode() {
+        let (mut app, _) = app(true, false);
+        let before = native(&app);
+        assert!(app.session.run("text.insert", &json!({"text":"bypass","raw":true})).is_err());
+        assert_eq!(native(&app), before);
+    }
+
+    #[test]
+    fn actual_wordapp_export_cannot_clear_original_draft_or_native_metadata() {
+        let (mut app, b) = app(true, false);
+        let before = native(&app);
+        let path = std::env::temp_dir().join(format!(
+            "wordcraft-mooring-refused-save-{}-{}.json",
+            std::process::id(),
+            std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_nanos()
+        ));
+        assert!(app.execute("file.save", json!({"path":path})).is_err());
+        assert!(!path.exists());
+        assert_eq!(native(&app), before);
+        assert_eq!(b.proposals.get(), 0);
+        app.session.dirty = false;
+        app.session.path = Some(path);
+        assert_eq!(app.mooring_local_state(), Some("draft"));
+    }
+    #[test]
+    fn actual_wordapp_authored_failure_retains_native_draft_and_blocks_replacement() {
+        struct Failing(Cell<usize>);
+        impl NativeCommandBridge for Failing {
+            fn capture_failed(&self) {
+                self.0.set(self.0.get() + 1);
+            }
+            fn can_edit(&self) -> bool {
+                true
+            }
+            fn before(&self, _: &Session, _: &str, _: &Value) -> Result<(), CmdError> {
+                Ok(())
+            }
+            fn validate(&self, _: &Document, _: &Document) -> Result<(), CmdError> {
+                Ok(())
+            }
+            fn authored(&self, _: &Document, _: &Document) -> Result<(), String> {
+                Err("capture uncertain".into())
+            }
+        }
+        let mut app = WordApp::new(Session::new(Document::from_text("aa")), Services::default());
+        let failure = Rc::new(Failing(Cell::new(0)));
+        app.attach_mooring_bridge(failure.clone()).unwrap();
+        let before = native(&app);
+        assert!(app.run("text.insert", json!({"text":"x","raw":true})).is_err());
+        let draft = native(&app);
+        assert_ne!(draft, before);
+        assert_eq!(failure.0.get(), 1, "actual native capture failure must notify the parent-facing local bridge");
+        assert!(app.run("text.insert", json!({"text":"second","raw":true})).is_err());
+        assert_eq!(native(&app), draft);
+        assert!(app.attach_mooring_bridge(Rc::new(Failing(Cell::new(0)))).is_err());
+        assert_eq!(native(&app), draft);
+    }
+
+    #[test]
+    fn actual_reader_keyboard_ime_refuses_without_native_or_pending_format_change() {
+        let (mut app, b) = app(false, false);
+        app.session.pending = Some(wordcraft_doc::props::CharProps { bold: Some(true), ..Default::default() });
+        app.session.sel = wordcraft_engine::Selection::caret(wordcraft_doc::Pos::body(0, 1));
+        let before = native(&app);
+        let pending = app.session.pending.clone();
+        let selection = app.session.sel.clone();
+        let depth = app.session.undo_depth();
+        let ctx = egui::Context::default();
+        for event in [
+            egui::Event::Text("x".into()),
+            egui::Event::Ime(egui::ImeEvent::DeleteSurrounding { before_chars: 1, after_chars: 0 }),
+            egui::Event::Ime(egui::ImeEvent::Commit("Č\u{1f600}".into())),
+        ] {
+            ctx.run_ui(egui::RawInput { events: vec![event], ..Default::default() }, |ui| crate::keys::canvas_events(&mut app, ui.ctx()))
+                .drop_without_applying_deltas();
+            assert_eq!(native(&app), before);
+            assert_eq!(app.session.pending, pending);
+            assert_eq!(app.session.sel, selection);
+            assert_eq!(app.session.undo_depth(), depth);
+        }
+        assert_eq!(b.proposals.get(), 0);
+    }
