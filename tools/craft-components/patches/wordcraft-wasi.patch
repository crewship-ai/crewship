+
+/// A tag that keeps concurrent processes' temporary names apart. WASI has no
+/// process ids; one WASI instance is one process with its own directory.
+fn process_tag() -> u32 {
+    #[cfg(target_os = "wasi")]
+    {
+        0
+    }
+    #[cfg(not(target_os = "wasi"))]
+    {
+        std::process::id()
+    }
+}
