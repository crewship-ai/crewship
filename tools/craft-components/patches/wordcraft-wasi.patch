+    }
+    let mut hash = std::collections::hash_map::DefaultHasher::new();
+    state.editing.as_ref().map(|(thread, index, text)| (thread.0, index, text)).hash(&mut hash);
+    state.reply.hash(&mut hash);
+    state.selected.lead.as_ref().map(|thread| thread.0).hash(&mut hash);
+    hash.finish()
+}
