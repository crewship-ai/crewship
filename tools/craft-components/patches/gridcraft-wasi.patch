+            let d = app.session.active_mut().unwrap();
+            d.saved = d.wb.clone();
+        }
+        app.run("cell.set", json!({"cell":"A2","input":"2"})).unwrap();
+        let check = |app: &mut SheetApp, commands: &str, code: Option<&str>| {
+            let (wb, undo, dirty) = (doc(app).wb.clone(), doc(app).undo.len(), doc(app).is_dirty());
+            let refused = execute_keeping_human(app, commands, false, "x", false).unwrap_err();
+            assert_eq!(refused.code, code, "{commands}: {}", refused.error);
+            assert!(*wb == *doc(app).wb, "{commands}");
+            assert_eq!((doc(app).undo.len(), doc(app).is_dirty()), (undo, dirty), "{commands}");
+        };
+        for commands in [
+            r#"[{"command":"home.insertRows","params":{"rows":"'Sheet1'!1:1"}}]"#,
+            r#"[{"command":"cell.set","params":{"cell":"A1","input":"x"}}]"#,
+            r#"[{"command":"cell.set","params":{"cell":"'Nope'!A1","input":"x"}}]"#,
+            r#"[{"command":"cell.set","params":{"sheet":"Sheet1","cell":"'Sheet1'!A1","input":"x"}}]"#,
+            r#"[{"command":"cell.set","params":{"cell":"'Sheet1'!A1","input":"x","array":true}}]"#,
+            r#"[{"command":"edit.clearContents","params":{}}]"#,
+            r#"[{"command":"range.clear","params":{"range":"'Sheet1'!A1"}}]"#,
+        ] {
+            check(&mut app, commands, Some("not_replayable"));
+        }
+        // A command that fails halfway: the ones before it are rolled back.
+        check(
+            &mut app,
+            r#"[{"command":"cell.set","params":{"cell":"'Sheet1'!A3","input":"x"}},{"command":"range.setValues","params":{"range":"'Sheet1'!not a range","values":[[1]]}}]"#,
+            None,
+        );
+        assert_eq!(value(&app, "A3"), "");
+        // A structural edit by the person since the saved version.
+        app.run("home.insertRows", json!({"rows": "1:1"})).unwrap();
+        check(&mut app, r#"[{"command":"cell.set","params":{"cell":"'Sheet1'!B1","input":"x"}}]"#, Some("not_replayable"));
+        // Undone, the structure is the saved one again and the replay runs.
+        app.run("edit.undo", json!({})).unwrap();
+        assert!(execute_keeping_human(&mut app, r#"[{"command":"cell.set","params":{"cell":"'Sheet1'!B1","input":"x"}}]"#, false, "x", false).is_ok());
+    }
+
+    #[test]
+    fn conflicts_are_capped_and_cut() {
+        let mut app = app();
+        let long = "y".repeat(400);
+        let values: Vec<Vec<String>> = (0..250).map(|_| vec![long.clone()]).collect();
+        app.run("range.setValues", json!({"range":"A1:A250","values": values})).unwrap();
+        let commands = r#"[{"command":"edit.clearContents","params":{"range":"'Sheet1'!A1:A250"}}]"#;
+        let done = execute_keeping_human(&mut app, commands, false, "x", false).unwrap();
+        assert_eq!((done.conflicts.len(), done.truncated), (MAX_CONFLICTS, true));
+        let kept = &done.conflicts[0].kept;
+        assert_eq!(kept.chars().count(), MAX_CONFLICT_CHARS);
+        assert!(kept.ends_with('…'));
+        assert_eq!(value(&app, "A250"), long, "every one of the person's cells stays, reported or not");
+    }
+}
diff --git a/apps/gridcraft-web/src/port_handshake.rs b/apps/gridcraft-web/src/port_handshake.rs
new file mode 100644
index 00000000..55f4931c
--- /dev/null
+++ b/apps/gridcraft-web/src/port_handshake.rs
@@ -0,0 +1,77 @@
+//! One-shot binding of an opaque editor frame to its embedding parent.
+
+/// The bundle declares its identity from the last pinned deployment path segment.
+pub fn bundle_from_path(path: &str) -> Option<&str> {
+    let (_, tail) = path.rsplit_once("/b/")?;
+    let bundle = tail.strip_suffix("/index.html")?;
+    (bundle.len() == 64 && bundle.bytes().all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))).then_some(bundle)
+}
+
+pub struct Handshake {
+    pub parent_origin: String,
+    pub bundle: String,
+    announced: bool,
+    connected: bool,
+}
+
+impl Handshake {
+    pub fn new(parent_origin: String, bundle: String) -> Self {
+        Self { parent_origin, bundle, announced: false, connected: false }
+    }
+
+    pub fn announced(&mut self) {
+        self.announced = true;
+    }
+
+    pub fn accept(&mut self, parent: bool, origin: &str, kind: Option<&str>, protocol: Option<f64>, bundle: Option<&str>, ports: usize) -> bool {
+        if !self.announced
+            || self.connected
+            || !parent
+            || origin != self.parent_origin
+            || kind != Some("gridcraft:connect")
+            || protocol != Some(crate::port_protocol::PROTOCOL)
+            || bundle != Some(self.bundle.as_str())
+            || ports != 1
+        {
+            return false;
+        }
+        self.connected = true;
+        true
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    #[test]
+    fn bundle_identity_is_the_last_pinned_bundle_path_segment() {
+        let hash = "a".repeat(64);
+        for prefix in ["", "/workbook-editor", "/b/old"] {
+            assert_eq!(super::bundle_from_path(&format!("{prefix}/b/{hash}/index.html")), Some(hash.as_str()));
+        }
+        for path in ["/index.html", "/b/short/index.html", "/b/ABC/index.html", "/b/a/other/index.html"] {
+            assert!(super::bundle_from_path(path).is_none());
+        }
+        assert!(super::bundle_from_path(&format!("/b/{}/index.html", "A".repeat(64))).is_none());
+    }
+
+    #[test]
+    fn only_exact_parent_origin_bundle_protocol_and_one_port_bind_once_after_hello() {
+        let hash = "a".repeat(64);
+        let mut binding = super::Handshake::new("https://host.example".into(), hash.clone());
+        assert!(!binding.accept(true, "https://host.example", Some("gridcraft:connect"), Some(2.0), Some(&hash), 1));
+        binding.announced();
+        for (parent, origin, kind, protocol, bundle, ports) in [
+            (false, "https://host.example", Some("gridcraft:connect"), Some(2.0), Some(hash.as_str()), 1),
+            (true, "https://other.example", Some("gridcraft:connect"), Some(2.0), Some(hash.as_str()), 1),
+            (true, "https://host.example", Some("gridcraft:open"), Some(1.0), Some(hash.as_str()), 1),
+            (true, "https://host.example", Some("gridcraft:connect"), Some(1.0), Some(hash.as_str()), 1),
+            (true, "https://host.example", Some("gridcraft:connect"), Some(2.0), Some("wrong"), 1),
+            (true, "https://host.example", Some("gridcraft:connect"), Some(2.0), Some(hash.as_str()), 0),
+            (true, "https://host.example", Some("gridcraft:connect"), Some(2.0), Some(hash.as_str()), 2),
+        ] {
+            assert!(!binding.accept(parent, origin, kind, protocol, bundle, ports));
+        }
+        assert!(binding.accept(true, "https://host.example", Some("gridcraft:connect"), Some(2.0), Some(&hash), 1));
+        assert!(!binding.accept(true, "https://host.example", Some("gridcraft:connect"), Some(2.0), Some(&hash), 1));
+    }
+}
diff --git a/apps/gridcraft-web/src/port_host.rs b/apps/gridcraft-web/src/port_host.rs
new file mode 100644
index 00000000..2a098549
--- /dev/null
+++ b/apps/gridcraft-web/src/port_host.rs
@@ -0,0 +1,358 @@
+//! `?host=port&parent_origin=<canonical HTTP(S) origin>`: a sandboxed, opaque editor frame
+//! bound to its embedding page over one private `MessagePort` (mooring protocol 2).
+//!
+//! - The only window message is a content-free `{type:"gridcraft:hello", protocol:2, bundle}`
+//!   to the parent; `bundle` is the last `/b/<64 hex>/index.html` path segment.
+//! - The exact parent on that origin answers `{type:"gridcraft:connect", protocol:2, bundle}`
+//!   with exactly one port. Every later window frame is ignored; all messages use the port.
+//! - `gridcraft:ready {version, accessProtocol:1, readOnly}`: the frame always starts read-only.
+//! - `open {requestId, name, bytes, calculate, autoFit}` (one per port, .xlsx or .xlsm) answers
+//!   `opened {requestId, document, revision, format, calculated, warnings:[{code, count}]}`.
+//! - `set-access {requestId, readOnly}` answers `access {requestId, readOnly}` once applied.
+//! - Save: the user's Save sends `save-request {requestId, document, revision}`, a host may send
+//!   `save-request {requestId}`; both get `save {requestId, document, revision, name, format,
+//!   bytes}`, the complete workbook file. `save-ack {requestId, document, revision, version}`
+//!   makes exactly that revision the saved baseline; `save-failed {requestId, code, error}`
+//!   leaves it unsaved. Other files the editor would download go out as `export {name, bytes}`.
+//! - `execute {requestId, commands, saved, baseRevision?}` answers `executed`.
+//! - `changed {document, revision, dirty}`, `dirty {dirty}`, `closed {}`, `edit-attempt`,
+//!   `held-input-dropped` and `failed {code, error}` report state.
+//!
+//! An error answer is `{requestId, code, error}`: a host picks its message by `code`; `error` is
+//! for its log only. A malformed message closes the port. This transport grants no runtime
+//! credentials and the editor never runs VBA.
+
+use std::cell::{Cell, RefCell};
+use std::rc::Rc;
+
+use gridcraft_ui_egui::{Services, SheetApp};
+use wasm_bindgen::JsCast as _;
+use wasm_bindgen::JsValue;
+use wasm_bindgen::closure::Closure;
+
+use crate::port_handshake::{Handshake, bundle_from_path};
+use crate::port_protocol::{self, Field};
+use crate::port_session::{Out, PortSession, Value};
+
+struct Port {
+    handshake: Handshake,
+    channel: Option<web_sys::MessagePort>,
+    session: PortSession,
+}
+
+#[derive(Clone)]
+pub struct PortBridge {
+    state: Rc<RefCell<Port>>,
+    /// Saves the user asked for since the last frame (File › Save, Ctrl+S).
+    editor_saves: Rc<Cell<u32>>,
+    window: web_sys::Window,
+    parent: web_sys::Window,
+}
+
+impl PortBridge {
+    /// `None` unless the page is framed, the origin is a canonical HTTP(S) origin without
+    /// credentials, and the page path names its bundle.
+    pub fn new(parent_origin: &str) -> Option<Self> {
+        let url = web_sys::Url::new(parent_origin).ok()?;
+        if !matches!(url.protocol().as_str(), "http:" | "https:")
+            || url.origin() != parent_origin
+            || !url.username().is_empty()
+            || !url.password().is_empty()
+        {
+            return None;
+        }
+        let window = web_sys::window()?;
+        let parent = window.parent().ok().flatten()?;
+        if js_sys::Object::is(&parent, &window) {
+            return None;
+        }
+        let path = window.location().pathname().ok()?;
+        let bundle = bundle_from_path(&path)?.to_string();
+        let port = Port { handshake: Handshake::new(parent_origin.to_string(), bundle), channel: None, session: PortSession::default() };
+        Some(Self { state: Rc::new(RefCell::new(port)), editor_saves: Rc::default(), window, parent })
+    }
+
+    /// Files the editor would download go to the host as exports; nothing opens other pages.
+    pub fn connect(&self, services: &mut Services, ctx: egui::Context) {
+        // The opaque frame cannot load a nested blob/PDF frame or open other pages.
+        services.print = None;
+        services.open_url = None;
+        let bridge = self.clone();
+        services.download = Some(Box::new(move |name: &str, bytes: &[u8]| {
+            let name = std::path::Path::new(name).file_name().map_or_else(|| name.to_string(), |n| n.to_string_lossy().to_string());
+            bridge.post(&Out { kind: "export", fields: vec![("name", Value::Str(name)), ("bytes", Value::Bytes(bytes.to_vec()))] });
+        }));
+        self.listen(ctx);
+    }
+
+    /// The host owns the document: Save asks it to store the file, and the editor starts read-only.
+    pub fn configure(&self, app: &mut SheetApp, ctx: egui::Context) {
+        let saves = self.editor_saves.clone();
+        app.set_managed_document_save(Some(Box::new(move || {
+            if saves.get() >= 8 {
+                return Err("The request queue is full.".into());
+            }
+            saves.set(saves.get() + 1);
+            ctx.request_repaint();
+            Ok(())
+        })));
+        app.set_read_only(true);
+    }
+
+    /// The content-free announcement on the window channel.
+    pub fn post_hello(&self) {
+        let mut state = self.state.borrow_mut();
+        if state.channel.is_some() {
+            return;
+        }
+        let hello = object(&[
+            ("type", "gridcraft:hello".into()),
+            ("protocol", port_protocol::PROTOCOL.into()),
+            ("bundle", state.handshake.bundle.as_str().into()),
+        ]);
+        if let Some(hello) = hello
+            && self.parent.post_message(&hello, &state.handshake.parent_origin).is_ok()
+        {
+            state.handshake.announced();
+        }
+    }
+
+    pub fn post_failed(&self, code: &str, error: &str) {
+        self.post(&Out {
+            kind: "failed",
+            fields: vec![("code", Value::Str(code.into())), ("error", Value::Str(port_protocol::clip(error, port_protocol::MAX_ERROR_CHARS)))],
+        });
+    }
+
+    /// Called before every input, logic and UI phase, never when a request arrives.
+    pub fn apply_access(&self, app: &mut SheetApp, ctx: &egui::Context) {
+        let (out, applied) = self.state.borrow_mut().session.apply_access(app, gridcraft_ui_egui::monotonic_ms());
+        if !applied {
+            return;
+        }
+        if app.is_read_only() {
+            ctx.memory_mut(|memory| {
+                if let Some(focused) = memory.focused() {
+                    memory.surrender_focus(focused);
+                }
+            });
+        }
+        self.post_all(&out);
+        ctx.request_repaint();
+    }
+
+    /// Holds or replays a person's keys before the app sees this frame's input (`held_input`).
+    pub fn capture_input(&self, app: &mut SheetApp, ctx: &egui::Context, raw: &mut egui::RawInput) {
+        let notices = {
+            let mut state = self.state.borrow_mut();
+            // An unconnected frame has no host to answer.
+            let host_read_only = state.channel.is_some() && state.session.access.read_only();
+            state.session.held.capture(app, ctx, raw, host_read_only, gridcraft_ui_egui::monotonic_ms())
+        };
+        self.post_all(&crate::port_session::notices(&notices));
+    }
+
+    pub fn input_emitted(&self, ctx: &egui::Context, raw: &egui::RawInput) {
+        self.state.borrow_mut().session.held.emitted(ctx, raw);
+    }
+
+    /// After each frame: runs what the host asked for and reports changes.
+    pub fn sync(&self, app: &mut SheetApp) {
+        if self.state.borrow().channel.is_none() {
+            return;
+        }
+        let requested = self.editor_saves.replace(0);
+        let out = {
+            let mut state = self.state.borrow_mut();
+            for _ in 0..requested {
+                if let Err(error) = state.session.request_editor_save() {
+                    log::warn!("save not started: {error}");
+                }
+            }
+            state.session.sync(app)
+        };
+        self.post_all(&out);
+    }
+
+    fn listen(&self, ctx: egui::Context) {
+        let bridge = self.clone();
+        let on_connect = Closure::<dyn FnMut(web_sys::MessageEvent)>::new(move |event: web_sys::MessageEvent| {
+            if bridge.state.borrow().channel.is_some() {
+                return; // All window frames are ignored after the one-shot bind.
+            }
+            let data = event.data();
+            if !closed_object(&data, &["type", "protocol", "bundle"]) {
+                return;
+            }
+            let ports = event.ports();
+            let Ok(channel) = ports.get(0).dyn_into::<web_sys::MessagePort>() else { return };
+            let protocol = js_sys::Reflect::get(&data, &"protocol".into()).ok().and_then(|v| v.as_f64());
+            let parent = event.source().is_some_and(|source| js_sys::Object::is(&source, &bridge.parent));
+            let accepted = bridge.state.borrow_mut().handshake.accept(
+                parent,
+                &event.origin(),
+                string(&data, "type").as_deref(),
+                protocol,
+                string(&data, "bundle").as_deref(),
+                ports.length() as usize,
+            );
+            if !accepted {
+                return;
+            }
+            let receiver = bridge.clone();
+            let ctx = ctx.clone();
+            let on_message = Closure::<dyn FnMut(web_sys::MessageEvent)>::new(move |event: web_sys::MessageEvent| {
+                receiver.receive(&event.data());
+                ctx.request_repaint();
+            });
+            channel.set_onmessage(Some(on_message.as_ref().unchecked_ref()));
+            channel.start();
+            bridge.state.borrow_mut().channel = Some(channel);
+            on_message.forget(); // Exactly one private listener lives until the frame closes.
+            let ready = bridge.state.borrow().session.ready();
+            bridge.post(&ready);
+        });
+        if self.window.add_event_listener_with_callback("message", on_connect.as_ref().unchecked_ref()).is_ok() {
+            on_connect.forget();
+        }
+    }
+
+    fn receive(&self, data: &JsValue) {
+        let parsed = fields(data).ok_or_else(|| "A message is a plain object.".to_string()).and_then(|f| port_protocol::parse(&f));
+        let message = match parsed {
+            Ok(message) => message,
+            Err(error) => {
+                self.post_failed("native_port_protocol", &error);
+                if let Some(channel) = self.state.borrow_mut().channel.take() {
+                    channel.set_onmessage(None);
+                    channel.close();
+                }
+                return;
+            }
+        };
+        let out = self.state.borrow_mut().session.receive(message, || copy_bytes(data));
+        self.post_all(&out);
+    }
+
+    fn post_all(&self, out: &[Out]) {
+        for message in out {
+            self.post(message);
+        }
+    }
+
+    fn post(&self, out: &Out) {
+        let state = self.state.borrow();
+        let Some(channel) = state.channel.as_ref() else { return };
+        let transfer = js_sys::Array::new();
+        let message = js_sys::Object::new();
+        let set = |key: &str, value: JsValue| js_sys::Reflect::set(&message, &JsValue::from_str(key), &value).is_ok();
+        let mut ok = set("type", JsValue::from_str(&format!("gridcraft:{}", out.kind)));
+        for (key, value) in &out.fields {
+            let value = match value {
+                Value::Str(v) => JsValue::from_str(v),
+                Value::Bool(v) => JsValue::from_bool(*v),
+                Value::Num(v) => JsValue::from_f64(*v),
+                Value::Bytes(v) => {
+                    let buffer = js_sys::Uint8Array::from(v.as_slice()).buffer();
+                    transfer.push(&buffer);
+                    buffer.into()
+                }
+                Value::Warnings(list) => {
+                    let array = js_sys::Array::new();
+                    for (code, count) in list {
+                        if let Some(item) = object(&[("code", (*code).into()), ("count", (*count as f64).into())]) {
+                            array.push(&item);
+                        }
+                    }
+                    array.into()
+                }
+                Value::Addresses(list) => {
+                    let array = js_sys::Array::new();
+                    for at in list {
+                        array.push(&at.as_str().into());
+                    }
+                    array.into()
+                }
+                Value::Conflicts(list) => {
+                    let array = js_sys::Array::new();
+                    for c in list {
+                        let fields = [("sheet", c.sheet.as_str().into()), ("cell", c.cell.as_str().into()), ("agent", c.agent.as_str().into()), ("kept", c.kept.as_str().into())];
+                        if let Some(item) = object(&fields) {
+                            array.push(&item);
+                        }
+                    }
+                    array.into()
+                }
+            };
+            ok &= set(key, value);
+        }
+        if !ok || channel.post_message_with_transferable(&message, &transfer).is_err() {
+            log::error!("couldn't send gridcraft:{} to the host", out.kind);
+        }
+    }
+}
+
+/// A plain object (no inherited fields, arrays or extra prototypes) whose own keys, when
+/// `keys` is not empty, are exactly those.
+fn closed_object(value: &JsValue, keys: &[&str]) -> bool {
+    if !value.is_object() || value.is_null() || js_sys::Array::is_array(value) {
+        return false;
+    }
+    if !js_sys::Object::is(&js_sys::Object::get_prototype_of(value), &js_sys::Object::get_prototype_of(&js_sys::Object::new())) {
+        return false;
+    }
+    let own = js_sys::Object::keys(value.unchecked_ref::<js_sys::Object>());
+    keys.is_empty() || own.length() as usize == keys.len() && own.iter().all(|key| key.as_string().is_some_and(|key| keys.contains(&key.as_str())))
+}
+
+/// A host message's own fields, for `port_protocol::parse`.
+fn fields(data: &JsValue) -> Option<Vec<(String, Field)>> {
+    if !closed_object(data, &[]) {
+        return None;
+    }
+    let keys = js_sys::Object::keys(data.unchecked_ref::<js_sys::Object>());
+    let mut out = Vec::with_capacity(keys.length() as usize);
+    for key in keys.iter() {
+        let key = key.as_string()?;
+        let value = js_sys::Reflect::get(data, &JsValue::from_str(&key)).ok()?;
+        let field = if let Some(v) = value.as_string() {
+            Field::Str(v)
+        } else if let Some(v) = value.as_bool() {
+            Field::Bool(v)
+        } else if let Some(v) = value.as_f64() {
+            Field::Num(v)
+        } else if let Some(array) = value.dyn_ref::<js_sys::Uint8Array>() {
+            Field::Bytes(array.length() as usize)
+        } else if let Some(buffer) = value.dyn_ref::<js_sys::ArrayBuffer>() {
+            Field::Bytes(buffer.byte_length() as usize)
+        } else {
+            Field::Other
+        };
+        out.push((key, field));
+    }
+    Some(out)
+}
+
+/// The open's workbook, copied out of JavaScript only after its size was allowed.
+fn copy_bytes(data: &JsValue) -> Vec<u8> {
+    let Ok(value) = js_sys::Reflect::get(data, &JsValue::from_str("bytes")) else { return Vec::new() };
+    if let Some(array) = value.dyn_ref::<js_sys::Uint8Array>() {
+        array.to_vec()
+    } else if value.is_instance_of::<js_sys::ArrayBuffer>() {
+        js_sys::Uint8Array::new(&value).to_vec()
+    } else {
+        Vec::new()
+    }
+}
+
+fn object(fields: &[(&str, JsValue)]) -> Option<js_sys::Object> {
+    let m = js_sys::Object::new();
+    for (key, value) in fields {
+        js_sys::Reflect::set(&m, &JsValue::from_str(key), value).ok()?;
+    }
+    Some(m)
+}
+
+fn string(data: &JsValue, key: &str) -> Option<String> {
+    js_sys::Reflect::get(data, &JsValue::from_str(key)).ok()?.as_string()
+}
diff --git a/apps/gridcraft-web/src/port_protocol.rs b/apps/gridcraft-web/src/port_protocol.rs
new file mode 100644
index 00000000..1aa6a001
--- /dev/null
+++ b/apps/gridcraft-web/src/port_protocol.rs
@@ -0,0 +1,462 @@
+//! Mooring protocol 2 on the private port: the exact shape of every message a host sends,
+//! checked before anything acts on it, and the editor's ledger of saves awaiting the host.
+//!
+//! A message is a plain object with an exact set of keys. An unknown type or key, a missing
+//! key or a value of the wrong type is a protocol error: the editor closes the port. Workbook
+//! bytes are only measured here; they are copied out of JavaScript once their size is allowed.
+
+use std::collections::VecDeque;
+
+pub const PROTOCOL: f64 = 2.0;
+
+/// Saves sent to the host and not yet acknowledged or refused.
+pub const MAX_PENDING_SAVES: usize = 4;
+
+/// The largest workbook the editor takes from its host, refused before it is copied (the same
+/// limit as upstream's host open). Hosts and servers keep their own, smaller upload limits.
+pub const MAX_OPEN_BYTES: usize = 512 << 20;
+
+/// The longest log-only error text in a message.
+pub const MAX_ERROR_CHARS: usize = 512;
+
+/// A field of an incoming message, as read from JavaScript.
+#[derive(Clone, Debug, PartialEq)]
+pub enum Field {
+    Str(String),
+    Bool(bool),
+    Num(f64),
+    /// An `ArrayBuffer` or `Uint8Array` of this many bytes.
+    Bytes(usize),
+    /// Anything else (null, an array, an object, undefined).
+    Other,
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub enum Inbound {
+    Open { request_id: String, name: String, bytes: usize, calculate: bool, auto_fit: bool },
+    SetAccess { request_id: String, read_only: bool },
+    SaveRequest { request_id: String },
+    SaveAck { request_id: String, document: String, revision: String, version: String },
+    SaveFailed { request_id: String, code: String },
+    /// `keep: "human"` with its `label` gives `keep_human: Some(label)`: the commands are replayed
+    /// over the person's edits since the saved version, the person's cells kept.
+    Execute { request_id: String, commands: String, saved: bool, base_revision: Option<String>, keep_human: Option<String> },
+}
+
+#[derive(Clone, Copy, PartialEq)]
+enum Kind {
+    Str,
+    Bool,
+    Bytes,
+    /// A string or a finite number (a host's version id).
+    Version,
+}
+
+/// The keys of each message type besides `type`: (key, kind, required).
+fn shape(kind: &str) -> Option<&'static [(&'static str, Kind, bool)]> {
+    use Kind::*;
+    Some(match kind {
+        "gridcraft:open" => &[("requestId", Str, true), ("name", Str, true), ("bytes", Bytes, true), ("calculate", Bool, true), ("autoFit", Bool, true)],
+        "gridcraft:set-access" => &[("requestId", Str, true), ("readOnly", Bool, true)],
+        "gridcraft:save-request" => &[("requestId", Str, true)],
+        "gridcraft:save-ack" => &[("requestId", Str, true), ("document", Str, true), ("revision", Str, true), ("version", Version, true)],
+        "gridcraft:save-failed" => &[("requestId", Str, true), ("code", Str, true), ("error", Str, true)],
+        "gridcraft:execute" => &[
+            ("requestId", Str, true),
+            ("commands", Str, true),
+            ("saved", Bool, true),
+            ("baseRevision", Str, false),
+            ("keep", Str, false),
+            ("label", Str, false),
+        ],
+        _ => return None,
+    })
+}
+
+/// Reads one host message. `Err` carries a log-only reason; the port closes on it.
+pub fn parse(fields: &[(String, Field)]) -> Result<Inbound, String> {
+    let get = |key: &str| fields.iter().find(|(k, _)| k == key).map(|(_, v)| v);
+    let Some(Field::Str(kind)) = get("type") else { return Err("A message needs a string type.".into()) };
+    let shape = shape(kind).ok_or_else(|| format!("Unknown message type {}.", clip(kind, 64)))?;
+    for (key, _) in fields {
+        if key != "type" && !shape.iter().any(|(k, ..)| k == key) {
+            return Err(format!("Unknown key {} in {kind}.", clip(key, 64)));
+        }
+    }
+    if fields.iter().enumerate().any(|(i, (key, _))| fields[..i].iter().any(|(k, _)| k == key)) {
+        return Err(format!("Repeated keys in {kind}."));
+    }
+    for (key, want, required) in shape {
+        let ok = match (get(key), want) {
+            (None, _) => !required,
+            (Some(Field::Str(_)), Kind::Str) | (Some(Field::Bool(_)), Kind::Bool) | (Some(Field::Bytes(_)), Kind::Bytes) => true,
+            (Some(Field::Str(_)), Kind::Version) => true,
+            (Some(Field::Num(n)), Kind::Version) => n.is_finite(),
+            _ => false,
+        };
+        if !ok {
+            return Err(format!("{kind}: {key} is missing or of the wrong type."));
+        }
+    }
+    let s = |key: &str| match get(key) {
+        Some(Field::Str(v)) => v.clone(),
+        Some(Field::Num(n)) => format!("{n}"),
+        _ => String::new(),
+    };
+    let b = |key: &str| matches!(get(key), Some(Field::Bool(true)));
+    let request_id = s("requestId");
+    if !is_request_id(&request_id) {
+        return Err(format!("{kind}: requestId must match [A-Za-z0-9_-]{{1,64}}."));
+    }
+    Ok(match kind.as_str() {
+        "gridcraft:open" => {
+            let name = s("name");
+            if name.trim().is_empty() || name.chars().count() > 255 || name.contains(['/', '\\']) {
+                return Err("open: name must be a file name of at most 255 characters.".into());
+            }
+            let bytes = match get("bytes") {
+                Some(Field::Bytes(n)) => *n,
+                _ => 0,
+            };
+            Inbound::Open { request_id, name, bytes, calculate: b("calculate"), auto_fit: b("autoFit") }
+        }
+        "gridcraft:set-access" => Inbound::SetAccess { request_id, read_only: b("readOnly") },
+        "gridcraft:save-request" => Inbound::SaveRequest { request_id },
+        "gridcraft:save-ack" => {
+            let (document, revision, version) = (s("document"), s("revision"), s("version"));
+            if !is_decimal(&document) || !is_decimal(&revision) || version.is_empty() || version.len() > 128 {
+                return Err("save-ack: document and revision are decimal ids and version is at most 128 bytes.".into());
+            }
+            Inbound::SaveAck { request_id, document, revision, version }
+        }
+        "gridcraft:save-failed" => {
+            let code = s("code");
+            if !is_code(&code) || s("error").chars().count() > MAX_ERROR_CHARS {
+                return Err("save-failed: code must match [a-z][a-z0-9_]{0,63} and error be at most 512 characters.".into());
+            }
+            Inbound::SaveFailed { request_id, code }
+        }
+        _ => {
+            let base_revision = get("baseRevision").map(|_| s("baseRevision"));
+            let keep_human = match (get("keep").map(|_| s("keep")), get("label").map(|_| s("label"))) {
+                (None, None) => None,
+                (Some(keep), Some(label)) if keep == "human" && is_label(&label) => Some(label),
+                _ => return Err("execute: keep is \"human\" and comes with a label of 1 to 80 characters.".into()),
+            };
+            // A replay over the person's work is only ever built on a saved version the host
+            // was told of (`savedRevision`, which may be `saved-<n>`); without one it is refused.
+            match (&keep_human, base_revision.as_deref()) {
+                (Some(_), None) => return Err("execute: keep \"human\" needs the baseRevision of the saved version (savedRevision).".into()),
+                (Some(_), Some(base)) if !is_decimal(base) && !base.strip_prefix("saved-").is_some_and(is_decimal) => {
+                    return Err("execute: baseRevision is a revision or a savedRevision.".into());
+                }
+                (None, Some(base)) if !is_decimal(base) => return Err("execute: baseRevision is a decimal revision.".into()),
+                _ => {}
+            }
+            Inbound::Execute { request_id, commands: s("commands"), saved: b("saved"), base_revision, keep_human }
+        }
+    })
+}
+
+/// An undo step's name from the host: 1 to 80 characters, no control characters.
+fn is_label(label: &str) -> bool {
+    let n = label.chars().count();
+    (1..=80).contains(&n) && !label.chars().any(char::is_control) && !label.trim().is_empty()
+}
+
+pub fn is_request_id(id: &str) -> bool {
+    (1..=64).contains(&id.len()) && id.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'_' || b == b'-')
+}
+
+fn is_decimal(value: &str) -> bool {
+    (1..=20).contains(&value.len()) && value.bytes().all(|b| b.is_ascii_digit()) && value.parse::<u64>().is_ok()
+}
+
+fn is_code(code: &str) -> bool {
+    let mut bytes = code.bytes();
+    code.len() <= 64 && bytes.next().is_some_and(|b| b.is_ascii_lowercase()) && bytes.all(|b| b.is_ascii_lowercase() || b.is_ascii_digit() || b == b'_')
+}
+
+/// A log-only error text, cut to the protocol's limit.
+pub fn clip(text: &str, chars: usize) -> String {
+    text.chars().take(chars).collect()
+}
+
+/// The package a hosted workbook is saved as, from its file name: `xlsx`, or `xlsm`, which
+/// carries the VBA project. Any other name is `open_unsupported`.
+pub fn workbook_format(name: &str) -> Option<&'static str> {
+    let (_, ext) = name.rsplit_once('.')?;
+    if ext.eq_ignore_ascii_case("xlsx") {
+        Some("xlsx")
+    } else if ext.eq_ignore_ascii_case("xlsm") {
+        Some("xlsm")
+    } else {
+        None
+    }
+}
+
+/// The code for an engine refusal of an open. The text itself goes to the log only.
+pub fn open_error_code(error: &str) -> &'static str {
+    if error.contains(gridcraft_engine::io::PASSWORD_REQUIRED) || error.to_ascii_lowercase().contains("password") {
+        "open_password"
+    } else if error.contains("unknown file format") || error.contains("supported for") {
+        "open_unsupported"
+    } else if error.contains("Save or discard unsaved work") {
+        "open_failed"
+    } else {
+        "open_corrupt"
+    }
+}
+
+/// Whether `bytes` can be a workbook package: a ZIP (xlsx, xlsm), or the compound file an
+/// encrypted workbook is (its password is asked for by the engine). Anything else under a
+/// workbook name is refused instead of being read as text.
+pub fn is_workbook_package(bytes: &[u8]) -> bool {
+    bytes.starts_with(b"PK\x03\x04") || bytes.starts_with(&[0xD0, 0xCF, 0x11, 0xE0, 0xA1, 0xB1, 0x1A, 0xE1])
+}
+
+/// The content-free code for an engine import warning, or `None` for one an `opened` reports
+/// otherwise (a kept VBA project is `vba_preserved`; a decrypted workbook is the host's own).
+pub fn warning_code(warning: &str) -> Option<&'static str> {
+    if warning.contains("macros (VBA project) were kept") || warning == gridcraft_engine::io::DECRYPTED_NOTICE {
+        None
+    } else if warning.contains("macros (VBA project)") {
+        Some("vba_dropped")
+    } else {
+        Some("import_notice")
+    }
+}
+
+/// The code for a refused host execute (`native_execute`'s texts).
+pub fn execute_error_code(error: &str) -> &'static str {
+    if error.contains("being edited") || error.contains("read-only") {
+        "busy"
+    } else if error.contains("too large") || error.contains("1 to 64") || error.contains("cannot be replayed") || error.contains("must be an object") {
+        "invalid"
+    } else {
+        "failed"
+    }
+}
+
+struct PendingSave<W> {
+    request_id: String,
+    document: String,
+    revision: String,
+    workbook: W,
+}
+
+/// Saves the editor sent and the host has not answered. Only an acknowledgement naming the
+/// exact request, document and revision hands back the workbook that became that version.
+pub struct Saves<W> {
+    pending: VecDeque<PendingSave<W>>,
+}
+
+impl<W> Default for Saves<W> {
+    fn default() -> Self {
+        Self { pending: VecDeque::new() }
+    }
+}
+
+impl<W> Saves<W> {
+    pub fn len(&self) -> usize {
+        self.pending.len()
+    }
+
+    /// Records a save about to be sent; `Err` is the code to answer with instead.
+    pub fn begin(&mut self, request_id: &str, document: &str, revision: &str, workbook: W) -> Result<(), &'static str> {
+        if self.pending.len() >= MAX_PENDING_SAVES {
+            return Err("busy");
+        }
+        if self.pending.iter().any(|p| p.request_id == request_id) {
+            return Err("invalid");
+        }
+        self.pending.push_back(PendingSave { request_id: request_id.into(), document: document.into(), revision: revision.into(), workbook });
+        Ok(())
+    }
+
+    /// The workbook the host stored, when the acknowledgement matches a pending save.
+    pub fn acknowledge(&mut self, request_id: &str, document: &str, revision: &str) -> Option<W> {
+        let i = self.pending.iter().position(|p| p.request_id == request_id && p.document == document && p.revision == revision)?;
+        self.pending.remove(i).map(|p| p.workbook)
+    }
+
+    /// Forgets a save the host refused; the document stays dirty.
+    pub fn failed(&mut self, request_id: &str) -> bool {
+        let before = self.pending.len();
+        self.pending.retain(|p| p.request_id != request_id);
+        self.pending.len() != before
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn msg(fields: &[(&str, Field)]) -> Vec<(String, Field)> {
+        fields.iter().map(|(k, v)| (k.to_string(), v.clone())).collect()
+    }
+
+    fn s(v: &str) -> Field {
+        Field::Str(v.into())
+    }
+
+    fn open() -> Vec<(String, Field)> {
+        msg(&[
+            ("type", s("gridcraft:open")),
+            ("requestId", s("open-1")),
+            ("name", s("Plan.xlsm")),
+            ("bytes", Field::Bytes(10)),
+            ("calculate", Field::Bool(false)),
+            ("autoFit", Field::Bool(false)),
+        ])
+    }
+
+    #[test]
+    fn open_reads_exactly_its_keys() {
+        assert_eq!(
+            parse(&open()),
+            Ok(Inbound::Open { request_id: "open-1".into(), name: "Plan.xlsm".into(), bytes: 10, calculate: false, auto_fit: false })
+        );
+        let mut extra = open();
+        extra.push(("native".into(), Field::Bool(true)));
+        assert!(parse(&extra).is_err(), "an unknown key closes the port");
+        let mut missing = open();
+        missing.retain(|(k, _)| k != "calculate");
+        assert!(parse(&missing).is_err(), "the host chooses calculate");
+        for value in [s("not bytes"), Field::Other, Field::Num(3.0)] {
+            let mut wrong = open();
+            wrong[3].1 = value;
+            assert!(parse(&wrong).is_err());
+        }
+        let mut repeated = open();
+        repeated.push(("name".into(), s("Other.xlsx")));
+        assert!(parse(&repeated).is_err());
+        for name in ["", "  ", "a/b.xlsx", "a\\b.xlsx"] {
+            let mut bad = open();
+            bad[2].1 = s(name);
+            assert!(parse(&bad).is_err(), "{name:?}");
+        }
+    }
+
+    #[test]
+    fn protocol_one_and_unknown_types_are_refused() {
+        for kind in ["gridcraft:export-native", "gridcraft:validate-native", "gridcraft:connect", "gridcraft:opened", "other"] {
+            assert!(parse(&msg(&[("type", s(kind)), ("requestId", s("x"))])).is_err(), "{kind}");
+        }
+        assert!(parse(&msg(&[("requestId", s("x"))])).is_err(), "no type");
+        assert!(parse(&msg(&[("type", Field::Num(1.0))])).is_err());
+    }
+
+    #[test]
+    fn request_ids_codes_and_revisions_are_checked() {
+        for id in ["", "has space", "ü", &"x".repeat(65)] {
+            assert!(parse(&msg(&[("type", s("gridcraft:save-request")), ("requestId", s(id))])).is_err(), "{id:?}");
+        }
+        assert_eq!(parse(&msg(&[("type", s("gridcraft:save-request")), ("requestId", s("A_z-9"))])), Ok(Inbound::SaveRequest { request_id: "A_z-9".into() }));
+        let ack = |document: &str, revision: &str, version: Field| {
+            parse(&msg(&[("type", s("gridcraft:save-ack")), ("requestId", s("r")), ("document", s(document)), ("revision", s(revision)), ("version", version)]))
+        };
+        assert!(ack("7", "12", Field::Num(3.0)).is_ok());
+        assert!(ack("7", "12", s("v-3")).is_ok());
+        assert!(ack("7", "-1", s("v")).is_err());
+        assert!(ack("doc", "1", s("v")).is_err());
+        assert!(ack("7", "1", Field::Num(f64::NAN)).is_err());
+        assert!(ack("7", "1", Field::Bool(true)).is_err());
+        let failed = |code: &str, error: &str| {
+            parse(&msg(&[("type", s("gridcraft:save-failed")), ("requestId", s("r")), ("code", s(code)), ("error", s(error))]))
+        };
+        assert_eq!(failed("conflict", "older revision"), Ok(Inbound::SaveFailed { request_id: "r".into(), code: "conflict".into() }));
+        assert!(failed("Conflict", "").is_err());
+        assert!(failed("conflict", &"x".repeat(513)).is_err());
+    }
+
+    #[test]
+    fn execute_base_revision_is_optional_and_decimal() {
+        let execute = |base: Option<&str>| {
+            let mut m = msg(&[("type", s("gridcraft:execute")), ("requestId", s("e")), ("commands", s("[]")), ("saved", Field::Bool(true))]);
+            if let Some(base) = base {
+                m.push(("baseRevision".into(), s(base)));
+            }
+            parse(&m)
+        };
+        assert_eq!(execute(None), Ok(Inbound::Execute { request_id: "e".into(), commands: "[]".into(), saved: true, base_revision: None, keep_human: None }));
+        assert!(matches!(execute(Some("4")), Ok(Inbound::Execute { base_revision: Some(b), .. }) if b == "4"));
+        assert!(execute(Some("four")).is_err());
+    }
+
+    #[test]
+    fn execute_keep_is_human_with_a_label() {
+        let execute = |extra: &[(&str, Field)]| {
+            let mut m = msg(&[("type", s("gridcraft:execute")), ("requestId", s("e")), ("commands", s("[]")), ("saved", Field::Bool(false))]);
+            m.extend(extra.iter().map(|(k, v)| (k.to_string(), v.clone())));
+            parse(&m)
+        };
+        assert!(matches!(execute(&[("keep", s("human")), ("label", s("Morgan: clear IDs")), ("baseRevision", s("4"))]), Ok(Inbound::Execute { keep_human: Some(l), .. }) if l == "Morgan: clear IDs"));
+        assert!(matches!(execute(&[("keep", s("human")), ("label", s("x")), ("baseRevision", s("saved-12"))]), Ok(Inbound::Execute { base_revision: Some(b), .. }) if b == "saved-12"));
+        for bad in [
+            vec![("keep", s("human")), ("label", s("Morgan: clear IDs"))],
+            vec![("keep", s("human")), ("label", s("x")), ("baseRevision", s("saved-"))],
+            vec![("keep", s("human")), ("label", s("x")), ("baseRevision", s("saved-1x"))],
+            vec![("keep", s("human")), ("label", s("x")), ("baseRevision", s("latest"))],
+            vec![("baseRevision", s("saved-1"))],
+            vec![("keep", s("human"))],
+            vec![("label", s("x"))],
+            vec![("keep", s("agent")), ("label", s("x"))],
+            vec![("keep", s("human")), ("label", s(""))],
+            vec![("keep", s("human")), ("label", s(" "))],
+            vec![("keep", s("human")), ("label", s(&"x".repeat(81)))],
+            vec![("keep", s("human")), ("label", s("a\nb"))],
+            vec![("keep", Field::Bool(true)), ("label", s("x"))],
+        ] {
+            assert!(execute(&bad).is_err(), "{bad:?}");
+        }
+    }
+
+    #[test]
+    fn hosted_workbooks_are_xlsx_or_xlsm() {
+        assert_eq!(workbook_format("a.xlsx"), Some("xlsx"));
+        assert_eq!(workbook_format("A.XLSM"), Some("xlsm"));
+        for name in ["a.xls", "a.json", "a.csv", "xlsx", "a.xlsb"] {
+            assert_eq!(workbook_format(name), None, "{name}");
+        }
+    }
+
+    #[test]
+    fn the_save_ledger_is_bounded_and_acknowledges_only_an_exact_match() {
+        let mut saves = Saves::default();
+        for i in 0..MAX_PENDING_SAVES {
+            saves.begin(&format!("s{i}"), "7", &format!("{i}"), i).unwrap();
+        }
+        assert_eq!(saves.begin("s9", "7", "9", 9), Err("busy"));
+        assert_eq!(saves.acknowledge("s1", "7", "2"), None, "another revision");
+        assert_eq!(saves.acknowledge("s1", "8", "1"), None, "another document");
+        assert_eq!(saves.acknowledge("s1", "7", "1"), Some(1));
+        assert_eq!(saves.acknowledge("s1", "7", "1"), None, "once");
+        assert_eq!(saves.begin("s0", "7", "5", 5), Err("invalid"), "a pending id is not reused");
+        assert!(saves.failed("s2"));
+        assert!(!saves.failed("s2"));
+        assert_eq!(saves.len(), 2);
+    }
+
+    #[test]
+    fn only_zip_or_encrypted_packages_open_and_warnings_become_codes() {
+        assert!(is_workbook_package(b"PK\x03\x04rest"));
+        assert!(is_workbook_package(&[0xD0, 0xCF, 0x11, 0xE0, 0xA1, 0xB1, 0x1A, 0xE1, 0]));
+        assert!(!is_workbook_package(b"a,b\n1,2"));
+        assert!(!is_workbook_package(b""));
+        assert_eq!(warning_code("macros (VBA project) were kept but not executed"), None);
+        assert_eq!(warning_code("macros (VBA project) could not be read and were dropped: x"), Some("vba_dropped"));
+        assert_eq!(warning_code(gridcraft_engine::io::DECRYPTED_NOTICE), None);
+        assert_eq!(warning_code("Sheet 'Plan': 3 charts were simplified"), Some("import_notice"));
+    }
+
+    #[test]
+    fn error_codes_never_carry_the_text() {
+        assert_eq!(open_error_code(gridcraft_engine::io::PASSWORD_REQUIRED), "open_password");
+        assert_eq!(open_error_code("Book.ods: ODS is supported for data import only."), "open_unsupported");
+        assert_eq!(open_error_code("zip: invalid central directory"), "open_corrupt");
+        assert_eq!(execute_error_code("A cell or text box is being edited."), "busy");
+        assert_eq!(execute_error_code("The command file.save cannot be replayed by a host."), "invalid");
+        assert_eq!(execute_error_code("#REF! (2 applied)"), "failed");
+    }
+}
