+/// Whether `name` is an Excel function this engine does not compute.
+pub fn is_held_function(name: &str) -> bool {
+    let n = name.trim().to_ascii_uppercase();
+    EXCEL_FUNCTIONS.binary_search(&n.as_str()).is_ok() && !crate::is_known_function(&n)
+}
+
+/// The held functions `expr` calls, in order of appearance, each once.
+pub fn held_functions(expr: &Expr) -> Vec<String> {
+    let mut out: Vec<String> = Vec::new();
+    expr.walk(&mut |e| {
+        if let Expr::Call(name, _) = e
+            && is_held_function(name)
+            && !out.iter().any(|n| n == name)
+        {
+            out.push(name.clone());
+        }
+    });
+    out
+}
+
+/// The functions a held formula's value stands in for: the held functions it calls and, when
+/// it calls GETPIVOTDATA, that one (held because its report could not be read).
+pub fn held_value_functions(expr: &Expr) -> Vec<String> {
+    let mut out = held_functions(expr);
+    if calls_pivot_data(expr) && !out.iter().any(|n| n.eq_ignore_ascii_case("GETPIVOTDATA")) {
+        out.push("GETPIVOTDATA".into());
+    }
+    out
+}
+
+fn calls_pivot_data(expr: &Expr) -> bool {
+    let mut found = false;
+    expr.walk(&mut |e| found |= matches!(e, Expr::Call(name, _) if name.eq_ignore_ascii_case("GETPIVOTDATA")));
+    found
+}
+
+/// Whether a GETPIVOTDATA call of `expr`, evaluated at `at` on the workbook as its document
+/// brought it, is #REF!: this engine cannot answer it there.
+fn unanswered_pivot_data(wb: &Workbook, sheet: usize, at: CellRef, expr: &Expr) -> bool {
+    let mut calls: Vec<&Expr> = Vec::new();
+    expr.walk(&mut |e| {
+        if matches!(e, Expr::Call(name, _) if name.eq_ignore_ascii_case("GETPIVOTDATA")) {
+            calls.push(e);
+        }
+    });
+    calls.into_iter().any(|call| crate::evaluate_expr(wb, sheet, at, call) == Value::Error(CellError::Ref))
+}
+
+/// Marks every formula of `wb` that has a value and calls a held function, or a GETPIVOTDATA
+/// this engine cannot answer, as keeping the value its document brought. Returns how many it
+/// marked. Call it before the workbook is calculated: GETPIVOTDATA reads the reports as stored.
+pub fn mark_document_values(wb: &mut Workbook) -> usize {
+    let mut marked = 0;
+    for si in 0..wb.sheets.len() {
+        let book: &Workbook = wb;
+        let keys: Vec<_> = book.sheets[si]
+            .cells
+            .iter()
+            // A value this engine wrote for it (#NAME?) is not the document's: only a real one holds.
+            .filter(|(at, c)| {
+                !matches!(c.value, Value::Empty | Value::Error(CellError::Name))
+                    && c.formula.as_ref().is_some_and(|f| {
+                        !f.document_value
+                            && f.expr_arc().is_some_and(|e| {
+                                !held_functions(&e).is_empty() || (calls_pivot_data(&e) && unanswered_pivot_data(book, si, *at, &e))
+                            })
+                    })
+            })
+            .map(|(k, _)| k)
+            .collect();
+        if keys.is_empty() {
+            continue;
+        }
+        let sheet = std::sync::Arc::make_mut(&mut wb.sheets[si]);
+        for k in keys {
+            if let Some(cell) = sheet.cells.get_mut(k)
+                && let Some(f) = cell.formula.as_mut()
+            {
+                std::sync::Arc::make_mut(f).document_value = true;
+                marked += 1;
+            }
+        }
+    }
+    marked
+}
