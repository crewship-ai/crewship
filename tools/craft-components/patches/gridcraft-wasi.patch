+/// The fixture written, with one PivotTable's cache given a field of a source column deleted
+/// since the last refresh and the report summing it, as Excel leaves such a file.
+fn stale_cache_xlsx() -> (Vec<u8>, String) {
+    let bytes = write_xlsx(&workbook()).unwrap();
+    let mut parts = unzip(&bytes);
+    let table = parts.keys().filter(|n| n.starts_with("xl/pivotTables/pivotTable") && n.ends_with(".xml")).min().unwrap().clone();
+    let rels = String::from_utf8(parts[&table.replace("pivotTables/", "pivotTables/_rels/").replace(".xml", ".xml.rels")].clone()).unwrap();
+    let target = rels.split("Target=\"../").nth(1).unwrap().split('"').next().unwrap();
+    let cache = format!("xl/{target}");
+    let def = String::from_utf8(parts[&cache].clone()).unwrap();
+    let fields = def.matches("<cacheField ").count();
+    parts.insert(cache, def.replace("</cacheFields>", "<cacheField name=\"Cost\" numFmtId=\"0\"><sharedItems/></cacheField></cacheFields>").into_bytes());
+    let t = String::from_utf8(parts[&table].clone()).unwrap();
+    // A report format in bold, through the styles part's first differential format.
+    let t = t.replace("</dataFields>", &format!("<dataField name=\"Sum of Cost\" fld=\"{fields}\" baseField=\"0\" baseItem=\"0\"/></dataFields><formats count=\"1\"><format dxfId=\"0\"><pivotArea type=\"all\" dataOnly=\"0\"/></format></formats>"));
+    parts.insert(table, t.into_bytes());
+    let styles = String::from_utf8(parts["xl/styles.xml"].clone()).unwrap();
+    let at = styles.find("<dxfs").unwrap();
+    let end = at + styles[at..].find('>').unwrap() + 1;
+    let (open, rest) = if styles[..end].ends_with("/>") { ("<dxfs count=\"1\">".to_string(), "</dxfs>".to_string() + &styles[end..]) } else { (styles[at..end].to_string(), styles[end..].to_string()) };
+    let styles = format!("{}{open}<dxf><font><b/><i/></font></dxf>{rest}", &styles[..at]);
+    parts.insert("xl/styles.xml".into(), styles.into_bytes());
+    (rezip(&parts), "Cost".into())
+}
