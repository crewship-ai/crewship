@@ -0,0 +1,158 @@
+//! Values a document brings for an Excel function this engine does not compute.
+//!
+//! A formula that calls a function Excel has and this engine does not (GETPIVOTDATA, the CUBE
+//! functions, RTD, …) would otherwise turn into #NAME? the moment the workbook is calculated,
+//! although the file holds the value Excel computed. Such a formula keeps the value its document
+//! brought: [`mark_document_values`] marks it when a document opens, and the calculation passes
+//! a marked formula's value on instead of evaluating it (formulas that read it are calculated
+//! from that value). The mark lives on the formula, so any edit of the formula drops it; a
+//! formula entered in this engine never has it. A name that is not an Excel function (a typo)
+//! is still #NAME?.
+//!
+//! GETPIVOTDATA is calculated where this engine can read the report it names. A document's
+//! formula holds too when one of its GETPIVOTDATA calls cannot be answered here (#REF!: a report
+//! kept as the file wrote it, or a stored report that no longer matches its source), so a check
+//! such as `ROUND(GETPIVOTDATA(…))=SUM(…)` keeps Excel's answer instead of turning into #REF!.
+
+use gridcraft_core::{CellError, CellRef, Value};
+use gridcraft_formula::Expr;
+use gridcraft_model::Workbook;
+
+/// Excel's worksheet functions: the BIFF function table and the later ones Excel writes with
+/// `_xlfn.`. Only those the engine does not implement are held.
+const EXCEL_FUNCTIONS: &[&str] = &[
+    "ABS", "ABSREF", "ACOS", "ACOSH", "ACTIVE.CELL", "ADD.BAR", "ADD.COMMAND", "ADD.MENU",
+    "ADD.TOOLBAR", "ADDRESS", "AND", "APP.TITLE", "AREAS", "ARGUMENT", "ASC", "ASIN", "ASINH",
+    "ATAN", "ATAN2", "ATANH", "AVEDEV", "AVERAGE", "AVERAGEA", "BAHTTEXT", "BETADIST", "BETAINV",
+    "BINOMDIST", "BREAK", "CALL", "CALLER", "CANCEL.KEY", "CEILING", "CELL", "CHAR",
+    "CHECK.COMMAND", "CHIDIST", "CHIINV", "CHITEST", "CHOOSE", "CLEAN", "CODE", "COLUMN",
+    "COLUMNS", "COMBIN", "CONCATENATE", "CONFIDENCE", "COPILOT", "CORREL", "COS", "COSH", "COUNT",
+    "COUNTA", "COUNTBLANK", "COUNTIF", "COVAR", "CREATE.OBJECT", "CRITBINOM", "CUBEKPIMEMBER",
+    "CUBEMEMBER", "CUBEMEMBERPROPERTY", "CUBERANKEDMEMBER", "CUBESET", "CUBESETCOUNT",
+    "CUBEVALUE", "CUSTOM.REPEAT", "CUSTOM.UNDO", "DATE", "DATEDIF", "DATESTRING", "DATEVALUE",
+    "DAVERAGE", "DAY", "DAYS360", "DB", "DBCS", "DCOUNT", "DCOUNTA", "DDB", "DEGREES",
+    "DELETE.BAR", "DELETE.COMMAND", "DELETE.MENU", "DELETE.TOOLBAR", "DEREF", "DETECTLANGUAGE",
+    "DEVSQ", "DGET", "DIALOG.BOX", "DIRECTORY", "DMAX", "DMIN", "DOCUMENTS", "DOLLAR", "DPRODUCT",
