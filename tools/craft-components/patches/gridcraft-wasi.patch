+/// `gridcraft-cli <version>`, and for a pinned build (the package build passes the pinned source
+/// commit and the SHA-256 of the patch over it) `gridcraft-cli <version>+<commit:12> patch <sha256>`:
+/// the same version string as the package catalog, so a host can tell which build it runs.
+fn version_line(commit: Option<&str>, patch: Option<&str>) -> String {
+    let hex = |s: &str, n: usize| s.len() == n && s.bytes().all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b));
+    let version = env!("CARGO_PKG_VERSION");
+    match (commit, patch) {
+        (Some(c), Some(p)) if hex(c, 40) && hex(p, 64) => format!("gridcraft-cli {version}+{} patch {p}", &c[..12]),
+        _ => format!("gridcraft-cli {version}"),
+    }
+}
