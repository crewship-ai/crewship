+/// `range.columnByHeader` finds every column a header heads, below a header row that is not the
+/// first, and clearing those ranges recalculates the summaries above them.
+#[test]
+fn column_by_header_finds_each_column_under_its_header_and_a_clear_recalculates_its_summary() {
+    let mut s = s();
+    s.execute("cell.set", json!({"cell": "B5", "input": "=COUNTA(B8:B20)"})).unwrap();
+    s.execute("cell.set", json!({"cell": "E5", "input": "=COUNTA(E8:E20)"})).unwrap();
+    s.execute("cell.set", json!({"cell": "B7", "input": "Item ID"})).unwrap();
+    s.execute("cell.set", json!({"cell": "C7", "input": "Amount"})).unwrap();
+    s.execute("cell.set", json!({"cell": "E7", "input": " item   id "})).unwrap();
+    for r in 8..=12 {
+        s.execute("cell.set", json!({"cell": format!("B{r}"), "input": format!("I-{r}")})).unwrap();
+        s.execute("cell.set", json!({"cell": format!("C{r}"), "input": format!("{}", r * 10)})).unwrap();
+        s.execute("cell.set", json!({"cell": format!("E{r}"), "input": format!("X{r}")})).unwrap();
+    }
+    s.execute("cell.set", json!({"cell": "F20", "input": "end"})).unwrap();
+    assert_eq!(v(&s, "B5"), Value::number(5.0));
+
+    let found = s.execute("range.columnByHeader", json!({"header": "item id"})).unwrap();
+    let ranges: Vec<&str> = found["columns"].as_array().unwrap().iter().map(|c| c["range"].as_str().unwrap()).collect();
+    assert_eq!(ranges, vec!["Sheet1!B8:B20", "Sheet1!E8:E20"], "{found}");
+    assert_eq!(found["columns"][0]["headerCell"], json!("B7"));
+    assert_eq!(found["columns"][1]["sheet"], json!("Sheet1"));
+    let exact = s.execute("range.columnByHeader", json!({"header": "Item ID", "matchCase": true})).unwrap();
+    assert_eq!(exact["columns"].as_array().unwrap().len(), 1, "{exact}");
+    assert_eq!(s.execute("range.columnByHeader", json!({"header": "Missing"})).unwrap(), json!({"columns": []}));
+    assert!(s.execute("range.columnByHeader", json!({"header": "  "})).is_err());
+
+    for r in ranges.iter().map(|r| r.to_string()).collect::<Vec<_>>() {
+        s.execute("edit.clearContents", json!({"range": r})).unwrap();
+    }
+    assert_eq!(v(&s, "B5"), Value::number(0.0), "the summary above follows the cleared column");
+    assert_eq!(v(&s, "E5"), Value::number(0.0));
+    assert_eq!(v(&s, "B7"), Value::text("Item ID"), "headers stay");
+    assert_eq!(v(&s, "C8"), Value::number(80.0), "other columns stay");
+
+    // A merged header heads every column it spans; a header on the last used row heads nothing.
+    s.execute("cell.set", json!({"cell": "H7", "input": "Pair"})).unwrap();
+    s.execute("home.mergeCells", json!({"range": "H7:I7"})).unwrap();
+    s.execute("cell.set", json!({"cell": "K20", "input": "Tail"})).unwrap();
+    let pair = s.execute("range.columnByHeader", json!({"header": "pair", "sheet": "Sheet1"})).unwrap();
+    assert_eq!(pair["columns"][0]["range"], json!("Sheet1!H8:I20"), "{pair}");
+    let tail = s.execute("range.columnByHeader", json!({"header": "tail"})).unwrap();
+    assert_eq!(tail["columns"][0]["range"], serde_json::Value::Null, "{tail}");
+}
