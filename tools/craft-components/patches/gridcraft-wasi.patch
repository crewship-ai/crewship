+/// An xlsx whose PivotTable sums a cache field of a source column deleted since the cache's
+/// last refresh: a field the writer cannot rebuild. With `stale` false, the same pivot without it.
+fn pivot_xlsx(stale: bool) -> Vec<u8> {
+    use gridcraft_engine::model::{PivotField, PivotFunc, PivotTable, PivotValue};
+    use std::io::Read;
+    let mut s = gridcraft_engine::Session::new();
+    s.new_workbook();
+    for (cell, input) in [("A1", "Region"), ("B1", "Sales"), ("A2", "East"), ("B2", "3"), ("A3", "West"), ("B3", "5")] {
+        s.execute("cell.set", serde_json::json!({"cell": cell, "input": input})).unwrap();
+    }
+    let mut wb = (*s.active().unwrap().wb).clone();
+    std::sync::Arc::make_mut(&mut wb.sheets[0]).pivots.push(PivotTable {
+        source: "Sheet1!$A$1:$B$3".into(),
+        anchor: gridcraft_engine::core::CellRef::parse("D3").unwrap(),
+        rows: vec![PivotField { source_col: "Region".into(), ..PivotField::default() }],
+        values: vec![PivotValue { source_col: "Sales".into(), func: PivotFunc::Sum, name: "Sum of Sales".into(), ..PivotValue::default() }],
+        ..PivotTable::default()
+    });
+    let bytes = gridcraft_engine::io::save_bytes(&wb, "Plan.xlsx").unwrap();
+    if !stale {
+        return bytes;
+    }
+    let mut zip = zip::ZipArchive::new(std::io::Cursor::new(bytes)).unwrap();
+    let mut w = zip::ZipWriter::new(std::io::Cursor::new(Vec::new()));
+    for i in 0..zip.len() {
+        let mut f = zip.by_index(i).unwrap();
+        let name = f.name().unwrap().to_string();
+        let mut raw = String::new();
+        f.read_to_string(&mut raw).unwrap();
+        if name.starts_with("xl/pivotCache/pivotCacheDefinition") {
+            raw = raw.replace("</cacheFields>", "<cacheField name=\"Cost\" numFmtId=\"0\"><sharedItems/></cacheField></cacheFields>");
+        }
+        if name.starts_with("xl/pivotTables/pivotTable") {
+            raw = raw.replace("</dataFields>", "<dataField name=\"Sum of Cost\" fld=\"2\" baseField=\"0\" baseItem=\"0\"/></dataFields>");
+        }
+        w.start_file(name.as_str(), zip::write::SimpleFileOptions::default()).unwrap();
+        w.write_all(raw.as_bytes()).unwrap();
+    }
+    w.finish().unwrap().into_inner()
+}
+
+fn parts_line(o: &Output) -> serde_json::Value {
+    let text = String::from_utf8_lossy(&o.stdout);
+    let line = text.lines().rev().find(|l| l.starts_with("{\"parts\"")).unwrap_or_else(|| panic!("no parts line in {text:?}"));
+    serde_json::from_str(line).unwrap()
+}
+
+#[test]
+fn convert_with_fidelity_refuses_a_lossy_file_and_writes_a_clean_one() {
+    let d = tmpdir("fidelity-convert");
+    let (stale, clean) = (d.join("stale.xlsx"), d.join("clean.xlsx"));
+    std::fs::write(&stale, pivot_xlsx(true)).unwrap();
+    std::fs::write(&clean, pivot_xlsx(false)).unwrap();
+    let out = d.join("out.xlsx");
+    // The unchanged PivotTable keeps its original parts, stale field and all.
+    let o = run(&["convert", stale.to_str().unwrap(), out.to_str().unwrap(), "--fidelity", "--saved-values"]);
+    assert!(o.status.success(), "{}", String::from_utf8_lossy(&o.stderr));
+    assert_eq!(parts_line(&o), serde_json::json!({"parts": []}));
+    std::fs::remove_file(&out).unwrap();
+
+    let o = run(&["convert", clean.to_str().unwrap(), out.to_str().unwrap(), "--fidelity"]);
+    assert!(o.status.success(), "{}", String::from_utf8_lossy(&o.stderr));
+    assert_eq!(parts_line(&o), serde_json::json!({"parts": []}));
+    assert!(out.exists());
+
+    // A native workbook has no original parts: it is checked against what its xlsx reads back
+    // as, and the stale field cannot be rebuilt. Nothing is written.
+    let native = d.join("stale.json");
+    ok(&["convert", stale.to_str().unwrap(), native.to_str().unwrap()]);
+    let from_native = d.join("from-native.xlsx");
+    let o = run(&["convert", native.to_str().unwrap(), from_native.to_str().unwrap(), "--fidelity"]);
+    assert_eq!(o.status.code(), Some(3));
+    assert_eq!(parts_line(&o)["parts"][0]["code"], "pivot_fields");
+    assert!(!from_native.exists(), "a lossy file is never written");
+    // Only package outputs can be checked.
+    let o = run(&["convert", clean.to_str().unwrap(), d.join("x.csv").to_str().unwrap(), "--fidelity"]);
+    assert_eq!(o.status.code(), Some(1));
+    std::fs::remove_dir_all(d).unwrap();
+}
+
+#[test]
+fn run_with_fidelity_counts_what_the_commands_removed_as_the_users() {
+    let d = tmpdir("fidelity-run");
+    let xlsx = d.join("stale.xlsx");
+    std::fs::write(&xlsx, pivot_xlsx(true)).unwrap();
+    // The server's export: a native workbook, `--quiet`; the parts line still goes to stdout.
+    let stale = d.join("stale.json");
+    ok(&["convert", xlsx.to_str().unwrap(), stale.to_str().unwrap()]);
+    let out = d.join("out.xlsx");
+    let o = run(&["run", "--in", stale.to_str().unwrap(), "--cmd", "cell.set={\"cell\":\"A5\",\"input\":\"x\"}", "--out", out.to_str().unwrap(), "--fidelity", "--quiet"]);
+    assert_eq!(o.status.code(), Some(3), "{}", String::from_utf8_lossy(&o.stderr));
+    // Counted in the model: the value field and the Σ Values field it took with it.
+    assert_eq!(parts_line(&o), serde_json::json!({"parts": [{"code": "pivot_fields", "count": 2}]}));
+    assert!(!out.exists());
+    // Removing the pivot is the user's change: the save goes through.
+    let o = run(&["run", "--in", stale.to_str().unwrap(), "--cmd", "selection.set={\"range\":\"D3\"}", "--cmd", "pivot.delete={}", "--out", out.to_str().unwrap(), "--fidelity", "--quiet"]);
+    assert!(o.status.success(), "{}", String::from_utf8_lossy(&o.stderr));
+    assert_eq!(parts_line(&o), serde_json::json!({"parts": []}));
+    assert!(out.exists());
+    std::fs::remove_dir_all(d).unwrap();
+}
