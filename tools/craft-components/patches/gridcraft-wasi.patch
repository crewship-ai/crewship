+/// The root element's start tag: `(start of its name, end before its closing `>` or `/>`)`.
+fn root_tag(xml: &str) -> Option<(usize, usize)> {
+    let mut at = 0;
+    loop {
+        let lt = at + xml[at..].find('<')?;
+        match xml.as_bytes().get(lt + 1) {
+            Some(b'?' | b'!') => at = lt + 1,
+            Some(_) => {
+                let gt = lt + xml[lt..].find('>')?;
+                let end = if xml[..gt].ends_with('/') { gt - 1 } else { gt };
+                return Some((lt + 1, end));
+            }
+            None => return None,
+        }
+    }
+}
