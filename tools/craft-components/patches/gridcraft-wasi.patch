+/// PivotTables that shared a cache in the file share one cache part again.
+#[test]
+fn unchanged_pivots_on_one_cache_share_it_again() {
+    let bytes = write_xlsx(&workbook()).unwrap();
+    let mut parts = unzip(&bytes);
+    // Point every table at the first cache.
+    let first = parts.keys().filter(|n| n.starts_with("xl/pivotTables/_rels/")).min().unwrap().clone();
+    let rel = parts[&first].clone();
+    let tables: Vec<String> = parts.keys().filter(|n| n.starts_with("xl/pivotTables/_rels/")).cloned().collect();
+    for t in tables {
+        parts.insert(t, rel.clone());
