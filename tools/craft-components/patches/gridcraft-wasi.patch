+/// An unchanged PivotTable is written as the file had it, so a report field whose source column
+/// is gone survives the save; a changed one is rebuilt from its source.
+#[test]
+fn an_unchanged_pivot_keeps_its_original_parts() {
+    use crate::fidelity::{losses, model_parts, package_parts};
+    let (bytes, stale) = stale_cache_xlsx();
+    let (wb, _) = read_xlsx(&bytes).unwrap();
+    let uses = |wb: &Workbook| wb.sheet(1).unwrap().pivots.iter().any(|pt| pt.values.iter().any(|v| v.source_col == stale));
+    assert!(uses(&wb), "the reader keeps the stale value field");
+    let saved = write_xlsx(&wb).unwrap();
+    let (back, _) = read_xlsx(&saved).unwrap();
+    assert!(uses(&back), "the stale field survives an unchanged save");
+    assert_eq!(as_written(&back.sheet(1).unwrap().pivots), as_written(&wb.sheet(1).unwrap().pivots));
+    let m = model_parts(&wb);
+    assert_eq!(losses(&package_parts(&bytes).unwrap(), &m, &m, &package_parts(&saved).unwrap()), vec![]);
+    // Custom number formats of value fields still name the same codes in the new styles part.
+    let formats: Vec<Option<String>> = back.sheet(1).unwrap().pivots.iter().flat_map(|pt| pt.values.iter().map(|v| v.number_format.clone())).collect();
+    let expected: Vec<Option<String>> = wb.sheet(1).unwrap().pivots.iter().flat_map(|pt| pt.values.iter().map(|v| v.number_format.clone())).collect();
+    assert_eq!(formats, expected);
+    // The report format still points at a bold italic differential format.
+    let out = unzip(&saved);
+    let table = out.iter().find(|(n, x)| n.starts_with("xl/pivotTables/pivotTable") && String::from_utf8_lossy(x).contains("<format ")).map(|(_, x)| String::from_utf8_lossy(x).into_owned()).expect("the report format is kept");
+    let id: usize = table.split("<format dxfId=\"").nth(1).unwrap().split('"').next().unwrap().parse().unwrap();
+    let styles = String::from_utf8_lossy(&out["xl/styles.xml"]).into_owned();
+    let dxfs = &styles[styles.find("<dxfs").unwrap()..styles.find("</dxfs>").unwrap()];
+    let dxf = dxfs.split("<dxf>").nth(id + 1).expect("the dxfId names a written dxf");
+    assert!(dxf.contains("<b") && dxf.contains("<i"), "{dxf}");
+    assert_eq!(package_parts(&saved).unwrap().count("pivot_formats"), 1);
+
+    // Changed: rebuilt from its source, where the deleted column's field cannot come from.
+    let mut edited = wb.clone();
+    let pt = edited.sheet_mut(1).unwrap().pivots.iter_mut().find(|pt| pt.values.iter().any(|v| v.source_col == stale)).unwrap();
+    pt.grand_totals_rows = !pt.grand_totals_rows;
+    let rebuilt_bytes = write_xlsx(&edited).unwrap();
+    let (rebuilt, _) = read_xlsx(&rebuilt_bytes).unwrap();
+    assert!(!uses(&rebuilt));
+    // Its report format goes with the rebuild, and the guard says so.
+    let lost = losses(&package_parts(&bytes).unwrap(), &m, &model_parts(&edited), &package_parts(&rebuilt_bytes).unwrap());
+    assert!(lost.contains(&("pivot_formats", 1)), "{lost:?}");
+    // Removing the PivotTable removes its format with it: no loss.
+    let mut removed = wb.clone();
+    removed.sheet_mut(1).unwrap().pivots.retain(|pt| !pt.values.iter().any(|v| v.source_col == stale));
+    let lost = losses(&package_parts(&bytes).unwrap(), &m, &model_parts(&removed), &package_parts(&write_xlsx(&removed).unwrap()).unwrap());
+    assert_eq!(lost, vec![]);
+}
