+        assert_eq!(write_package_cells(&signed, &base, &base, "xlsm").unwrap_err().code, "xml_signatures");
+        let original = package(false, false);
+        let (base, _) = crate::read_xlsx(&original).unwrap();
+        let mut edited = base.clone();
+        edited.sheet_mut(0).unwrap().name = "Renamed".into();
+        assert_eq!(write_package_cells(&original, &base, &edited, "xlsx").unwrap_err().code, "package_edit");
+    }
