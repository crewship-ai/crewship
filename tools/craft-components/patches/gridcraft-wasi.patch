+fn number_key(n: f64) -> u64 {
+    // compare_numbers: equal when equal, or when both round to the same 15 significant digits.
+    if n == 0.0 {
+        return 0.0f64.to_bits();
+    }
+    let rounded = if n.is_finite() { format!("{n:.14e}").parse().unwrap_or(n) } else { n };
