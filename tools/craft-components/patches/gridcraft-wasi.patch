+const SIGNATURE_REL: &str = "http://schemas.microsoft.com/office/2006/relationships/vbaProjectSignature";
+const AGILE_REL: &str = "http://schemas.microsoft.com/office/2014/relationships/vbaProjectSignatureAgile";
+
+/// A macro-enabled package whose VBA project carries a signature and an agile signature.
+fn signed_xlsm() -> Vec<u8> {
+    let mut wb = Workbook::new();
+    wb.vba_project = Some(b"\xd0\xcf\x11\xe0\xa1\xb1\x1a\xe1 signed vbaProject".to_vec().into());
+    let mut parts = zip_parts(&write_xlsx(&wb).unwrap());
+    parts.insert("xl/vbaProjectSignature.bin".into(), b"legacy signature".to_vec());
+    parts.insert("xl/vbaProjectSignatureAgile.bin".into(), b"agile signature".to_vec());
+    parts.insert(
+        "xl/_rels/vbaProject.bin.rels".into(),
+        format!(r#"<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="{SIGNATURE_REL}" Target="vbaProjectSignature.bin"/><Relationship Id="rId2" Type="{AGILE_REL}" Target="vbaProjectSignatureAgile.bin"/></Relationships>"#).into_bytes(),
+    );
+    let ct = String::from_utf8(parts["[Content_Types].xml"].clone()).unwrap().replace(
+        "</Types>",
+        r#"<Override PartName="/xl/vbaProjectSignature.bin" ContentType="application/vnd.ms-office.vbaProjectSignature"/><Override PartName="/xl/vbaProjectSignatureAgile.bin" ContentType="application/vnd.ms-office.vbaProjectSignatureAgile"/></Types>"#,
+    );
+    parts.insert("[Content_Types].xml".into(), ct.into_bytes());
+    zip_of(&parts)
+}
