+/// The `*IFS` functions give the same values from an equality index as from a walk over their
+/// blocks: numbers equal to 15 digits, numeric text, case, booleans, blanks, errors, wildcards
+/// (not indexed), several pairs, a criteria block holding a formula (not indexed), and errors
+/// in the summed block.
+#[test]
+fn ifs_from_an_index_give_what_the_walk_gives() {
+    use gridcraft_model::Cell;
+    let mut t = T::new();
+    let keys: [Value; 14] = [
+        Value::Number(5.0),
+        Value::text("5"),
+        Value::text("abc"),
+        Value::text("ABC"),
+        Value::text("Abc "),
+        Value::Number(0.30000000000000004),
+        Value::Number(0.3),
+        Value::Number(-0.0),
+        Value::Bool(true),
+        Value::Bool(false),
+        Value::Empty,
+        Value::text(""),
+        Value::Error(CellError::NA),
+        Value::text("İx"),
+    ];
+    for r in 0..120u32 {
+        let sh = t.wb.sheet_mut(0).unwrap();
+        let k = keys[(r as usize * 7) % keys.len()].clone();
+        if !k.is_empty() {
+            sh.cells.set(CellRef::new(r + 1, 0), Cell::value(k));
+        }
+        let amount = if r % 23 == 0 { Value::Error(CellError::Div0) } else { Value::Number(f64::from(r) * 1.5 - 40.0) };
+        sh.cells.set(CellRef::new(r + 1, 1), Cell::value(amount));
+        sh.cells.set(CellRef::new(r + 1, 2), Cell::value(Value::text(if r % 3 == 0 { "north" } else { "South" })));
+    }
+    // Criteria: from cells (D) and literals.
+    let criteria = ["5", "\"5\"", "\"=5\"", "\"abc\"", "\"ABC\"", "\"abc \"", "0.3", "\"0.3\"", "TRUE", "\"FALSE\"", "\"\"", "\"=\"", "\"<>abc\"", "\"ab*\"", "\"#N/A\"", "\"ix\"", "\">4\"", "D1", "D2", "D3"];
+    t.set("D1", "abc");
+    t.set("D2", "0.30000000000000004");
+    t.set("D3", "");
+    let mut row = 1;
+    for crit in criteria {
+        for f in [
+            format!("=COUNTIFS($A$2:$A$121,{crit})"),
+            format!("=SUMIFS($B$2:$B$121,$A$2:$A$121,{crit})"),
+            format!("=SUMIFS($B$2:$B$121,$A$2:$A$121,{crit},$C$2:$C$121,\"south\")"),
+            format!("=AVERAGEIFS($B$2:$B$121,$A$2:$A$121,{crit})"),
+            format!("=MAXIFS($B$2:$B$121,$C$2:$C$121,\"NORTH\",$A$2:$A$121,{crit})"),
+            format!("=MINIFS($B$2:$B$121,$A$2:$A$121,{crit})"),
+            format!("=SUMIFS($B$2:$B$121,$A$2:$A$121,{crit},$B$2:$B$121,\">0\")"),
+        ] {
+            row += 1;
+            t.set(&format!("F{row}"), &f);
+        }
+    }
+    // A criteria block with a formula in it goes the usual way.
+    t.set("H2", "=SUMIFS($B$2:$B$121,$G$2:$G$121,\"x\")");
+    t.set("G5", "=\"x\"");
+    t.set("G7", "x");
+
+    crate::criteria_index::ANSWERED.with(|n| n.set(0));
+    t.calc.recalc_all(&mut t.wb);
+    let indexed = formula_values(&t);
+    let answered = crate::criteria_index::ANSWERED.with(std::cell::Cell::get);
+    crate::criteria_index::OFF.with(|o| o.set(true));
+    t.calc.recalc_all(&mut t.wb);
+    crate::criteria_index::OFF.with(|o| o.set(false));
+    let walked = formula_values(&t);
+    assert_eq!(indexed.len(), walked.len());
+    for ((at, a), (_, b)) in indexed.iter().zip(&walked) {
+        assert!(a == b || (a.as_f64().is_some() && a.as_f64().map(f64::to_bits) == b.as_f64().map(f64::to_bits)), "{}: {a:?} indexed, {b:?} walked ({:?})", at.a1(), t.wb.sheet(0).unwrap().cell(*at).and_then(|c| c.formula.as_ref()).map(|f| f.text.clone()));
+    }
+    assert!(answered >= 80, "the index answered {answered} calls");
+    assert_eq!(t.num("H2"), t.num("B5") + t.num("B7"));
+}
