+/// A saved package that dropped a pivot's value field is a `pivot_fields` loss; the same package
+/// saved after the user removed that pivot is none.
+#[test]
+fn fidelity_tells_a_writer_loss_from_a_user_removal() {
+    use crate::fidelity::{losses, model_parts, package_parts};
+    let wb = workbook();
+    let bytes = write_xlsx(&wb).unwrap();
+    let (opened_wb, _) = read_xlsx(&bytes).unwrap();
+    let opened = package_parts(&bytes).unwrap();
+    assert_eq!(opened.count("pivot_tables"), 3);
+    assert_eq!(opened.count("sheets"), 2);
+    assert_eq!(opened.count("tables"), 1);
+    assert!(opened.count("pivot_fields") >= 6, "{opened:?}");
+    let at_open = model_parts(&opened_wb);
+
+    // The writer dropped one value field of one pivot.
+    let mut parts = unzip(&bytes);
+    let (name, xml) = parts.iter_mut().find(|(n, x)| n.starts_with("xl/pivotTables/pivotTable") && String::from_utf8_lossy(x).contains("<dataField ")).unwrap();
+    let text = String::from_utf8_lossy(xml).into_owned();
+    let start = text.find("<dataField ").unwrap();
+    let end = start + text[start..].find("/>").map(|e| e + 2).filter(|e| !text[start..start + e].contains("<extLst>")).unwrap_or_else(|| text[start..].find("</dataField>").unwrap() + "</dataField>".len());
+    *xml = format!("{}{}", &text[..start], &text[end..]).into_bytes();
+    let _ = name;
+    let saved = package_parts(&rezip(&parts)).unwrap();
+    assert_eq!(losses(&opened, &at_open, &at_open, &saved), vec![("pivot_fields", 1)]);
+
+    // The user removed a whole pivot: fewer tables and fields, and no loss.
+    let mut edited = opened_wb.clone();
+    edited.sheet_mut(1).unwrap().pivots.remove(0);
+    let now = model_parts(&edited);
+    let saved = package_parts(&write_xlsx(&edited).unwrap()).unwrap();
+    assert_eq!(saved.count("pivot_tables"), 2);
+    assert_eq!(losses(&opened, &at_open, &now, &saved), vec![]);
+    // An unchanged save loses nothing.
+    let again = package_parts(&write_xlsx(&opened_wb).unwrap()).unwrap();
+    assert_eq!(losses(&opened, &at_open, &at_open, &again), vec![]);
+}
