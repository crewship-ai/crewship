+fn rezip(parts: &HashMap<String, Vec<u8>>) -> Vec<u8> {
+    use std::io::Write;
+    let mut w = zip::ZipWriter::new(std::io::Cursor::new(Vec::new()));
+    let mut names: Vec<&String> = parts.keys().collect();
+    names.sort();
+    for n in names {
+        w.start_file(n.as_str(), zip::write::SimpleFileOptions::default()).unwrap();
+        w.write_all(&parts[n]).unwrap();
+    }
+    w.finish().unwrap().into_inner()
+}
