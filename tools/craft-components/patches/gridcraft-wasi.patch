+/// The custom number formats an original part's `numFmtId`s name.
+fn original_num_fmts<'a>(xml: &'a str, num_fmts: &'a HashMap<u32, String>) -> impl Iterator<Item = &'a String> + 'a {
+    num_fmt_ids(xml).filter_map(move |(_, id)| num_fmts.get(&id))
