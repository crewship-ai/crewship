+    assert!(s.execute("file.save", json!({})).is_err());
+    assert!(Arc::ptr_eq(&s.active().unwrap().saved, &baseline));
+    assert!(s.active().unwrap().is_dirty());
+    assert!(s.ui_requests.is_empty());
+}
