index 00000000..c8e7f941
--- /dev/null
+++ b/crates/xlsx/src/fidelity.rs
@@ -0,0 +1,317 @@
+//! Save fidelity: whether a workbook package written for a document keeps the parts of the one
+//! it was opened from. A part that is in the opened file and missing from the saved one, and that
+//! the user did not remove, is a loss: the editor refuses such a save rather than hand the host a
+//! file that silently dropped pivot fields, charts or rules.
+//!
+//! Parts are counted twice. In a package, straight from its XML, so that what the reader or the
+//! writer leaves out shows up; and in a model, so that what the user removed between open and
+//! save is not taken for a loss. Only the differences of each count matter, never its units.
+
+use std::io::Read;
+
+use gridcraft_model::Workbook;
+use sha2::{Digest, Sha256};
+
+/// The part codes, in the order losses are reported. They name kinds of parts, never content.
+pub const CODES: [&str; 12] = [
+    "sheets",
+    "defined_names",
+    "pivot_tables",
+    "pivot_fields",
+    "charts",
+    "conditional_formats",
+    "data_validations",
+    "comments",
+    "tables",
+    "vba_project",
+    "pivot_formats",
+    "vba_signature",
+];
+
+const SHEETS: usize = 0;
+const DEFINED_NAMES: usize = 1;
+const PIVOT_TABLES: usize = 2;
+const PIVOT_FIELDS: usize = 3;
+const CHARTS: usize = 4;
+const CONDITIONAL_FORMATS: usize = 5;
+const DATA_VALIDATIONS: usize = 6;
+const COMMENTS: usize = 7;
+const TABLES: usize = 8;
+const VBA_PROJECT: usize = 9;
+const PIVOT_FORMATS: usize = 10;
+const VBA_SIGNATURE: usize = 11;
+
+/// A PivotTable part's report formats: its `<format>` and `<conditionalFormat>` elements.
+pub(crate) fn pivot_format_count(xml: &str) -> u64 {
+    count_tags(xml, "format") + count_tags(xml, "conditionalFormat")
+}
+
+/// How many of each part a package or a model has, and the macro project's digest.
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct Parts {
+    counts: [u64; CODES.len()],
+    vba: Option<[u8; 32]>,
+}
+
+impl Parts {
+    /// The count of one part code; 0 for an unknown code.
+    pub fn count(&self, code: &str) -> u64 {
+        CODES.iter().position(|c| *c == code).map_or(0, |i| self.counts[i])
+    }
+}
+
+/// The parts of an xlsx or xlsm package, counted in its XML.
+pub fn package_parts(bytes: &[u8]) -> Result<Parts, String> {
+    let mut zip = zip::ZipArchive::new(std::io::Cursor::new(bytes)).map_err(|e| format!("not a workbook package: {e}"))?;
+    let mut p = Parts::default();
+    for i in 0..zip.len() {
+        let mut file = zip.by_index(i).map_err(|e| e.to_string())?;
+        let name = file.name().unwrap_or_default().to_ascii_lowercase();
+        let kind = part_kind(&name);
+        if kind == Kind::Other {
+            continue;
+        }
+        let mut raw = Vec::new();
+        file.read_to_end(&mut raw).map_err(|e| format!("{name}: {e}"))?;
+        if kind == Kind::VbaSignature {
+            p.counts[VBA_SIGNATURE] += 1;
+            continue;
+        }
+        if kind == Kind::Vba {
+            p.counts[VBA_PROJECT] += 1;
+            p.vba = Some(Sha256::digest(&raw).into());
+            continue;
+        }
+        let xml = String::from_utf8_lossy(&raw);
+        match kind {
+            Kind::Workbook => {
+                p.counts[SHEETS] += count_tags(&xml, "sheet");
+                // Autofilter's helper names are rebuilt from the filters, not kept as names.
+                p.counts[DEFINED_NAMES] += count_tags(&xml, "definedName").saturating_sub(xml.matches("name=\"_xlnm._FilterDatabase\"").count() as u64);
+            }
+            Kind::Worksheet => {
+                p.counts[CONDITIONAL_FORMATS] += count_tags(&xml, "cfRule");
+                p.counts[DATA_VALIDATIONS] += count_tags(&xml, "dataValidation");
+            }
+            Kind::PivotTable => {
+                p.counts[PIVOT_TABLES] += 1;
+                p.counts[PIVOT_FORMATS] += pivot_format_count(&xml);
+                p.counts[PIVOT_FIELDS] += count_tags(&xml, "dataField") + count_tags(&xml, "pageField");
+                for axis in ["rowFields", "colFields"] {
+                    p.counts[PIVOT_FIELDS] += within(&xml, axis).map_or(0, |body| count_tags(body, "field"));
+                }
+            }
+            Kind::Chart => p.counts[CHARTS] += 1,
+            Kind::Comments => p.counts[COMMENTS] += count_tags(&xml, "comment"),
+            Kind::Table => p.counts[TABLES] += 1,
+            Kind::Vba | Kind::VbaSignature | Kind::Other => {}
+        }
+    }
+    Ok(p)
+}
+
+/// The parts of a workbook model, in units close to the package's (only their changes are used).
+pub fn model_parts(wb: &Workbook) -> Parts {
+    let mut p = Parts::default();
+    p.counts[SHEETS] = wb.sheets.len() as u64;
+    p.counts[DEFINED_NAMES] = wb.names.len() as u64;
+    for sh in &wb.sheets {
+        p.counts[PIVOT_TABLES] += sh.pivots.len() as u64;
+        for pt in &sh.pivots {
+            let axis = pt.rows.iter().chain(&pt.columns);
+            let pages = pt.filters.iter().filter(|f| !axis.clone().any(|a| a.source_col.eq_ignore_ascii_case(&f.source_col))).count();
+            let sigma = u64::from(pt.values.len() >= 2);
+            p.counts[PIVOT_FIELDS] += (pt.values.len() + pt.rows.len() + pt.columns.len() + pages) as u64 + sigma;
+            // Report formats live only in a PivotTable's original parts: kept while it is
+            // unchanged, lost when it is rebuilt, gone with it when it is removed.
+            p.counts[PIVOT_FORMATS] += pt.original.parts().map_or(0, |o| o.formats);
+        }
+        p.counts[CHARTS] += sh.charts.len() as u64;
+        p.counts[CONDITIONAL_FORMATS] += sh.cond_formats.len() as u64;
+        p.counts[DATA_VALIDATIONS] += sh.validations.iter().filter(|v| !v.ranges.is_empty()).count() as u64;
+        p.counts[COMMENTS] += sh.comments.len() as u64;
+        p.counts[TABLES] += sh.tables.len() as u64;
+    }
+    if let Some(vba) = &wb.vba_project {
+        p.counts[VBA_SIGNATURE] = wb.vba_signatures.len() as u64;
+        p.counts[VBA_PROJECT] = 1;
+        p.vba = Some(Sha256::digest(vba.as_slice()).into());
+    }
+    p
+}
+
+/// The parts a save would lose: `(code, count)` for each part the saved package has fewer of
+/// than the opened one, beyond what the user removed from the model since it was opened. A
+/// macro project that is still in the model but changed in the package is one lost
+/// `vba_project`. Empty when nothing is lost.
+pub fn losses(opened: &Parts, model_at_open: &Parts, model_now: &Parts, saved: &Parts) -> Vec<(&'static str, u64)> {
+    let mut out = Vec::new();
+    for (i, code) in CODES.iter().enumerate() {
+        let dropped = opened.counts[i].saturating_sub(saved.counts[i]);
+        let removed = model_at_open.counts[i].saturating_sub(model_now.counts[i]);
+        let mut lost = dropped.saturating_sub(removed);
+        if i == VBA_PROJECT && lost == 0 && opened.vba.is_some() && model_now.vba.is_some() && saved.vba != opened.vba && saved.vba != model_now.vba {
+            lost = 1;
+        }
+        if lost > 0 {
+            out.push((*code, lost));
+        }
+    }
+    out
+}
+
+/// The parts of the workbook a package reads back as: for comparing a written package with the
+/// model it was written from, when there is no opened package to compare it with.
+pub fn read_parts(bytes: &[u8]) -> Result<Parts, String> {
+    crate::read_xlsx(bytes).map(|(wb, _)| model_parts(&wb)).map_err(|e| e.to_string())
+}
+
+/// What a convert lost: the input package's parts against the output's, with no user edits.
+pub fn convert_losses(input: &Parts, output: &Parts) -> Vec<(&'static str, u64)> {
+    losses(input, input, input, output)
+}
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Kind {
+    Workbook,
+    Worksheet,
+    PivotTable,
+    Chart,
+    Comments,
+    Table,
+    Vba,
+    VbaSignature,
+    Other,
+}
+
+/// Which counted part a package entry is, by its conventional path. Relationship parts and
+/// anything else are not counted.
+fn part_kind(name: &str) -> Kind {
+    let name = name.trim_start_matches('/');
+    if name.contains("/_rels/") || name.ends_with(".rels") {
+        return Kind::Other;
+    }
+    let file = name.rsplit('/').next().unwrap_or(name);
+    let in_dir = |dir: &str, prefix: &str| name.starts_with(dir) && file.starts_with(prefix) && file.ends_with(".xml");
+    if name == "xl/workbook.xml" {
+        Kind::Workbook
+    } else if in_dir("xl/worksheets/", "sheet") {
+        Kind::Worksheet
+    } else if in_dir("xl/pivottables/", "pivottable") {
+        Kind::PivotTable
+    } else if in_dir("xl/charts/", "chart") && !file.starts_with("chartstyle") && !file.starts_with("chartcolor") {
+        Kind::Chart
+    } else if name.starts_with("xl/comments") && file.ends_with(".xml") {
+        Kind::Comments
+    } else if in_dir("xl/tables/", "table") {
+        Kind::Table
+    } else if name == "xl/vbaproject.bin" {
+        Kind::Vba
+    } else if name.starts_with("xl/vbaprojectsignature") && name.ends_with(".bin") {
+        Kind::VbaSignature
+    } else {
+        Kind::Other
+    }
+}
+
+/// Start tags named `local` in any namespace prefix (`<cfRule`, `<x14:cfRule`), not tags that
+/// only begin with it (`<cfRules`).
+fn count_tags(xml: &str, local: &str) -> u64 {
+    let bytes = xml.as_bytes();
+    let mut n = 0;
+    let mut at = 0;
+    while let Some(off) = xml[at..].find('<') {
+        let start = at + off + 1;
+        let end = xml[start..].find(|c: char| c.is_whitespace() || c == '>' || c == '/').map_or(xml.len(), |e| start + e);
+        let tag = &xml[start..end];
+        if !tag.is_empty() && bytes[start] != b'/' && tag.rsplit(':').next() == Some(local) {
+            n += 1;
+        }
+        at = end.max(start);
+    }
+    n
+}
+
+/// The body of the first `<name …>…</name>` element (unprefixed), if any.
+fn within<'a>(xml: &'a str, name: &str) -> Option<&'a str> {
+    let open = format!("<{name}");
+    let mut at = 0;
+    while let Some(off) = xml[at..].find(&open) {
+        let start = at + off + open.len();
+        match xml.as_bytes().get(start) {
+            Some(b' ' | b'>' | b'\t' | b'\r' | b'\n') => {
+                let body = start + xml[start..].find('>')? + 1;
+                if xml[..body].ends_with("/>") {
+                    return Some("");
+                }
+                let end = body + xml[body..].find(&format!("</{name}>"))?;
+                return Some(&xml[body..end]);
+            }
+            _ => at = start,
+        }
+    }
+    None
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn tags_count_in_any_prefix_and_not_by_prefix_of_the_name() {
+        let xml = r#"<conditionalFormatting><cfRule type="x"/><x14:cfRule id="1"></x14:cfRule></conditionalFormatting><cfRules/><dataValidations count="1"><dataValidation sqref="A1"/></dataValidations>"#;
+        assert_eq!(count_tags(xml, "cfRule"), 2);
+        assert_eq!(count_tags(xml, "dataValidation"), 1);
+        assert_eq!(count_tags(xml, "dataValidations"), 1);
+    }
+
+    #[test]
+    fn autofilter_helper_names_are_not_counted() {
+        let book = r#"<workbook><sheets><sheet name="A" sheetId="1"/></sheets><definedNames><definedName name="_xlnm._FilterDatabase" localSheetId="0" hidden="1">A!$A$1:$B$4</definedName><definedName name="Rate">0.2</definedName></definedNames></workbook>"#;
+        let mut w = zip::ZipWriter::new(std::io::Cursor::new(Vec::new()));
+        w.start_file("xl/workbook.xml", zip::write::SimpleFileOptions::default()).unwrap();
+        std::io::Write::write_all(&mut w, book.as_bytes()).unwrap();
+        let p = package_parts(&w.finish().unwrap().into_inner()).unwrap();
+        assert_eq!((p.count("sheets"), p.count("defined_names")), (1, 1));
+    }
+
+    #[test]
+    fn axis_fields_are_counted_inside_their_element() {
+        let xml = r#"<pivotFields><pivotField/></pivotFields><rowFields count="2"><field x="0"/><field x="-2"/></rowFields><colFields count="1"><field x="1"/></colFields><rowItems/>"#;
+        assert_eq!(within(xml, "rowFields").map(|b| count_tags(b, "field")), Some(2));
+        assert_eq!(within(xml, "colFields").map(|b| count_tags(b, "field")), Some(1));
+        assert_eq!(within(xml, "pageFields"), None);
+    }
+
+    fn parts(counts: [u64; CODES.len()]) -> Parts {
+        Parts { counts, vba: None }
+    }
+
+    #[test]
+    fn a_drop_the_user_made_is_no_loss_and_one_the_writer_made_is() {
+        let mut opened = [0; CODES.len()];
+        opened[PIVOT_FIELDS] = 10;
+        opened[CHARTS] = 2;
+        let mut model_open = [0; CODES.len()];
+        model_open[PIVOT_FIELDS] = 8;
+        model_open[CHARTS] = 2;
+        let mut model_now = model_open;
+        model_now[CHARTS] = 1; // the user deleted a chart
+        let mut saved = opened;
+        saved[CHARTS] = 1;
+        saved[PIVOT_FIELDS] = 7; // the writer dropped three fields
+        assert_eq!(losses(&parts(opened), &parts(model_open), &parts(model_now), &parts(saved)), vec![("pivot_fields", 3)]);
+        assert_eq!(losses(&parts(opened), &parts(model_open), &parts(model_now), &parts(opened)), vec![]);
+    }
+
+    #[test]
+    fn a_changed_macro_project_is_a_loss() {
+        let mut opened = parts([0; CODES.len()]);
+        opened.counts[VBA_PROJECT] = 1;
+        opened.vba = Some([1; 32]);
+        let mut saved = opened.clone();
+        saved.vba = Some([2; 32]);
+        assert_eq!(losses(&opened, &opened, &opened, &saved), vec![("vba_project", 1)]);
+        assert_eq!(losses(&opened, &opened, &opened, &opened), vec![]);
+    }
+}
