+/// Sets (or, with `None`, removes) an attribute of the root element.
+fn set_root_attr(xml: &str, name: &str, value: Option<&str>) -> String {
+    let Some((start, end)) = root_tag(xml) else { return xml.to_string() };
+    let tag = &xml[start..end];
+    let key = format!(" {name}=\"");
+    let new_attr = value.map(|v| format!(" {name}=\"{}\"", esc_attr(v))).unwrap_or_default();
+    let tag = match tag.find(&key) {
+        Some(at) => {
+            let vend = at + key.len() + tag[at + key.len()..].find('"').unwrap_or(0) + 1;
+            format!("{}{new_attr}{}", &tag[..at], &tag[vend..])
