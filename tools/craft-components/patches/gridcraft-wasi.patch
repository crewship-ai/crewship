+/// The VBA project's signatures are written back byte for byte, with their relationships and
+/// content types, so a signed project stays signed; the save fidelity check counts them.
+#[test]
+fn vba_project_signatures_roundtrip() {
+    let file = signed_xlsm();
+    let (wb, _) = read_xlsx(&file).unwrap();
+    assert_eq!(wb.vba_signatures.len(), 2);
+    let saved = write_xlsx(&wb).unwrap();
+    let (before, after) = (zip_parts(&file), zip_parts(&saved));
+    for name in ["xl/vbaProject.bin", "xl/vbaProjectSignature.bin", "xl/vbaProjectSignatureAgile.bin"] {
+        assert_eq!(after.get(name), before.get(name), "{name} byte for byte");
+    }
+    let rels = String::from_utf8(after["xl/_rels/vbaProject.bin.rels"].clone()).unwrap();
+    assert!(rels.contains(SIGNATURE_REL) && rels.contains(AGILE_REL), "{rels}");
+    let ct = String::from_utf8(after["[Content_Types].xml"].clone()).unwrap();
+    for t in ["application/vnd.ms-office.vbaProjectSignature\"", "application/vnd.ms-office.vbaProjectSignatureAgile\""] {
+        assert!(ct.contains(t), "{t}: {ct}");
+    }
+
+    let opened = crate::fidelity::package_parts(&file).unwrap();
+    assert_eq!(opened.count("vba_signature"), 2);
+    let model = crate::fidelity::model_parts(&wb);
+    assert_eq!(crate::fidelity::losses(&opened, &model, &model, &crate::fidelity::package_parts(&saved).unwrap()), vec![]);
+
+    // A writer that drops them loses them.
+    let mut unsigned = wb.clone();
+    unsigned.vba_signatures = Arc::default();
+    let lost = crate::fidelity::losses(&opened, &model, &model, &crate::fidelity::package_parts(&write_xlsx(&unsigned).unwrap()).unwrap());
+    assert_eq!(lost, vec![("vba_signature", 2)]);
+}
