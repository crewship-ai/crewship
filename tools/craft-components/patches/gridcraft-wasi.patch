diff --git a/crates/calc/src/criteria_index.rs b/crates/calc/src/criteria_index.rs
new file mode 100644
index 00000000..957bb4b6
--- /dev/null
+++ b/crates/calc/src/criteria_index.rs
@@ -0,0 +1,47 @@
+//! Equality indexes over blocks of constants, for the `*IFS` functions: a formula of the kind
+//! `SUMIFS(amounts, ids, $A2)` repeated on thousands of rows reads its criteria block once per
+//! calculation pass instead of once per formula.
+
+use std::collections::HashMap;
+
+use gridcraft_core::Value;
+use gridcraft_functions::criteria::{IndexKey, value_index_keys};
+
+#[cfg(test)]
+thread_local! {
+    /// Tests: no block is indexed, so every `*IFS` goes the usual way.
+    pub(crate) static OFF: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+    /// Tests: how many `*IFS` calls an index answered.
+    pub(crate) static ANSWERED: std::cell::Cell<u64> = const { std::cell::Cell::new(0) };
+}
+
+/// Where each key occurs in a block, as row-major offsets in ascending order.
+#[derive(Debug, Default)]
+pub struct CriteriaIndex {
+    keys: HashMap<IndexKey, Vec<u32>>,
+}
+
+impl CriteriaIndex {
+    /// Indexes the stored values of a block, given row-major as (offset, value).
+    pub fn build<'a>(values: impl Iterator<Item = (u32, &'a Value)>) -> CriteriaIndex {
+        let mut keys: HashMap<IndexKey, Vec<u32>> = HashMap::new();
+        let mut scratch = Vec::new();
+        for (at, v) in values {
+            scratch.clear();
+            value_index_keys(v, &mut scratch);
+            for k in scratch.drain(..) {
+                keys.entry(k).or_default().push(at);
+            }
+        }
+        for list in keys.values_mut() {
+            list.sort_unstable();
+            list.dedup();
+        }
+        CriteriaIndex { keys }
+    }
+
+    /// The offsets a value with this key is at; every other offset can't match it.
+    pub fn positions(&self, key: &IndexKey) -> &[u32] {
+        self.keys.get(key).map_or(&[], Vec::as_slice)
+    }
+}
