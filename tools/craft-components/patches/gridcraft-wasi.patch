+    let again = crate::io::save_bytes(&o.doc().unwrap().wb, "doc.xlsx").unwrap();
+    let mut r = Session::new();
+    r.execute("file.open", json!({"name": "doc.xlsx", "base64": crate::io::base64_encode(&again)})).unwrap();
