+        Value::Bool(b) => out.push(IndexKey::Bool(*b)),
+        Value::Text(t) => {
+            out.push(IndexKey::Text(t.chars().map(lower_char).collect()));
+            // A number criterion matches numeric text for equality (COUNTIF("1") counts "1").
+            if let Some(n) = parse_number_text(t) {
