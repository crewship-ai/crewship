+    s.execute("cell.set", json!({"cell": "G1", "input": check})).unwrap();
+    s.execute("cell.set", json!({"cell": "G2", "input": r#"=GETPIVOTDATA("Sum of Sales",$A$3)"#})).unwrap();
+    let doc = s.doc().unwrap();
+    let si = doc.wb.active_sheet();
+    let name = doc.wb.sheets[si].name.clone();
+    let read = |s: &mut Session| s.execute("sheet.read", json!({"range": "G1:G2", "sheet": name})).unwrap();
