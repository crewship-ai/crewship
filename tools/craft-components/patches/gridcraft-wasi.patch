diff --git a/crates/calc/src/eval/ifs.rs b/crates/calc/src/eval/ifs.rs
new file mode 100644
index 00000000..190c4886
--- /dev/null
+++ b/crates/calc/src/eval/ifs.rs
@@ -0,0 +1,139 @@
+//! `SUMIFS`, `COUNTIFS`, `AVERAGEIFS`, `MAXIFS` and `MINIFS` over references, answered from an
+//! equality index of one criteria block instead of a walk over every block.
+//!
+//! The result is the one the function itself gives: the index only narrows the positions down
+//! to those whose value has the criterion's key, every position left is checked against every
+//! criterion with `Criterion::matches`, and the matched values are taken in row-major order.
+//! Anything else (an array criterion, a block of formulas, blocks of different shapes, too
+//! little work left) goes the usual way.
+
+use gridcraft_core::RangeRef;
+use gridcraft_functions::criteria::Criterion;
+
+use super::{Area, CellError, Ev, Evaluator, MAX_CELLS, Value, err};
+
+/// The functions this answers, and the argument their first criteria pair starts at.
+pub(super) fn first_pair(name: &str) -> Option<usize> {
+    match name {
+        "COUNTIFS" => Some(0),
+        "SUMIFS" | "AVERAGEIFS" | "MAXIFS" | "MINIFS" => Some(1),
+        _ => None,
+    }
+}
+
+/// Longest criterion text this answers; a longer one is cut or refused by the function itself.
+const MAX_CRITERION_BYTES: usize = 255;
+
+impl Evaluator<'_> {
+    /// `name` over its evaluated arguments, or `None` when it has to go the usual way.
+    pub(super) fn ifs_by_index(&mut self, name: &str, evs: &[Ev]) -> Option<Ev> {
+        let first = first_pair(name)?;
+        let rest = evs.get(first..)?;
+        if rest.is_empty() || rest.len() % 2 != 0 {
+            return None;
+        }
+        let one = |ev: &Ev| match ev {
+            Ev::R(areas) => match areas.as_slice() {
+                [a] => Some(*a),
+                _ => None,
+            },
+            _ => None,
+        };
+        // Every block as the function would read it, all of one shape.
+        let target = match first {
+            0 => None,
+            _ => Some(one(evs.first()?)?),
+        };
+        let mut blocks: Vec<Area> = Vec::with_capacity(rest.len() / 2 + 1);
+        for a in target.iter().copied().chain(rest.chunks(2).filter_map(|p| p.first().and_then(one))) {
+            blocks.push(Area { sheet: a.sheet, range: self.read_range(&a) });
+        }
+        if blocks.len() != rest.len() / 2 + usize::from(target.is_some()) {
+            return None;
+        }
+        let shape = |r: RangeRef| (r.height(), r.width());
+        let (h, w) = shape(blocks.first()?.range);
+        let cells = u64::from(h) * u64::from(w);
+        if !(2..=MAX_CELLS).contains(&cells) || blocks.iter().any(|b| shape(b.range) != (h, w)) {
+            return None;
+        }
+        // Each criterion is a single value.
+        let single_pair = rest.len() == 2;
+        let mut criteria = Vec::with_capacity(rest.len() / 2);
+        for pair in rest.chunks(2) {
+            let value = match pair.get(1)? {
+                Ev::V(Value::Array(_)) | Ev::L(_) => return None,
+                Ev::V(v) => v.clone(),
+                Ev::R(areas) => match areas.as_slice() {
+                    [a] if a.range.is_single() => self.host.cell_value(a.sheet, a.range.start),
+                    _ => return None,
+                },
+            };
+            if matches!(&value, Value::Text(t) if t.len() > MAX_CRITERION_BYTES) {
+                return None;
+            }
+            let value = value.scalar();
+            let c = if single_pair { Criterion::parse_arg(&value).ok()? } else { Criterion::parse_arg_truncated(&value) };
+            criteria.push(c);
+        }
+        // The work the usual way spends: each block read, then every value handed over.
+        let pair_blocks = &blocks[usize::from(target.is_some())..];
+        let needed = cells.saturating_mul(2 * blocks.len() as u64).saturating_add(criteria.len() as u64);
+        if self.work < needed {
+            return None;
+        }
+        // The smallest set of candidates any indexed criterion gives.
+        let mut best: Option<(std::sync::Arc<crate::criteria_index::CriteriaIndex>, gridcraft_functions::criteria::IndexKey)> = None;
+        for (block, c) in pair_blocks.iter().zip(&criteria) {
+            let Some(key) = c.index_key() else { continue };
+            let Some(index) = self.host.criteria_index(block.sheet, block.range) else { continue };
+            if best.as_ref().is_none_or(|(b, k)| index.positions(&key).len() < b.positions(k).len()) {
+                best = Some((index, key));
+            }
+        }
+        let (index, key) = best?;
+        if !self.spend(needed) {
+            return Some(err(CellError::Calc));
+        }
+        let at = |r: RangeRef, offset: u32| {
+            let (dr, dc) = (offset / w, offset % w);
+            gridcraft_core::CellRef::new(r.start.row + dr, r.start.col + dc)
+        };
+        let mut count = 0u64;
+        let mut numbers = Vec::new();
+        for &offset in index.positions(&key) {
+            let mut all = true;
+            // Every criterion, the indexed one too: its key only narrows the positions down.
+            for (block, c) in pair_blocks.iter().zip(&criteria) {
+                let v = self.host.cell_value(block.sheet, at(block.range, offset));
+                if !c.matches(&v) {
+                    all = false;
+                    break;
+                }
+            }
+            if !all {
+                continue;
+            }
+            count += 1;
+            if let Some(t) = target {
+                let t = Area { sheet: t.sheet, range: blocks[0].range };
+                match self.host.cell_value(t.sheet, at(t.range, offset)) {
+                    Value::Number(n) => numbers.push(n),
+                    Value::Error(e) => return Some(err(e)),
+                    _ => {}
+                }
+            }
+        }
+        let v = match name {
+            "COUNTIFS" => Value::number(count as f64),
+            "SUMIFS" => Value::number(numbers.iter().sum()),
+            "AVERAGEIFS" if numbers.is_empty() => Value::Error(CellError::Div0),
+            "AVERAGEIFS" => Value::number(numbers.iter().sum::<f64>() / numbers.len() as f64),
+            "MAXIFS" => Value::number(numbers.iter().copied().reduce(f64::max).unwrap_or(0.0)),
+            _ => Value::number(numbers.iter().copied().reduce(f64::min).unwrap_or(0.0)),
+        };
+        #[cfg(test)]
+        crate::criteria_index::ANSWERED.with(|n| n.set(n.get() + 1));
+        Some(Ev::V(v))
+    }
+}
