+        port.receive(again("k3", &saved), Vec::new);
+        let out = port.sync(&mut app);
+        assert_eq!(out.iter().find(|o| o.kind == "executed").unwrap().get("code"), Some(&s("stale_base")));
+        port.receive(again("k4", &next), Vec::new);
+        let out = port.sync(&mut app);
+        let done = out.iter().find(|o| o.kind == "executed").unwrap();
+        assert_eq!(done.get("applied"), Some(&Value::Num(1.0)), "{done:?}");
+        assert!(matches!(done.get("conflicts"), Some(Value::Conflicts(c)) if c.is_empty()));
+        let d = app.session.active().unwrap();
+        assert_eq!((cell(&d.wb, "C1"), cell(&d.wb, "E1")), ("mine".to_string(), "8".to_string()));
+        assert_eq!((cell(&d.saved, "C1"), cell(&d.saved, "D1"), cell(&d.saved, "E1")), ("agent".to_string(), "7".to_string(), "8".to_string()));
+        assert!(d.is_dirty());
+        // The person's save names only the person's cell: the agent's are in the saved version.
+        let saved = save_now(&mut port, &mut app, "s1");
+        assert_eq!(saved.get("touched"), Some(&Value::Addresses(vec!["'Sheet1'!C1".into()])), "{:?}", saved.get("touched"));
+    }
+
+    /// `changed.calculated` turns true only once every formula was evaluated: an edit of an input
+    /// recalculates what it reaches, the rest are still the file's values. It never turns back.
+    #[test]
+    fn changed_says_calculated_once_every_formula_was_evaluated() {
+        let mut app = app();
+        let mut port = PortSession::default();
+        open(&mut port, &mut app, "Plan.xlsx", stale_xlsx(), false);
+        app.set_read_only(false);
+        let changed = |out: &[Out]| out.iter().filter(|o| o.kind == "changed").map(|o| o.get("calculated").cloned()).collect::<Vec<_>>();
+        app.run("cell.set", json!({"cell": "E1", "input": "1"})).unwrap();
+        assert_eq!(changed(&port.sync(&mut app)), vec![Some(Value::Bool(false))], "an edit leaves the other values the file's");
+        app.run("formulas.calculateNow", json!({})).unwrap();
+        assert_eq!(changed(&port.sync(&mut app)), vec![Some(Value::Bool(true))], "Calculate Now reports itself, even on the same revision");
+        assert_eq!(changed(&port.sync(&mut app)), vec![], "and only once");
+        app.run("cell.set", json!({"cell": "E1", "input": "2"})).unwrap();
+        assert_eq!(changed(&port.sync(&mut app)), vec![Some(Value::Bool(true))], "it stays true");
+
+        let mut app = self::app();
+        let mut port = PortSession::default();
+        open(&mut port, &mut app, "Plan.xlsx", stale_xlsx(), true);
+        app.set_read_only(false);
+        app.run("cell.set", json!({"cell": "E1", "input": "1"})).unwrap();
+        assert_eq!(changed(&port.sync(&mut app)), vec![Some(Value::Bool(true))], "a calculated open is calculated");
+    }
+
+    #[test]
+    fn changes_are_reported_for_the_bound_document_only() {
+        let mut app = app();
+        let mut port = PortSession::default();
+        assert!(port.sync(&mut app).iter().all(|o| o.kind != "changed"), "the startup workbook is not the host's");
+        open(&mut port, &mut app, "Plan.xlsx", stale_xlsx(), false);
+        app.set_read_only(false);
+        app.run("cell.set", json!({"cell": "E1", "input": "1"})).unwrap();
+        let out = port.sync(&mut app);
+        let changed = out.iter().find(|o| o.kind == "changed").unwrap();
+        assert_eq!(changed.get("dirty"), Some(&Value::Bool(true)));
+        assert!(out.iter().any(|o| o.kind == "dirty" && o.get("dirty") == Some(&Value::Bool(true))));
+    }
+}
