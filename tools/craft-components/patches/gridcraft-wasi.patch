+        }
+        o.execute("file.open", p).unwrap();
+        o
+    };
+    for name in ["doc.json", "doc.xlsx"] {
+        let bytes = crate::io::save_bytes(&wb, name).unwrap();
+        for calculate in [None, Some(false)] {
+            let mut o = open(name, &bytes, calculate);
+            let at = format!("{name} calculate {calculate:?}");
+            assert_eq!(v(&o, "A1"), Value::Number(630.0), "{at}");
+            assert_eq!(v(&o, "B1"), Value::Number(1260.0), "{at}");
+            // Opened with its saved values every formula shows the file's value until it is
+            // calculated; calculated, a misspelled function is #NAME? (below, after Calculate Now).
+            let typo = if calculate == Some(false) { Value::Number(5.0) } else { Value::Error(CellError::Name) };
+            assert_eq!(v(&o, "C1"), typo, "{at}: a misspelled function");
+            assert_eq!(v(&o, "D1"), Value::Number(3.0), "{at}");
+            // The reader learns where the value comes from.
+            let got = o.execute("cell.get", json!({"cell": "A1"})).unwrap();
+            assert_eq!(got["heldValue"]["functions"], json!(["RTD"]), "{at}");
+            assert!(o.execute("cell.get", json!({"cell": "B1"})).unwrap().get("heldValue").is_none_or(|h| h.is_null()), "{at}");
+            assert_eq!(o.execute("sheet.read", json!({"range": "A1:D1"})).unwrap()["heldValues"], json!(["A1"]), "{at}");
+            assert!(o.execute("sheet.read", json!({"range": "B1:D1"})).unwrap().get("heldValues").is_none(), "{at}");
+            // Its precedent changes, everything is calculated again: it keeps the value.
+            o.execute("cell.set", json!({"cell": "F1", "input": "9"})).unwrap();
+            o.execute("cell.set", json!({"cell": "E1", "input": "=A1+1"})).unwrap();
+            o.execute("formulas.calculateNow", json!({})).unwrap();
+            assert_eq!(v(&o, "A1"), Value::Number(630.0), "{at}");
+            assert_eq!(v(&o, "E1"), Value::Number(631.0), "{at}");
+            assert_eq!(v(&o, "C1"), Value::Error(CellError::Name), "{at}: a misspelled function, calculated");
+            assert!(o.execute("cell.get", json!({"cell": "C1"})).unwrap().get("heldValue").is_none_or(|h| h.is_null()), "{at}");
+            // Saved and opened again, it still holds.
+            let again = crate::io::save_bytes(&o.doc().unwrap().wb, "doc.json").unwrap();
+            assert_eq!(v(&open("doc.json", &again, None), "A1"), Value::Number(630.0), "{at}");
+            // Edited, it is a formula of this engine.
+            o.execute("cell.set", json!({"cell": "A1", "input": "=RTD(\"quotes\",\"\",$F$2)"})).unwrap();
+            assert_eq!(v(&o, "A1"), Value::Error(CellError::Name), "{at}");
+            assert_eq!(v(&o, "B1"), Value::Error(CellError::Name), "{at}");
+        }
+    }
+}
+
+/// An xlsx whose PivotTable sums a cache field of a source column deleted since the cache's
+/// last refresh, as Excel leaves such a file: only the original parts can keep that field.
+fn stale_pivot_xlsx() -> Vec<u8> {
+    use gridcraft_model::{PivotField, PivotFunc, PivotTable, PivotValue};
+    use std::io::{Read, Write};
+    let mut s = Session::new();
+    s.new_workbook();
+    for (cell, input) in [("A1", "Region"), ("B1", "Sales"), ("A2", "East"), ("B2", "3"), ("A3", "West"), ("B3", "5")] {
+        s.execute("cell.set", json!({"cell": cell, "input": input})).unwrap();
+    }
+    let mut wb = (*s.active().unwrap().wb).clone();
+    std::sync::Arc::make_mut(&mut wb.sheets[0]).pivots.push(PivotTable {
+        source: "Sheet1!$A$1:$B$3".into(),
+        anchor: CellRef::parse("D3").unwrap(),
+        rows: vec![PivotField { source_col: "Region".into(), ..PivotField::default() }],
+        values: vec![PivotValue { source_col: "Sales".into(), func: PivotFunc::Sum, name: "Sum of Sales".into(), ..PivotValue::default() }],
+        ..PivotTable::default()
+    });
+    let bytes = crate::io::save_bytes(&wb, "Plan.xlsx").unwrap();
+    let mut zip = zip::ZipArchive::new(std::io::Cursor::new(bytes)).unwrap();
+    let mut w = zip::ZipWriter::new(std::io::Cursor::new(Vec::new()));
+    for i in 0..zip.len() {
+        let mut f = zip.by_index(i).unwrap();
+        let name = f.name().unwrap().to_string();
+        let mut raw = String::new();
+        f.read_to_string(&mut raw).unwrap();
+        if name.starts_with("xl/pivotCache/pivotCacheDefinition") {
+            raw = raw.replace("</cacheFields>", "<cacheField name=\"Cost\" numFmtId=\"0\"><sharedItems/></cacheField></cacheFields>");
+        }
+        if name.starts_with("xl/pivotTables/pivotTable") {
+            raw = raw.replace("</dataFields>", "<dataField name=\"Sum of Cost\" fld=\"2\" baseField=\"0\" baseItem=\"0\"/></dataFields>");
+        }
+        w.start_file(name.as_str(), zip::write::SimpleFileOptions::default()).unwrap();
+        w.write_all(raw.as_bytes()).unwrap();
+    }
+    w.finish().unwrap().into_inner()
+}
+
+#[test]
+fn save_bytes_with_fidelity_checks_against_the_opened_package() {
+    let mut s = Session::new();
+    let b64 = crate::io::base64_encode(&stale_pivot_xlsx());
+    s.execute("file.open", json!({"name": "Plan.xlsx", "base64": b64, "calculate": false})).unwrap();
+    // Unchanged: the original parts keep everything.
+    let r = s.execute("file.saveBytes", json!({"format": "xlsx", "fidelity": true})).unwrap();
+    assert_eq!(r["parts"], json!([]), "{r}");
+    assert_eq!(r["format"], "xlsx");
+    assert!(r["base64"].as_str().is_some_and(|b| !b.is_empty()));
+    // The PivotTable changed: it is rebuilt and loses the stale field; no file comes back.
+    {
+        let d = s.doc_mut().unwrap();
+        let mut wb = (*d.wb).clone();
+        let pt = &mut std::sync::Arc::make_mut(&mut wb.sheets[0]).pivots[0];
+        pt.grand_totals_rows = !pt.grand_totals_rows;
+        d.wb = std::sync::Arc::new(wb);
+    }
+    let r = s.execute("file.saveBytes", json!({"format": "xlsx", "fidelity": true})).unwrap();
+    assert_eq!(r["parts"], json!([{"code": "pivot_fields", "count": 1}]), "{r}");
+    assert!(r.get("base64").is_none());
+    // Without fidelity the save is as before.
+    assert!(s.execute("file.saveBytes", json!({"format": "xlsx"})).unwrap()["base64"].is_string());
+    // Only workbook packages can be checked.
+    assert!(s.execute("file.saveBytes", json!({"format": "csv", "fidelity": true})).is_err());
+}
