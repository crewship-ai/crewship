+    #[test]
+    fn package_edits_preserve_references_and_prefer_the_current_version() {
+        for (macro_enabled, format) in [(false, "xlsx"), (true, "xlsm")] {
+            let original = package(macro_enabled, false);
+            let (base, _) = crate::read_xlsx(&original).unwrap();
+            let mut agent = base.clone();
+            let a = CellRef::new(0, 0);
+            let b = CellRef::new(0, 1);
+            let c = CellRef::new(0, 2);
+            agent.sheet_mut(0).unwrap().set_value(a, Value::from("agent"));
+            agent.sheet_mut(0).unwrap().set_value(c, Value::from(4.0));
+            let mut formula = agent.sheet(1).unwrap().cells.get(b).unwrap().clone();
+            formula.value = Value::from(12.0);
+            agent.sheet_mut(1).unwrap().set_cell(b, formula);
+            let version2 = write_package_cells(&original, &base, &agent, format).unwrap();
+            let (saved2, _) = crate::read_xlsx(&version2).unwrap();
+            let mut human = saved2.clone();
+            human.sheet_mut(0).unwrap().set_value(b, Value::from("person"));
+            let version3 = write_package_cells(&version2, &saved2, &human, format).unwrap();
+            let (saved3, _) = crate::read_xlsx(&version3).unwrap();
+            let mut undo = saved3.clone();
+            undo.sheet_mut(0).unwrap().set_value(a, Value::from("shared"));
+            undo.sheet_mut(0).unwrap().set_value(c, Value::from(2.0));
+            let mut formula = undo.sheet(1).unwrap().cells.get(b).unwrap().clone();
+            formula.value = Value::from(6.0);
+            undo.sheet_mut(1).unwrap().set_cell(b, formula);
+            let version4 = write_package_cells(&version3, &saved3, &undo, format).unwrap();
+            let (reopened, _) = crate::read_xlsx(&version4).unwrap();
+            let original_parts = entries(&original);
+            for version in [&version2, &version3, &version4] {
+                let parts = entries(version);
+                assert_eq!(parts.len(), original_parts.len());
+                for (name, data) in &original_parts {
+                    if !name.starts_with("xl/worksheets/sheet") {
+                        assert_eq!(&parts[name], data, "{name}");
+                    }
+                }
+                let sheet = std::str::from_utf8(&parts["xl/worksheets/sheet1.xml"]).unwrap();
+                assert!(sheet.contains(r#"<customPr name="Synthetic" r:id="cp-original"/>"#));
+            }
+            assert_eq!(saved2.sheet(0).unwrap().value(b), Value::from("shared"));
+            assert_eq!(saved2.sheet(1).unwrap().value(b), Value::from(12.0));
+            assert_eq!(reopened.sheet(0).unwrap().value(a), Value::from("shared"));
+            assert_eq!(reopened.sheet(0).unwrap().value(b), Value::from("person"));
+            assert_eq!(reopened.sheet(1).unwrap().value(b), Value::from(6.0));
+            assert_eq!(reopened.sheet(1).unwrap().cells.get(b).unwrap().formula.as_ref().unwrap().text, "Data!C1*3");
+        }
+    }
