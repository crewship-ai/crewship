@@ -0,0 +1,989 @@
+//! Replays a short, fixed list of commands from an embedding host on the open workbook, so a
+//! host that already holds the edit (for example a server-side agent) can show its changes
+//! without reloading the whole document.
+
+use std::sync::Arc;
+
+use gridcraft_ui_egui::SheetApp;
+use serde_json::{Value as Json, json};
+
+/// At most this many commands in one request, and this many bytes of JSON.
+pub const MAX_COMMANDS: usize = 64;
+pub const MAX_BYTES: usize = 64 * 1024;
+
+/// The only commands a host may replay: value entry and recalculation. Nothing that touches
+/// files, windows, scripts, links or the clipboard.
+const ALLOWED: &[&str] = &["cell.set", "range.setValues", "formulas.calculateNow"];
+
+#[derive(Debug)]
+pub struct Done {
+    pub document: String,
+    pub applied: usize,
+}
+
+fn parse(commands: &str) -> Result<Vec<(String, Json)>, String> {
+    parse_from(commands, ALLOWED)
+}
+
+fn parse_from(commands: &str, allowed: &[&str]) -> Result<Vec<(String, Json)>, String> {
+    if commands.len() > MAX_BYTES {
+        return Err("The command list is too large.".into());
+    }
+    let list: Vec<Json> = serde_json::from_str(commands).map_err(|_| "Commands must be a JSON array.".to_string())?;
+    if list.is_empty() || list.len() > MAX_COMMANDS {
+        return Err("A request carries 1 to 64 commands.".into());
+    }
+    let mut out = Vec::with_capacity(list.len());
+    for entry in &list {
+        let object = entry.as_object().ok_or_else(|| "Each command must be an object.".to_string())?;
+        let id = object.get("command").and_then(Json::as_str).ok_or_else(|| "Each command needs a command name.".to_string())?;
+        if !allowed.contains(&id) {
+            return Err(format!("The command {id} cannot be replayed by a host."));
+        }
+        let params = match object.get("params") {
+            None | Some(Json::Null) => Json::Object(serde_json::Map::new()),
+            Some(value) if value.is_object() => value.clone(),
+            Some(_) => return Err("Command params must be an object.".into()),
+        };
+        out.push((id.to_string(), params));
+    }
+    Ok(out)
+}
+
+/// Runs the commands in order as ONE undo step. Refused, before anything changes, when a cell
+/// or text-box draft is open (the person's own typing is never interrupted: the host falls back
+/// to opening the whole document) or when the workbook is read-only for any reason other than
+/// the host's own access setting. While the host holds the editor read-only (an agent has the
+/// edit), the host's replay runs and read-only is restored afterwards, also on failure.
+///
+/// With `mark_saved` the result becomes the saved baseline (the host has stored exactly this
+/// state as a version): the document is clean afterwards, and anything the person does next,
+/// Undo included, is an ordinary new change.
+///
+/// A failing command stops the run and is reported with the number applied; the host then
+/// reloads the document.
+pub fn execute(app: &mut SheetApp, commands: &str, host_read_only: bool, mark_saved: bool) -> Result<Done, String> {
+    execute_observed(app, commands, host_read_only, mark_saved, &mut |_, _| {})
+}
+
+/// `execute`, calling `observe` after every command that ran (tests look at the workbook between
+/// commands; the host passes nothing).
+pub fn execute_observed(app: &mut SheetApp, commands: &str, host_read_only: bool, mark_saved: bool, observe: &mut dyn FnMut(&mut SheetApp, usize)) -> Result<Done, String> {
+    let list = parse(commands)?;
+    if app.has_pending_drafts() || app.editor.is_some() || app.text_box_editor.is_some() {
+        return Err("A cell or text box is being edited.".into());
+    }
+    let was_read_only = app.is_read_only();
+    if was_read_only {
+        if !host_read_only {
+            return Err("The workbook is read-only.".into());
+        }
+        app.set_read_only(false);
+        if app.is_read_only() {
+            return Err("The workbook is read-only.".into());
+        }
+    }
+    let result = run_group(app, list, observe);
+    if was_read_only {
+        app.set_read_only(true);
+    }
+    let done = result?;
+    if mark_saved && let Some(doc) = app.session.active_mut() {
+        doc.saved = doc.wb.clone();
+    }
+    Ok(done)
+}
+
+/// The workbook's calculation mode in lower case ("automatic", "manual", "automaticexcepttables"),
+/// read from the model (the `file.options` command is a UI dialog in this app).
+fn calc_mode(app: &SheetApp) -> Option<String> {
+    app.session.active().map(|doc| format!("{:?}", doc.wb.calc.mode).to_lowercase())
+}
+
+/// Runs the commands as one undo step with ONE recalculation of the workbook.
+///
+/// The engine recalculates after every write (about 1.3 s each on a 194 000 cell workbook:
+/// 64 cells took over a minute and froze the page). In any calculation mode but manual the
+/// batch runs in manual calculation (a write then evaluates only the cells it sets) and the
+/// exact original mode is put back at the end, which recalculates the workbook once; it is put
+/// back also when a command fails. A workbook that was in manual calculation stays in it and is
+/// recalculated once at the end. An explicit `formulas.calculateNow` of the list is covered by
+/// that one recalculation. If the mode cannot be put back the call FAILS (the editor would
+/// otherwise stay in manual calculation unnoticed): the host opens the whole version.
+fn run_group(app: &mut SheetApp, list: Vec<(String, Json)>, observe: &mut dyn FnMut(&mut SheetApp, usize)) -> Result<Done, String> {
+    let token = app.session.group_begin("Edit").map_err(|error| error.to_string())?;
+    let mode = calc_mode(app);
+    let defer = matches!(mode.as_deref(), Some(m) if m != "manual");
+    let mut applied = 0usize;
+    let mut failure = None;
+    if defer && let Err(error) = app.run("formulas.calculationOptions", json!({"mode": "manual"})) {
+        failure = Some(error);
+    }
+    if failure.is_none() {
+        for (id, params) in list {
+            if defer && id == "formulas.calculateNow" {
+                applied += 1; // the final recalculation does it
+                continue;
+            }
+            match app.run(&id, params) {
+                Ok(_) => applied += 1,
+                Err(error) => {
+                    failure = Some(error);
+                    break;
+                }
+            }
+            observe(app, applied);
+        }
+    }
+    let restored = restore_calculation(app, mode.as_deref(), defer);
+    let ended = app.session.group_end(token).map_err(|error| error.to_string());
+    if let Some(error) = failure {
+        return Err(format!("{error} ({applied} applied)"));
+    }
+    if let Err(error) = restored {
+        return Err(format!("The calculation mode could not be put back ({error}); reopen the document."));
+    }
+    ended?;
+    let doc = app.session.active().ok_or_else(|| "No workbook is open.".to_string())?;
+    Ok(Done { document: doc.uid.to_string(), applied })
+}
+
+/// Puts the exact calculation mode back and recalculates once.
+fn restore_calculation(app: &mut SheetApp, mode: Option<&str>, deferred: bool) -> Result<(), String> {
+    #[cfg(test)]
+    if tests::FAIL_RESTORE.with(|flag| flag.get()) {
+        return Err("refused".into());
+    }
+    if !deferred {
+        return app.run("formulas.calculateNow", json!({})).map(|_| ());
+    }
+    match mode {
+        Some("automatic") => app.run("formulas.calculationOptions", json!({"mode": "automatic"})).map(|_| ()),
+        Some("automaticexcepttables") => {
+            app.run("formulas.calculationOptions", json!({"mode": "automaticExceptTables"}))?;
+            app.run("formulas.calculateNow", json!({})).map(|_| ())
+        }
+        _ => Err("an unknown calculation mode".into()),
+    }
+}
+
+/// The commands a host may replay over the person's own edits (`keep: "human"`): resolved
+/// content writes, nothing structural. A log of agent edits holds exactly these names and
+/// params, each address with its sheet (`'Data'!B8:B577`, no `sheet` param); anything else is
+/// `not_replayable`.
+pub const REPLAYABLE: &[&str] = &["cell.set", "range.setValues", "edit.clearContents", "formulas.calculateNow"];
+
+/// At most this many conflicts are reported, each value cut to this many characters.
+pub const MAX_CONFLICTS: usize = 200;
+pub const MAX_CONFLICT_CHARS: usize = 256;
+
+/// A cell the person changed since the saved version and the replay wrote: the person's
+/// content stays. `agent` and `kept` are the cells' contents as the formula bar shows them.
+/// They are cell content: for the host's card only, never for a server log or audit.
+#[derive(Debug, Clone, PartialEq)]
+pub struct Conflict {
+    pub sheet: String,
+    pub cell: String,
+    pub agent: String,
+    pub kept: String,
+}
+
+#[derive(Debug)]
+pub struct Kept {
+    pub document: String,
+    pub applied: usize,
+    pub conflicts: Vec<Conflict>,
+    pub truncated: bool,
+    /// With `rebase_saved`, the saved version became the host's version (the saved version with
+    /// the commands applied), and the person's own edits stay unsaved on top of it.
+    pub rebased: bool,
+}
+
+/// A refused replay: `code` is `not_replayable` or `None` for the usual codes of the text.
+#[derive(Debug)]
+pub struct Refused {
+    pub code: Option<&'static str>,
+    pub error: String,
+}
+
+impl Refused {
+    fn not_replayable(error: impl Into<String>) -> Refused {
+        Refused { code: Some("not_replayable"), error: error.into() }
+    }
+    fn plain(error: impl Into<String>) -> Refused {
+        Refused { code: None, error: error.into() }
+    }
+}
+
+/// The sheet an address names (`'Q1 Data'!B2`, `Data!B2:C4`), and the rest.
+fn address_sheet(at: &str) -> Option<(String, &str)> {
+    let (sheet, rest) = at.rsplit_once('!')?;
+    let sheet = match sheet.strip_prefix('\'').and_then(|s| s.strip_suffix('\'')) {
+        Some(quoted) => quoted.replace("''", "'"),
+        None if !sheet.contains('\'') => sheet.to_string(),
+        None => return None,
+    };
+    (!sheet.is_empty() && !rest.is_empty()).then_some((sheet, rest))
+}
+
+/// A replayable command: from [`REPLAYABLE`] with only its own params, its address naming an
+/// existing sheet.
+fn replayable(list: &[(String, Json)], wb: &gridcraft_engine::model::Workbook) -> Result<(), Refused> {
+    for (id, params) in list {
+        let (target, keys): (&str, &[&str]) = match id.as_str() {
+            "cell.set" => ("cell", &["cell", "input"]),
+            "range.setValues" => ("range", &["range", "values"]),
+            "edit.clearContents" => ("range", &["range"]),
+            "formulas.calculateNow" => ("", &[]),
+            _ => return Err(Refused::not_replayable(format!("The command {id} cannot be replayed over the person's edits."))),
+        };
+        let own = params.as_object().is_some_and(|o| o.keys().all(|k| keys.contains(&k.as_str())) && keys.iter().all(|k| o.contains_key(*k)));
+        if !own {
+            return Err(Refused::not_replayable(format!("{id} takes exactly {{{}}}.", keys.join(", "))));
+        }
+        if target.is_empty() {
+            continue;
+        }
+        let named = params.get(target).and_then(Json::as_str).and_then(address_sheet).is_some_and(|(sheet, _)| wb.sheet_index(&sheet).is_some());
+        if !named {
+            return Err(Refused::not_replayable(format!("{id}: {target} must name an existing sheet ('Sheet'!A1).")));
+        }
+    }
+    Ok(())
+}
+
+/// The same content: formula (with its array range), else value. A stored empty cell is no cell.
+fn same_content(a: Option<&gridcraft_engine::model::Cell>, b: Option<&gridcraft_engine::model::Cell>) -> bool {
+    use gridcraft_engine::core::Value;
+    fn formula(c: Option<&gridcraft_engine::model::Cell>) -> Option<(&str, Option<gridcraft_engine::core::RangeRef>)> {
+        c.and_then(|c| c.formula.as_ref()).map(|f| (f.text.as_str(), f.array))
+    }
+    fn value(c: Option<&gridcraft_engine::model::Cell>) -> &Value {
+        const EMPTY: &Value = &Value::Empty;
+        c.filter(|c| c.formula.is_none()).map_or(EMPTY, |c| &c.value)
+    }
+    formula(a) == formula(b) && (formula(a).is_some() || value(a) == value(b))
+}
+
+/// At most this many rectangles in a save's `touched`; more is `unknown`.
+pub const MAX_TOUCHED: usize = 2000;
+/// At most this many bytes of `touched` as JSON; more is `unknown`.
+pub const MAX_TOUCHED_BYTES: usize = 64 << 10;
+
+/// The cells whose content differs between the workbook and its saved version, by the rule
+/// [`same_content`] (a formula's text, a constant's raw typed value: "001" is not 1; a formula's
+/// recalculated value is not a change), as sheet-qualified rectangles `'Sheet'!A1:B3`. Addresses
+/// only, never content. `None` (`unknown`) when they can't be named by address: a structural
+/// change since the saved version (sheets, rows, columns), or more than the limits.
+pub fn touched(wb: &gridcraft_engine::model::Workbook, saved: &gridcraft_engine::model::Workbook) -> Option<Vec<String>> {
+    use gridcraft_engine::core::{CellRef, RangeRef};
+    let names = |wb: &gridcraft_engine::model::Workbook| wb.sheets.iter().map(|sh| sh.name.clone()).collect::<Vec<_>>();
+    if !wb.structure.same(saved.structure) || names(wb) != names(saved) {
+        return None;
+    }
+    let mut out = Vec::new();
+    let mut bytes = 2usize;
+    for (now, then) in wb.sheets.iter().zip(&saved.sheets) {
+        if Arc::ptr_eq(now, then) {
+            continue;
+        }
+        let mut cells: Vec<CellRef> = now
+            .cells
+            .iter()
+            .filter(|(c, cell)| !same_content(Some(cell), then.cell(*c)))
+            .map(|(c, _)| c)
+            .chain(then.cells.iter().filter(|(c, cell)| now.cell(*c).is_none() && !same_content(None, Some(cell))).map(|(c, _)| c))
+            .collect();
+        cells.sort_unstable_by_key(|c| (c.col, c.row));
+        cells.dedup();
+        // Runs down each column, then runs of columns with the same rows.
+        let mut runs: Vec<(u32, u32, u32)> = Vec::new();
+        for c in cells {
+            match runs.last_mut() {
+                Some((col, _, r1)) if *col == c.col && *r1 + 1 == c.row => *r1 = c.row,
+                _ => runs.push((c.col, c.row, c.row)),
+            }
+        }
+        runs.sort_unstable_by_key(|&(col, r0, r1)| (r0, r1, col));
+        let mut rects: Vec<(u32, u32, u32, u32)> = Vec::new();
+        for (col, r0, r1) in runs {
+            match rects.last_mut() {
+                Some((_, c1, a, b)) if *a == r0 && *b == r1 && *c1 + 1 == col => *c1 = col,
+                _ => rects.push((col, col, r0, r1)),
+            }
+        }
+        let sheet = format!("'{}'!", now.name.replace('\'', "''"));
+        for (c0, c1, r0, r1) in rects {
+            let (a, b) = (CellRef::new(r0, c0), CellRef::new(r1, c1));
+            let at = if a == b { a.a1() } else { RangeRef::new(a, b).a1() };
+            let text = format!("{sheet}{at}");
+            bytes += text.len() + 3 + text.matches(['"', '\\']).count();
+            out.push(text);
+            if out.len() > MAX_TOUCHED || bytes > MAX_TOUCHED_BYTES {
+                return None;
+            }
+        }
+    }
+    Some(out)
+}
+
+fn clipped(text: String) -> String {
+    if text.chars().count() <= MAX_CONFLICT_CHARS {
+        return text;
+    }
+    let mut cut: String = text.chars().take(MAX_CONFLICT_CHARS - 1).collect();
+    cut.push('…');
+    cut
+}
+
+/// Runs the commands over the person's own edits as ONE undo step called `label` (`keep:
+/// "human"`): where the person changed a cell since the saved version and the replay writes it,
+/// the person's cell stays and is reported as a conflict. The saved version is the base the
+/// commands were made on.
+///
+/// Refused, with nothing changed (workbook, undo history, dirty), as `not_replayable` when a
+/// command is not in [`REPLAYABLE`] or doesn't name its sheet and target, or when the structure
+/// changed since the saved version (sheets, rows, columns, sort, filter: there's no moving the
+/// commands' addresses yet). A failing command rolls the whole replay back.
+///
+/// With `rebase_saved` the host has stored its version (the saved version with these commands
+/// applied): that becomes the saved version, so the person's edits stay unsaved on top of it and
+/// the host's next version builds on it. It is made by running the same commands over a copy of
+/// the saved version first; if that fails, nothing changes.
+pub fn execute_keeping_human(app: &mut SheetApp, commands: &str, host_read_only: bool, label: &str, rebase_saved: bool) -> Result<Kept, Refused> {
+    let list = parse_from(commands, REPLAYABLE).map_err(|error| {
+        if error.contains("cannot be replayed") { Refused::not_replayable(error) } else { Refused::plain(error) }
+    })?;
+    if app.has_pending_drafts() || app.editor.is_some() || app.text_box_editor.is_some() {
+        return Err(Refused::plain("A cell or text box is being edited."));
+    }
+    let Some(doc) = app.session.active() else { return Err(Refused::plain("No workbook is open.")) };
+    let (human, base) = (doc.wb.clone(), doc.saved.clone());
+    replayable(&list, &human)?;
+    let names = |wb: &gridcraft_engine::model::Workbook| wb.sheets.iter().map(|sh| sh.name.clone()).collect::<Vec<_>>();
+    if !human.structure.same(base.structure) || names(&human) != names(&base) {
+        return Err(Refused::not_replayable("The structure changed since the saved version."));
+    }
+    let was_read_only = app.is_read_only();
+    if was_read_only {
+        if !host_read_only {
+            return Err(Refused::plain("The workbook is read-only."));
+        }
+        app.set_read_only(false);
+        if app.is_read_only() {
+            return Err(Refused::plain("The workbook is read-only."));
+        }
+    }
+    // The cells the commands write, known before anything runs: a version of the host's that
+    // can't be told by address is refused as a whole.
+    let targets = if rebase_saved {
+        match written(&list, &human) {
+            Some(t) => Some(t),
+            None => {
+                if was_read_only {
+                    app.set_read_only(true);
+                }
+                return Err(Refused::not_replayable("A written range can't be named."));
+            }
+        }
+    } else {
+        None
+    };
+    let mut replayed = None;
+    let mut result = replay_keeping(app, list, label, &human, &base, &mut replayed);
+    if let (Ok(done), Some(targets), Some(replayed)) = (result.as_mut(), targets, replayed)
+        && let Some(doc) = app.session.active_mut()
+    {
+        let mut wb = hosts_version(&base, &replayed, &targets);
+        // The same structure as the person's (see `replay_keeping`).
+        wb.structure = doc.wb.structure;
+        doc.saved = Arc::new(wb);
+        done.rebased = true;
+    }
+    if was_read_only {
+        app.set_read_only(true);
+    }
+    result
+}
+
+/// The cells each replayable command writes, as (sheet index, rectangle): `cell.set` its cell,
+/// `range.setValues` the values' own size from the range's first cell, `edit.clearContents`
+/// its range. `None` if an address can't be read.
+fn written(list: &[(String, Json)], wb: &gridcraft_engine::model::Workbook) -> Option<Vec<(usize, gridcraft_engine::core::RangeRef)>> {
+    use gridcraft_engine::core::{CellRef, RangeRef};
+    let mut out = Vec::new();
+    for (id, params) in list {
+        let key = match id.as_str() {
+            "cell.set" => "cell",
+            "range.setValues" => "range",
+            "edit.clearContents" => "range",
+            _ => continue,
+        };
+        let (sheet, at) = address_sheet(params.get(key)?.as_str()?)?;
+        let si = wb.sheets.iter().position(|sh| sh.name == sheet)?;
+        let range = RangeRef::parse(at).or_else(|| CellRef::parse(at).map(|c| RangeRef::new(c, c)))?;
+        let range = match id.as_str() {
+            "cell.set" if range.start != range.end => return None,
+            "range.setValues" => {
+                let rows = params.get("values")?.as_array()?;
+                let width = rows.iter().map(|r| r.as_array().map_or(1, Vec::len)).max().unwrap_or(0);
+                if rows.is_empty() || width == 0 {
+                    continue;
+                }
+                let end = CellRef::new(range.start.row.checked_add(rows.len() as u32 - 1)?, range.start.col.checked_add(width as u32 - 1)?);
+                RangeRef::new(range.start, end)
+            }
+            _ => range,
+        };
+        out.push((si, range));
+    }
+    Some(out)
+}
+
+/// The saved version `base` with the host's commands applied: the cells they wrote, as the
+/// replay wrote them (`replayed`, before the person's cells were put back). These commands
+/// write fixed inputs, so a written cell is the same over any workbook. Values of formulas
+/// elsewhere are not recalculated: the saved version is compared by content only (dirty,
+/// conflicts, touched).
+fn hosts_version(
+    base: &gridcraft_engine::model::Workbook,
+    replayed: &gridcraft_engine::model::Workbook,
+    targets: &[(usize, gridcraft_engine::core::RangeRef)],
+) -> gridcraft_engine::model::Workbook {
+    let mut wb = base.clone();
+    for &(si, range) in targets {
+        let (Some(from), Some(sheet)) = (replayed.sheets.get(si), wb.sheets.get_mut(si)) else { continue };
+        let sheet = Arc::make_mut(sheet);
+        let old: Vec<_> = sheet.cells.iter().map(|(c, _)| c).filter(|c| range.contains(*c)).collect();
+        for c in old {
+            sheet.remove_cell(c);
+        }
+        for (c, cell) in from.cells.iter().filter(|(c, _)| range.contains(*c)) {
+            sheet.cells.set(c, cell.clone());
+        }
+    }
+    wb
+}
+
+fn replay_keeping(
+    app: &mut SheetApp,
+    list: Vec<(String, Json)>,
+    label: &str,
+    human: &Arc<gridcraft_engine::model::Workbook>,
+    base: &Arc<gridcraft_engine::model::Workbook>,
+    replayed: &mut Option<Arc<gridcraft_engine::model::Workbook>>,
+) -> Result<Kept, Refused> {
+    let token = app.session.group_begin(label).map_err(|error| Refused::plain(error.to_string()))?;
+    let mode = calc_mode(app);
+    let defer = matches!(mode.as_deref(), Some(m) if m != "manual");
+    let mut applied = 0usize;
+    let mut failure = None;
+    if defer && let Err(error) = app.run("formulas.calculationOptions", json!({"mode": "manual"})) {
+        failure = Some(error);
+    }
+    if failure.is_none() {
+        for (id, params) in list {
+            if defer && id == "formulas.calculateNow" {
+                applied += 1;
+                continue;
+            }
+            match app.run(&id, params) {
+                Ok(_) => applied += 1,
+                Err(error) => {
+                    failure = Some(error);
+                    break;
+                }
+            }
+        }
+    }
+    let mut conflicts = Vec::new();
+    let mut truncated = false;
+    if failure.is_none() {
+        *replayed = app.session.active().map(|doc| doc.wb.clone());
+        let (found, more) = keep_human_cells(app, human, base);
+        conflicts = found;
+        truncated = more;
+    }
+    let restored = restore_calculation(app, mode.as_deref(), defer);
+    let failure = failure.or_else(|| restored.err().map(|error| format!("The calculation mode could not be put back ({error})")));
+    if let Some(error) = failure {
+        // Atomic: the workbook, its undo history and selection go back to where they were.
+        let _ = app.session.group_rollback(token);
+        return Err(Refused::plain(format!("{error} ({applied} applied, rolled back)")));
+    }
+    // Only replayable commands ran, none structural, but switching the calculation mode renews
+    // the structural id: keep the person's, so a structural edit of theirs still shows against
+    // the saved version on the next replay.
+    if let Some(doc) = app.session.active_mut() {
+        Arc::make_mut(&mut doc.wb).structure = human.structure;
+    }
+    app.session.group_end(token).map_err(|error| Refused::plain(error.to_string()))?;
+    let doc = app.session.active().ok_or_else(|| Refused::plain("No workbook is open."))?;
+    Ok(Kept { document: doc.uid.to_string(), applied, conflicts, truncated, rebased: false })
+}
+
+/// Puts back every cell the person changed since `base` that the replay wrote over, from
+/// `human` (the workbook before the replay), and returns those cells as conflicts, in sheet and
+/// row order, at most [`MAX_CONFLICTS`] (and whether there were more).
+fn keep_human_cells(app: &mut SheetApp, human: &gridcraft_engine::model::Workbook, base: &gridcraft_engine::model::Workbook) -> (Vec<Conflict>, bool) {
+    use gridcraft_engine::core::CellRef;
+    let Some(doc) = app.session.active_mut() else { return (Vec::new(), false) };
+    let mut keys: Vec<(usize, CellRef)> = Vec::new();
+    for (si, (after, before)) in doc.wb.sheets.iter().zip(&human.sheets).enumerate() {
+        let Some(at_base) = base.sheets.get(si) else { continue };
+        let written = after
+            .cells
+            .iter()
+            .filter(|(c, cell)| !same_content(Some(cell), before.cell(*c)))
+            .map(|(c, _)| c)
+            .chain(before.cells.iter().filter(|(c, cell)| after.cell(*c).is_none() && !same_content(None, Some(cell))).map(|(c, _)| c));
+        keys.extend(written.filter(|c| !same_content(before.cell(*c), at_base.cell(*c))).map(|c| (si, c)));
+    }
+    keys.sort_unstable_by_key(|(si, c)| (*si, c.row, c.col));
+    keys.dedup();
+    if keys.is_empty() {
+        return (Vec::new(), false);
+    }
+    let truncated = keys.len() > MAX_CONFLICTS;
+    let conflicts = keys
+        .iter()
+        .take(MAX_CONFLICTS)
+        .filter_map(|&(si, c)| {
+            let (after, before) = (doc.wb.sheet(si)?, human.sheet(si)?);
+            Some(Conflict {
+                sheet: before.name.clone(),
+                cell: c.a1(),
+                agent: clipped(gridcraft_engine::display::edit_text(&doc.wb, after, c)),
+                kept: clipped(gridcraft_engine::display::edit_text(human, before, c)),
+            })
+        })
+        .collect();
+    let wb = std::sync::Arc::make_mut(&mut doc.wb);
+    for &(si, c) in &keys {
+        let kept = human.sheet(si).and_then(|sh| sh.cell(c)).cloned();
+        if let Some(sheet) = wb.sheet_mut(si) {
+            match kept {
+                Some(cell) => sheet.cells.set(c, cell),
+                None => {
+                    sheet.remove_cell(c);
+                }
+            }
+        }
+    }
+    doc.calc.cells_changed(wb, &keys);
+    (conflicts, truncated)
+}
