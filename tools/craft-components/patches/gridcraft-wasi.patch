+fn refreshing_caches(bytes: &[u8]) -> usize {
+    unzip(bytes).iter().filter(|(n, x)| n.starts_with("xl/pivotCache/pivotCacheDefinition") && String::from_utf8_lossy(x).contains("refreshOnLoad=\"1\"")).count()
+}
