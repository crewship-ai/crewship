+/// Runs a subcommand that may refuse a lossy save: exit 3 then, 1 on other errors.
+fn convert_main_with(f: fn(&[String]) -> Result<(), String>, args: &[String]) -> ExitCode {
+    match f(args) {
+        Ok(()) => ExitCode::SUCCESS,
+        Err(e) if e == FIDELITY_LOSS => ExitCode::from(3),
+        Err(e) => {
+            eprintln!("gridcraft-cli: {e}");
+            ExitCode::FAILURE
+        }
+    }
