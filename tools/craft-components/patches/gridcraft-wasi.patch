+//! The editor's side of mooring protocol 2 on the private port, apart from JavaScript: what
+//! each host message does to the app and what the editor answers. `port_host` only moves these
+//! messages across the `MessagePort`.
+//!
+//! The workbook file (xlsx or xlsm) is the document: the host opens it once per port, and every
+//! save hands back the complete file at a revision. Only the host's acknowledgement of that
+//! exact save makes it the saved baseline.
+
+use std::collections::VecDeque;
+use std::sync::Arc;
+
+#[cfg(test)]
+use gridcraft_engine::model::Workbook;
+use gridcraft_ui_egui::SheetApp;
+
+use crate::port_protocol::{self, Inbound, MAX_ERROR_CHARS, MAX_OPEN_BYTES, Saves};
+
+/// Host requests waiting for the next frame, at most this many.
+const MAX_QUEUED: usize = 8;
+
+/// A value in an outgoing message.
+#[derive(Clone, Debug, PartialEq)]
+pub enum Value {
+    Str(String),
+    Bool(bool),
+    Num(f64),
+    Bytes(Vec<u8>),
+    /// `[{code, count}]`: an open's warnings, a refused save's lost parts.
+    Warnings(Vec<(&'static str, u64)>),
+    /// `[{sheet, cell, agent, kept}]`: a replay's conflicts (cell content: for the host's card).
+    Conflicts(Vec<crate::native_execute::Conflict>),
+    /// `["'Sheet'!A1:B3", …]`: addresses only, never content.
+    Addresses(Vec<String>),
+}
+
+/// One message to the host: `gridcraft:<kind>` with these fields.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Out {
+    pub kind: &'static str,
+    pub fields: Vec<(&'static str, Value)>,
+}
+
+impl Out {
+    fn new(kind: &'static str, fields: Vec<(&'static str, Value)>) -> Self {
+        Self { kind, fields }
+    }
+
+    fn error(kind: &'static str, request_id: &str, code: &str, error: &str) -> Self {
+        Self::new(kind, vec![("requestId", s(request_id)), ("code", s(code)), ("error", s(&port_protocol::clip(error, MAX_ERROR_CHARS)))])
+    }
+
+    #[cfg(test)]
+    pub fn get(&self, key: &str) -> Option<&Value> {
+        self.fields.iter().find(|(k, _)| *k == key).map(|(_, v)| v)
+    }
+}
+
+/// `<version>+<commit:12> patch <sha256>` of a pinned build (the package build passes the pinned
+/// source commit and the SHA-256 of its patch), the engine's `--version` without its name: the
+/// host compares it with the server's engine before it replays a version over the person's work.
+/// `None` for any other build, or a malformed pin.
+fn build_identity(commit: Option<&str>, patch: Option<&str>) -> Option<String> {
+    let hex = |s: &str, n: usize| s.len() == n && s.bytes().all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b));
+    match (commit, patch) {
+        (Some(c), Some(p)) if hex(c, 40) && hex(p, 64) => Some(format!("{}+{} patch {p}", env!("CARGO_PKG_VERSION"), &c[..12])),
+        _ => None,
+    }
+}
+
+fn s(v: &str) -> Value {
+    Value::Str(v.to_string())
+}
+
+enum Queued {
+    Open { request_id: String, name: String, bytes: Vec<u8>, calculate: bool, auto_fit: bool },
+    Save { request_id: String, announce: bool },
+    Ack { request_id: String, document: String, revision: String },
+    Failed { request_id: String },
+    Execute { request_id: String, commands: String, saved: bool, base_revision: Option<String>, keep_human: Option<String> },
+}
+
+/// The workbook the host opened on this port.
+struct Bound {
+    document: u64,
+    name: String,
+    format: &'static str,
+    /// Failed reconstruction of a host publication requires a fresh open.
+    needs_reload: bool,
+    /// A host retry of the same refused revision gets the same answer.
+    refused: Option<Refused>,
+    /// Every value is the editor's own: the workbook opened calculated, or every formula was
+    /// evaluated since. Once true, it stays true.
+    calculated: bool,
+    /// The engine's count of full recalculations once opened.
+    recalcs_at_open: u64,
+    /// The revision the saved version is: the one opened, acknowledged or marked saved last. A
+    /// `keep: "human"` replay names it as its base.
+    saved_revision: String,
+}
+
+struct HeldSave {
+    from: Arc<[u8]>,
+    package: gridcraft_engine::WorkbookPackage,
+}
+
+#[derive(Default)]
+pub struct PortSession {
+    pub access: crate::host_access::AccessState,
+    pub held: crate::held_input::HeldInput,
+    revisions: crate::draft_state::Revisions,
+    saves: Saves<HeldSave>,
+    queue: VecDeque<Queued>,
+    /// An open was taken on this port (one per port).
+    opening: bool,
+    bound: Option<Bound>,
+    editor_saves: u64,
+    reported_dirty: Option<bool>,
+    reported_revision: Option<(u64, u64)>,
+}
+
+impl PortSession {
+    pub fn ready(&self) -> Out {
+        let mut fields =
+            vec![("version", s(env!("CARGO_PKG_VERSION"))), ("accessProtocol", Value::Num(1.0)), ("readOnly", Value::Bool(self.access.read_only()))];
+        if let Some(build) = build_identity(option_env!("CRAFT_SOURCE_COMMIT"), option_env!("CRAFT_PATCH_SHA256")) {
+            fields.push(("build", s(&build)));
+        }
+        Out::new("ready", fields)
+    }
+
+    /// A parsed host message. `bytes` copies an open's workbook out of JavaScript; it is called
+    /// only once its size is allowed. Answers that need no frame come back at once.
+    pub fn receive(&mut self, message: Inbound, bytes: impl FnOnce() -> Vec<u8>) -> Vec<Out> {
+        let full = self.queue.len() >= MAX_QUEUED;
+        match message {
+            Inbound::Open { request_id, name, bytes: size, calculate, auto_fit } => {
+                if self.opening || full {
+                    return vec![Out::error("opened", &request_id, "open_failed", "One workbook opens per port.")];
+                }
+                if port_protocol::workbook_format(&name).is_none() {
+                    return vec![Out::error("opened", &request_id, "open_unsupported", "The editor opens .xlsx and .xlsm workbooks.")];
+                }
+                if size > MAX_OPEN_BYTES {
+                    return vec![Out::error("opened", &request_id, "open_too_large", "The workbook is over the editor's open limit.")];
+                }
+                self.opening = true;
+                self.queue.push_back(Queued::Open { request_id, name, bytes: bytes(), calculate, auto_fit });
+            }
+            Inbound::SetAccess { request_id, read_only } => {
+                if let Err(error) = self.access.request(request_id.clone(), read_only) {
+                    return vec![Out::error("access", &request_id, "busy", &error)];
+                }
+            }
+            Inbound::SaveRequest { request_id } => {
+                if full {
+                    return vec![Out::error("save", &request_id, "busy", "The request queue is full.")];
+                }
+                self.queue.push_back(Queued::Save { request_id, announce: false });
+            }
+            Inbound::SaveAck { request_id, document, revision, .. } if !full => self.queue.push_back(Queued::Ack { request_id, document, revision }),
+            Inbound::SaveFailed { request_id, .. } if !full => self.queue.push_back(Queued::Failed { request_id }),
+            Inbound::SaveAck { .. } | Inbound::SaveFailed { .. } => log::warn!("host save answer dropped: the request queue is full"),
+            Inbound::Execute { request_id, commands, saved, base_revision, keep_human } => {
+                if full {
+                    return vec![Out::error("executed", &request_id, "busy", "The request queue is full.")];
+                }
+                if commands.is_empty() || commands.len() > crate::native_execute::MAX_BYTES {
+                    return vec![Out::error("executed", &request_id, "invalid", "Commands must be a JSON string of at most 64 KiB.")];
+                }
+                self.queue.push_back(Queued::Execute { request_id, commands, saved, base_revision, keep_human });
+            }
+        }
+        Vec::new()
+    }
+
+    /// The user's Save (Ctrl+S, File › Save): the editor starts a save with its own id.
+    pub fn request_editor_save(&mut self) -> Result<(), String> {
+        if self.queue.len() >= MAX_QUEUED {
+            return Err("The request queue is full.".into());
+        }
+        self.editor_saves = self.editor_saves.wrapping_add(1);
+        self.queue.push_back(Queued::Save { request_id: format!("editor-{}", self.editor_saves), announce: true });
+        Ok(())
+    }
+
+    /// Applies a pending access change before the frame's input, logic and UI.
+    pub fn apply_access(&mut self, app: &mut SheetApp, now: f64) -> (Vec<Out>, bool) {
+        let Some(request) = self.access.take() else { return (Vec::new(), false) };
+        let mut out = notices(&self.held.before_access(app, now));
+        app.set_read_only(request.read_only);
+        let reply = self.access.applied(request, app.is_read_only());
+        out.push(Out::new("access", vec![("requestId", s(&reply.request_id)), ("readOnly", Value::Bool(reply.read_only))]));
+        // After the reply: the host knows the access before anything the replay changes.
+        out.extend(notices(&self.held.after_access(app)));
+        (out, true)
+    }
+
+    /// After each frame: runs the queued requests and reports changes.
+    pub fn sync(&mut self, app: &mut SheetApp) -> Vec<Out> {
+        self.revisions.observe(app);
+        let mut out = Vec::new();
+        while let Some(request) = self.queue.pop_front() {
+            match request {
+                Queued::Open { request_id, name, bytes, calculate, auto_fit } => {
+                    out.push(self.open(app, &request_id, &name, &bytes, calculate, auto_fit))
+                }
+                Queued::Save { request_id, announce } => out.extend(self.save(app, &request_id, announce)),
+                Queued::Ack { request_id, document, revision } => {
+                    if let Some(save) = self.saves.acknowledge(&request_id, &document, &revision)
+                        && let Some(doc) = app.session.active_mut()
+                        && doc.uid.to_string() == document
+                        && let Some(bound) = self.bound.as_mut()
+                    {
+                        if doc.package_base.as_ref().is_some_and(|base| Arc::ptr_eq(&base.bytes, &save.from)) {
+                            doc.saved = save.package.model.clone();
+                            doc.package_base = Some(save.package);
+                            bound.saved_revision = revision;
+                        } else {
+                            bound.needs_reload = true;
+                        }
+                    }
+                }
+                Queued::Failed { request_id } => {
+                    self.saves.failed(&request_id);
+                }
+                Queued::Execute { request_id, commands, saved, base_revision, keep_human: None } => {
+                    out.push(self.execute(app, &request_id, &commands, saved, base_revision));
+                }
+                Queued::Execute { request_id, commands, saved, base_revision, keep_human: Some(label) } => {
+                    out.push(self.execute_keeping_human(app, &request_id, &commands, saved, base_revision, &label));
+                }
+            }
+        }
+        self.revisions.observe(app);
+        let dirty = crate::draft_state::dirty(app);
+        if self.reported_dirty != Some(dirty) {
+            out.push(Out::new("dirty", vec![("dirty", Value::Bool(dirty))]));
+            self.reported_dirty = Some(dirty);
+        }
+        let revision = app.session.active().map(|doc| (doc.uid, self.revisions.sequence()));
+        // A full recalculation of the bound workbook makes every value the editor's own.
+        let newly_calculated = match (self.bound.as_mut(), app.session.active()) {
+            (Some(b), Some(doc)) if !b.calculated && doc.uid == b.document && doc.calc.full_recalcs > b.recalcs_at_open => {
+                b.calculated = true;
+                true
+            }
+            _ => false,
+        };
+        let calculated = self.bound.as_ref().is_some_and(|b| b.calculated);
+        if revision != self.reported_revision || newly_calculated {
+            match revision {
+                Some((document, revision)) if self.bound.is_some() => out.push(Out::new(
+                    "changed",
+                    vec![
+                        ("document", s(&document.to_string())),
+                        ("revision", s(&revision.to_string())),
+                        ("dirty", Value::Bool(dirty)),
+                        ("calculated", Value::Bool(calculated)),
+                    ],
+                )),
+                None if self.bound.is_some() => out.push(Out::new("closed", Vec::new())),
+                _ => {}
+            }
+            self.reported_revision = revision;
+        }
+        out
+    }
+
+    fn open(&mut self, app: &mut SheetApp, request_id: &str, name: &str, bytes: &[u8], calculate: bool, auto_fit: bool) -> Out {
+        let Some(format) = port_protocol::workbook_format(name) else {
+            return Out::error("opened", request_id, "open_unsupported", "The editor opens .xlsx and .xlsm workbooks.");
+        };
+        if !port_protocol::is_workbook_package(bytes) {
+            return Out::error("opened", request_id, "open_corrupt", "The bytes are not a workbook package.");
+        }
+        let result = match app.import_host_bytes_with(name, bytes, calculate, auto_fit) {
+            Ok(result) => result,
+            Err(error) => return Out::error("opened", request_id, port_protocol::open_error_code(&error), &error),
+        };
+        let Some(doc) = app.session.active() else {
+            return Out::error("opened", request_id, "open_failed", "The engine did not open a workbook.");
+        };
+        let mut warnings = Vec::new();
+        if doc.wb.vba_project.is_some() {
+            warnings.push(("vba_preserved", 1));
+        }
+        let held =
+            doc.wb.sheets.iter().flat_map(|sheet| sheet.cells.iter()).filter(|(_, c)| c.formula.as_ref().is_some_and(|f| f.document_value)).count();
+        if held > 0 {
+            warnings.push(("unsupported_function_held", held as u64));
+        }
+        let texts = result.get("warnings").and_then(serde_json::Value::as_array).cloned().unwrap_or_default();
+        for code in texts.iter().filter_map(serde_json::Value::as_str).filter_map(port_protocol::warning_code) {
+            match warnings.iter_mut().find(|(c, _)| *c == code) {
+                Some((_, count)) => *count += 1,
+                None => warnings.push((code, 1)),
+            }
+        }
+        let document = doc.uid;
+        if doc.package_base.is_none() {
+            return Out::error("opened", request_id, "open_corrupt", "The original workbook package is unavailable.");
+        }
+        let recalcs_at_open = doc.calc.full_recalcs;
+        self.revisions.observe(app);
+        self.bound = Some(Bound {
+            document,
+            name: name.to_string(),
+            format,
+            needs_reload: false,
+            refused: None,
+            calculated: calculate,
+            recalcs_at_open,
+            saved_revision: self.revisions.revision(),
+        });
+        Out::new(
+            "opened",
+            vec![
+                ("requestId", s(request_id)),
+                ("document", s(&document.to_string())),
+                ("revision", s(&self.revisions.revision())),
+                ("format", s(format)),
+                ("calculated", Value::Bool(calculate)),
+                ("warnings", Value::Warnings(warnings)),
+            ],
+        )
+    }
+
+    fn save(&mut self, app: &mut SheetApp, request_id: &str, announce: bool) -> Vec<Out> {
+        let Some(bound) = self.bound.as_ref().filter(|b| app.session.active().is_some_and(|doc| doc.uid == b.document)) else {
+            return vec![Out::error("save", request_id, "not_open", "No hosted workbook is open.")];
+        };
+        if bound.needs_reload {
+            return vec![Out::error("save", request_id, "stale_base", "Reopen the committed workbook before saving.")];
+        }
+        if self.saves.len() >= port_protocol::MAX_PENDING_SAVES {
+            return vec![Out::error("save", request_id, "busy", "Too many saves await the host.")];
+        }
+        // The host's (auto)save of a revision already refused for fidelity: the same answer, at
+        // once. The user's own Save always tries again.
+        self.revisions.observe(app);
+        if !announce
+            && let Some(refused) = &bound.refused
+            && refused.revision == self.revisions.revision()
+        {
+            return vec![fidelity_loss(request_id, refused.parts.clone())];
+        }
+        let (name, format) = (bound.name.clone(), bound.format);
+        let encoded = match app.native_snapshot_bytes_as(format) {
+            Ok(result) => result,
+            Err(error) => return vec![Out::error("save", request_id, "save_failed", &error)],
+        };
+        // A pending draft may have advanced the workbook while it was encoded.
+        self.revisions.observe(app);
+        let revision = self.revisions.revision();
+        let Some(doc) = app.session.active() else { return vec![Out::error("save", request_id, "not_open", "No hosted workbook is open.")] };
+        let document = doc.uid.to_string();
+        let mut out = Vec::new();
+        if announce {
+            out.push(Out::new("save-request", vec![("requestId", s(request_id)), ("document", s(&document)), ("revision", s(&revision))]));
+        }
+        if let Some(code) = encoded.get("parts").and_then(|parts| parts.get(0)).and_then(|part| part.get("code")).and_then(|code| code.as_str()) {
+            let code = match code {
+                "xml_signatures" => "xml_signatures",
+                "vba_signature" => "vba_signature",
+                "worksheet" => "worksheet",
+                "package" => "package",
+                _ => "package_edit",
+            };
+            let lost = vec![(code, 1)];
+            if let Some(b) = self.bound.as_mut() {
+                b.refused = Some(Refused { revision, parts: lost.clone() });
+            }
+            out.push(fidelity_loss(request_id, lost));
+            return out;
+        }
+        let Some(bytes) = encoded.get("base64").and_then(|value| value.as_str()).and_then(gridcraft_engine::io::base64_decode) else {
+            out.push(Out::error("save", request_id, "save_failed", "The engine did not encode the workbook."));
+            return out;
+        };
+        let Some(base) = doc.package_base.as_ref() else {
+            out.push(Out::error("save", request_id, "stale_base", "The original workbook package is unavailable."));
+            return out;
+        };
+        // The cells changed since the saved version, for the server's record of what the person
+        // touched (undo of an agent's change spares them); "unknown" when they can't be named.
+        let touched = match crate::native_execute::touched(&doc.wb, &doc.saved) {
+            Some(cells) => Value::Addresses(cells),
+            None => s("unknown"),
+        };
+        let save = HeldSave {
+            from: base.bytes.clone(),
+            package: gridcraft_engine::WorkbookPackage { bytes: Arc::from(bytes.as_slice()), model: doc.wb.clone() },
+        };
+        if let Err(code) = self.saves.begin(request_id, &document, &revision, save) {
+            out.push(Out::error("save", request_id, code, "The save could not be recorded."));
+            return out;
+        }
+        out.push(Out::new(
+            "save",
+            vec![
+                ("requestId", s(request_id)),
+                ("document", s(&document)),
+                ("revision", s(&revision)),
+                ("name", s(&name)),
+                ("format", s(format)),
+                ("bytes", Value::Bytes(bytes)),
+                ("touched", touched),
+            ],
+        ));
+        out
+    }
+
+    fn execute(&mut self, app: &mut SheetApp, request_id: &str, commands: &str, saved: bool, base: Option<String>) -> Out {
+        if self.bound.is_none() {
+            return Out::error("executed", request_id, "failed", "No hosted workbook is open.");
+        }
+        if base.is_some_and(|base| base != self.revisions.revision()) {
+            return Out::error("executed", request_id, "stale_base", "The document changed since the host last saw it.");
+        }
+        if saved && app.session.active().is_some_and(|doc| doc.is_dirty()) {
+            return Out::error("executed", request_id, "stale_base", "Replay the published edit over the saved workbook.");
+        }
+        // Keys typed before the unlock are still going in: the same as an open draft.
+        if self.held.replaying() {
+            return Out::error("executed", request_id, "busy", "A cell or text box is being edited.");
+        }
+        match crate::native_execute::execute(app, commands, self.access.read_only(), saved) {
+            Ok(done) => {
+                self.revisions.observe(app);
+                if saved && let Some(bound) = self.bound.as_mut() {
+                    bound.saved_revision = self.revisions.revision();
+                    bound.advance_publication(app);
+                }
+                Out::new(
+                    "executed",
+                    vec![
+                        ("requestId", s(request_id)),
+                        ("document", s(&done.document)),
+                        ("revision", s(&self.revisions.revision())),
+                        ("applied", Value::Num(done.applied as f64)),
+                    ],
+                )
+            }
+            Err(error) => Out::error("executed", request_id, port_protocol::execute_error_code(&error), &error),
+        }
+    }
+}
+
+impl PortSession {
+    /// `execute` with `keep: "human"`: the host's commands (an agent's edits on the saved version)
+    /// replayed over the person's edits since, as one undo step called `label`. `baseRevision`,
+    /// when given, must be the saved version's revision (`savedRevision` of the last reply). With
+    /// `saved` the host has stored its version: it becomes the saved version. Without edits of
+    /// the person's own that is the result itself; with them, the saved version is the host's
+    /// version made from the saved one, and the person's edits stay unsaved on top of it (the
+    /// host saves them as usual). The reply's `savedRevision` names it for the host's next base.
+    fn execute_keeping_human(&mut self, app: &mut SheetApp, request_id: &str, commands: &str, saved: bool, base: Option<String>, label: &str) -> Out {
+        let Some(bound) = self.bound.as_ref().filter(|b| app.session.active().is_some_and(|doc| doc.uid == b.document)) else {
+            return Out::error("executed", request_id, "failed", "No hosted workbook is open.");
+        };
+        // Never a replay on a guessed base: only on exactly the saved version (the protocol
+        // already refuses one without a base).
+        if base.as_deref() != Some(bound.saved_revision.as_str()) {
+            return Out::error("executed", request_id, "stale_base", "The saved version changed since the host's base.");
+        }
+        if self.held.replaying() {
+            return Out::error("executed", request_id, "busy", "A cell or text box is being edited.");
+        }
+        let clean = app.session.active().is_some_and(|doc| !doc.is_dirty());
+        match crate::native_execute::execute_keeping_human(app, commands, self.access.read_only(), label, saved && !clean) {
+            Ok(done) => {
+                if saved
+                    && clean
+                    && let Some(doc) = app.session.active_mut()
+                {
+                    doc.saved = doc.wb.clone();
+                }
+                self.revisions.observe(app);
+                if (saved && clean || done.rebased)
+                    && let Some(bound) = self.bound.as_mut()
+                {
+                    // A new name for the new saved version (the host's), never one of the
+                    // person's: the next replay must build on exactly this one.
+                    bound.saved_revision = if done.rebased { format!("saved-{}", self.revisions.revision()) } else { self.revisions.revision() };
+                    bound.advance_publication(app);
+                }
+                let saved_revision = self.bound.as_ref().map(|b| b.saved_revision.clone()).unwrap_or_default();
+                let mut fields = vec![
+                    ("requestId", s(request_id)),
+                    ("document", s(&done.document)),
+                    ("revision", s(&self.revisions.revision())),
+                    ("applied", Value::Num(done.applied as f64)),
+                    ("conflicts", Value::Conflicts(done.conflicts)),
+                    ("savedRevision", s(&saved_revision)),
+                ];
+                if done.truncated {
+                    fields.push(("conflictsTruncated", Value::Bool(true)));
+                }
+                Out::new("executed", fields)
+            }
+            Err(refused) => {
+                let code = refused.code.unwrap_or_else(|| port_protocol::execute_error_code(&refused.error));
+                Out::error("executed", request_id, code, &refused.error)
+            }
+        }
+    }
+}
+
+impl Bound {
+    // Reconstruct only the publication from the previous package. The person's
+    // current model is never used for this step when there are unsaved edits.
+    fn advance_publication(&mut self, app: &mut SheetApp) {
+        let Some(doc) = app.session.active_mut() else {
+            self.needs_reload = true;
+            return;
+        };
+        let Some(base) = &doc.package_base else {
+            self.needs_reload = true;
+            return;
+        };
+        match gridcraft_engine::package_edit::write_package_cells(&base.bytes, &base.model, &doc.saved, self.format) {
+            Ok(bytes) => doc.package_base = Some(gridcraft_engine::WorkbookPackage { bytes: bytes.into(), model: doc.saved.clone() }),
+            Err(_) => self.needs_reload = true,
+        }
+    }
+}
+
+/// A revision whose save was refused as `fidelity_loss`.
+struct Refused {
+    revision: String,
+    /// What it would have lost.
+    parts: Vec<(&'static str, u64)>,
+}
+
+/// The document stays dirty when a save cannot preserve its original package.
+fn fidelity_loss(request_id: &str, parts: Vec<(&'static str, u64)>) -> Out {
+    let signed = parts.iter().any(|(code, _)| matches!(*code, "xml_signatures" | "vba_signature"));
+    let reason = if signed { "This signed workbook cannot be changed." } else { "The workbook package cannot preserve this change." };
+    let mut out = Out::error("save", request_id, "fidelity_loss", reason);
+    out.fields.push(("parts", Value::Warnings(parts)));
+    out
+}
+
+pub fn notices(notices: &[crate::held_input::Notice]) -> Vec<Out> {
+    notices
+        .iter()
+        .map(|notice| match notice {
+            crate::held_input::Notice::Attempt(document, kind) => {
+                Out::new("edit-attempt", vec![("document", s(&document.to_string())), ("kind", s(kind.name()))])
+            }
+            crate::held_input::Notice::Dropped(document, reason) => {
+                Out::new("held-input-dropped", vec![("document", s(&document.to_string())), ("reason", s(reason.name()))])
+            }
+        })
+        .collect()
+}
