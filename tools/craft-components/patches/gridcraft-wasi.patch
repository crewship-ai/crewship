+/// A header as compared: trimmed, inner runs of whitespace as one space, case folded unless
+/// `match_case`.
+fn header_key(t: &str, match_case: bool) -> String {
+    let t = t.split_whitespace().collect::<Vec<_>>().join(" ");
+    if match_case { t } else { t.to_lowercase() }
+}
+
+fn column_by_header(s: &mut Session, p: &Json) -> Result<Json> {
+    let header = str_param(p, "header").ok_or_else(|| bad("range.columnByHeader", "`header` is required"))?;
+    let match_case = bool_param(p, "matchCase").unwrap_or(false);
+    let want = header_key(header, match_case);
+    if want.is_empty() {
+        return Err(bad("range.columnByHeader", "`header` is empty"));
+    }
+    let sheets: Vec<usize> = if p.get("sheet").is_some_and(|v| !v.is_null()) { vec![target_sheet(s, p)?] } else { (0..s.doc()?.wb.sheets.len()).collect() };
+    let d = s.doc()?;
+    let mut columns = Vec::new();
+    for si in sheets {
+        let Some(sh) = d.wb.sheet(si) else { continue };
+        let Some(used) = sh.used_range() else { continue };
+        let mut hits: Vec<CellRef> =
+            sh.cells.iter().filter(|(_, c)| matches!(&c.value, Value::Text(t) if header_key(t, match_case) == want)).map(|(at, _)| at).collect();
+        hits.sort_by_key(|c| (c.row, c.col));
+        for at in hits {
+            // A merged header heads every column it spans, from the row below the merge.
+            let head = sh.merge_at(at).unwrap_or(RangeRef::cell(at));
+            let range = (head.end.row < used.end.row).then(|| {
+                let r = RangeRef::new(CellRef::new(head.end.row + 1, head.start.col), CellRef::new(used.end.row, head.end.col));
+                format!("{}!{}", gridcraft_core::quote_sheet(&sh.name), r.a1())
+            });
+            columns.push(json!({"sheet": sh.name, "headerCell": at.a1(), "range": range}));
+        }
+    }
+    Ok(json!({"columns": columns}))
+}
