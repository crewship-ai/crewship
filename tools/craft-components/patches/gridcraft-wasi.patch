+/// A digest of a PivotTable's source: its sheet, range and every value in it.
+fn source_digest(wb: &Workbook, pt: &PivotTable, pivot_sheet: usize) -> Option<[u8; 32]> {
+    use sha2::{Digest, Sha256};
+    let (si, r, _) = resolve_source(wb, &pt.source, pivot_sheet, 0)?;
+    if r.count() > MAX_SOURCE_CELLS {
+        return None;
+    }
+    let sh = wb.sheet(si)?;
+    let mut h = Sha256::new();
+    h.update(format!("{si}:{r:?}").as_bytes());
+    for row in r.start.row..=r.end.row {
+        for col in r.start.col..=r.end.col {
+            h.update(format!("{:?}", sh.value(CellRef::new(row, col)).scalar()).as_bytes());
+            h.update([0]);
+        }
+    }
+    Some(h.finalize().into())
+}
