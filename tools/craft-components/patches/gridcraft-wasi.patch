index 00000000..732c9692
--- /dev/null
+++ b/crates/xlsx/src/package_edit.rs
@@ -0,0 +1,730 @@
+//! Write cell edits into the exact OPC package from which they were made.
+//! Nothing outside the edited cells is serialized from GridCraft's model.
+
+use std::collections::{BTreeMap, HashSet};
+use std::io::{Cursor, Write};
+use std::ops::Range;
+
+use gridcraft_core::{CellRef, RangeRef, Value};
+use gridcraft_model::{Cell, StyleId, Workbook};
+use quick_xml::Reader;
+use quick_xml::events::{BytesStart, Event};
+use zip::{ZipArchive, ZipWriter, write::SimpleFileOptions};
+
+use crate::package::{Package, normalize};
+use crate::write::NS_MAIN;
+use crate::xml::{encode_xstring, esc, esc_attr, num};
+
+#[derive(Debug)]
+pub struct EditRefusal {
+    pub code: &'static str,
+}
+
+type Result<T> = std::result::Result<T, EditRefusal>;
+
+const UNSUPPORTED: EditRefusal = EditRefusal { code: "package_edit" };
+const PACKAGE: EditRefusal = EditRefusal { code: "package" };
+const WORKSHEET: EditRefusal = EditRefusal { code: "worksheet" };
+const CALC_CHAIN: EditRefusal = EditRefusal { code: "calc_chain" };
+const CHAIN_PART: &str = "xl/calcChain.xml";
+const TYPES_PART: &str = "[Content_Types].xml";
+const WORKBOOK_RELS: &str = "xl/_rels/workbook.xml.rels";
+
+/// Preserve the source package, including its original names, relationships and
+/// indices. Only support changes that can be proved to be ordinary cell edits.
+pub fn write_package_cells(source: &[u8], before: &Workbook, after: &Workbook, format: &str) -> Result<Vec<u8>> {
+    let mut package = Package::open(source).map_err(|_| PACKAGE)?;
+    let types = package.read_limited("[Content_Types].xml", 1 << 20).map_err(|_| PACKAGE)?.ok_or(PACKAGE)?;
+    let types = std::str::from_utf8(&types).map_err(|_| PACKAGE)?.to_ascii_lowercase();
+    let macro_enabled = types.contains("application/vnd.ms-excel.sheet.macroenabled.main+xml");
+    if !(macro_enabled && format == "xlsm"
+        || !macro_enabled && format == "xlsx" && types.contains("application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"))
+    {
+        return Err(UNSUPPORTED);
+    }
+    let mut zip = ZipArchive::new(Cursor::new(source)).map_err(|_| PACKAGE)?;
+    let names = zip.file_names().collect::<std::result::Result<Vec<_>, _>>().map_err(|_| PACKAGE)?;
+    if types.contains("digital-signature") || names.iter().any(|name| name.to_ascii_lowercase().starts_with("_xmlsignatures/")) {
+        return Err(EditRefusal { code: "xml_signatures" });
+    }
+    if types.contains("vbaprojectsignature")
+        || !before.vba_signatures.is_empty()
+        || names.iter().any(|name| name.to_ascii_lowercase().starts_with("xl/vbaprojectsignature"))
+    {
+        return Err(EditRefusal { code: "vba_signature" });
+    }
+
+    let mut workbook = after.clone();
+    workbook.sheets.clone_from(&before.sheets);
+    workbook.active_sheet = before.active_sheet.clone();
+    if &workbook != before || !before.structure.same(after.structure) || before.sheets.len() != after.sheets.len() {
+        return Err(UNSUPPORTED);
+    }
+
+    let chain = names.iter().find(|name| name.eq_ignore_ascii_case(CHAIN_PART));
+    let mut formula_changed = false;
+    let sheets = sheet_parts(&mut package)?;
+    let mut replacements = BTreeMap::new();
+    for (old, new) in before.sheets.iter().zip(&after.sheets) {
+        if std::sync::Arc::ptr_eq(old, new) {
+            continue;
+        }
+        let mut shape = (**new).clone();
+        shape.cells = old.cells.clone();
+        // The caret and scroll position belong to the editor session.
+        shape.view_active = old.view_active;
+        shape.view_top_left = old.view_top_left;
+        if &shape != old.as_ref() {
+            return Err(UNSUPPORTED);
+        }
+        let mut edits = BTreeMap::new();
+        for (at, cell) in new.cells.iter() {
+            let prior = old.cells.get(at);
+            if prior.is_none_or(|prior| !same_cell(prior, cell)) {
+                edits.insert(at, (prior, Some(cell)));
+            }
+        }
+        for (at, cell) in old.cells.iter() {
+            if new.cells.get(at).is_none() {
+                edits.insert(at, (Some(cell), None));
+            }
+        }
+        if edits.is_empty() {
+            continue;
+        }
+        formula_changed |= chain.is_some() && edits.values().any(|(old, new)| {
+            !same_formula(old.and_then(|c| c.formula.as_deref()), new.and_then(|c| c.formula.as_deref()))
+        });
+        let part = sheets.get(&(old.file_id, old.name.clone())).ok_or(WORKSHEET)?;
+        let data = package.read(part).map_err(|_| PACKAGE)?.ok_or(WORKSHEET)?;
+        let updated = edit_sheet(&data, edits)?;
+        if replacements.insert(normalize(part), updated).is_some() {
+            return Err(WORKSHEET);
+        }
+    }
+    if replacements.is_empty() {
+        return Ok(source.to_vec());
+    }
+
+    if formula_changed {
+        if chain.is_some_and(|name| &name[..] != CHAIN_PART) {
+            return Err(CALC_CHAIN);
+        }
+        remove_calc_chain_declarations(&mut package, &mut replacements)?;
+    }
+
+    let mut out = ZipWriter::new(Cursor::new(Vec::new()));
+    let mut seen = HashSet::new();
+    for i in 0..zip.len() {
+        let file = zip.by_index(i).map_err(|_| PACKAGE)?;
+        let name = file.name().map_err(|_| PACKAGE)?.into_owned();
+        if !seen.insert(normalize(name.trim_end_matches('/')).to_ascii_lowercase())
+            || name.starts_with('/')
+            || name.contains('\\')
+            || name.split('/').any(|segment| matches!(segment, "." | ".."))
+        {
+            return Err(PACKAGE);
+        }
+        if formula_changed && name == CHAIN_PART {
+            continue;
+        }
+        if let Some(data) = replacements.remove(&normalize(&name)) {
+            let options = SimpleFileOptions::default().compression_method(file.compression());
+            out.start_file(name, options).map_err(|_| PACKAGE)?;
+            out.write_all(&data).map_err(|_| PACKAGE)?;
+        } else {
+            out.raw_copy_file(file).map_err(|_| PACKAGE)?;
+        }
+    }
+    if !replacements.is_empty() {
+        return Err(WORKSHEET);
+    }
+    Ok(out.finish().map_err(|_| PACKAGE)?.into_inner())
+}
+
+// A formula edit invalidates Excel's calculation-order cache, which Excel can
+// regenerate. Remove its two declarations without reserializing any other XML.
+fn remove_calc_chain_declarations(package: &mut Package<'_>, replacements: &mut BTreeMap<String, Vec<u8>>) -> Result<()> {
+    let types = package.read_limited(TYPES_PART, 16 << 20).map_err(|_| CALC_CHAIN)?.ok_or(CALC_CHAIN)?;
+    let types = without_calc_declaration(
+        &types, b"Types", b"Override", "http://schemas.openxmlformats.org/package/2006/content-types",
+        |el| Ok(attr(el, b"PartName")?.as_deref() == Some("/xl/calcChain.xml")
+            && attr(el, b"ContentType")?.as_deref() == Some("application/vnd.openxmlformats-officedocument.spreadsheetml.calcChain+xml")),
+    )?;
+    let rels = package.read_limited(WORKBOOK_RELS, 16 << 20).map_err(|_| CALC_CHAIN)?.ok_or(CALC_CHAIN)?;
+    let rels = without_calc_declaration(
+        &rels, b"Relationships", b"Relationship", "http://schemas.openxmlformats.org/package/2006/relationships",
+        |el| Ok(matches!(attr(el, b"Target")?.as_deref(), Some("calcChain.xml" | "/xl/calcChain.xml"))
+            && attr(el, b"Type")?.as_deref() == Some("http://schemas.openxmlformats.org/officeDocument/2006/relationships/calcChain")
+            && matches!(attr(el, b"TargetMode")?.as_deref(), None | Some("Internal"))),
+    )?;
+    replacements.insert(normalize(TYPES_PART), types);
+    replacements.insert(normalize(WORKBOOK_RELS), rels);
+    Ok(())
+}
+
+fn without_calc_declaration(
+    data: &[u8], root_name: &[u8], child_name: &[u8], namespace: &str,
+    matches: impl Fn(&BytesStart<'_>) -> Result<bool>,
+) -> Result<Vec<u8>> {
+    let mut root_seen = false;
+    let mut removed = None;
+    elements(data, |root| {
+        if root_seen || root.start.local_name().as_ref() != root_name {
+            return Err(CALC_CHAIN);
+        }
+        root_seen = true;
+        let name = root.start.name();
+        let mut xmlns = b"xmlns".to_vec();
+        let mut child = Vec::new();
+        if let Some(separator) = name.as_ref().iter().position(|&b| b == b':') {
+            let prefix = &name.as_ref()[..separator];
+            xmlns.push(b':');
+            xmlns.extend_from_slice(prefix);
+            child.extend_from_slice(prefix);
+            child.push(b':');
+        }
+        child.extend_from_slice(child_name);
+        if attr(&root.start, &xmlns)?.as_deref() != Some(namespace) {
+            return Err(CALC_CHAIN);
+        }
+        let body = root.body.ok_or(CALC_CHAIN)?;
+        elements(&data[body.clone()], |el| {
+            if el.start.name().as_ref() == child.as_slice() && matches(&el.start)? {
+                if removed.is_some()
+                    || el.body.as_ref().is_some_and(|span| !span.is_empty())
+                    || attr(&el.start, &xmlns)?.is_some_and(|value| value != namespace)
+                {
+                    return Err(CALC_CHAIN);
+                }
+                removed = Some(absolute(body.start, el.whole));
+            }
+            Ok(())
+        })
+    }).map_err(|_| CALC_CHAIN)?;
+    let range = removed.ok_or(CALC_CHAIN)?;
+    let mut result = Vec::with_capacity(data.len() - range.len());
+    result.extend_from_slice(&data[..range.start]);
+    result.extend_from_slice(&data[range.end..]);
+    Ok(result)
+}
+
+fn same_formula(a: Option<&gridcraft_model::Formula>, b: Option<&gridcraft_model::Formula>) -> bool {
+    match (a, b) {
+        (Some(a), Some(b)) => a.text == b.text && a.array == b.array && a.dynamic == b.dynamic,
+        (None, None) => true,
+        _ => false,
+    }
+}
+
+fn same_cell(a: &Cell, b: &Cell) -> bool {
+    a.style == b.style && a.value == b.value && a.py == b.py && same_formula(a.formula.as_deref(), b.formula.as_deref())
+}
+
+fn sheet_parts(package: &mut Package<'_>) -> Result<BTreeMap<(u32, String), String>> {
+    let root = package.rels("").map_err(|_| PACKAGE)?;
+    if root.iter().any(|r| r.kind == "origin" && r.ty.contains("digital-signature")) {
+        return Err(EditRefusal { code: "xml_signatures" });
+    }
+    let workbook = root.iter().find(|r| r.kind == "officeDocument" && !r.external).ok_or(PACKAGE)?;
+    let xml = package.read_xml(&workbook.target).map_err(|_| PACKAGE)?.ok_or(PACKAGE)?;
+    let rels = package.rels(&workbook.target).map_err(|_| PACKAGE)?;
+    for r in rels.iter().filter(|r| r.kind == "vbaProject" && !r.external) {
+        if package.rels(&r.target).map_err(|_| PACKAGE)?.iter().any(|r| r.kind.starts_with("vbaProjectSignature")) {
+            return Err(EditRefusal { code: "vba_signature" });
+        }
+    }
+    let mut sheets = BTreeMap::new();
+    let mut parts = HashSet::new();
+    for sheet in xml.child("sheets").ok_or(PACKAGE)?.kids("sheet") {
+        let id = sheet.attr("sheetId").and_then(|s| s.parse::<u32>().ok()).ok_or(PACKAGE)?;
+        let name = sheet.attr("name").ok_or(PACKAGE)?;
+        let rid = sheet.attr("id").ok_or(PACKAGE)?;
+        let mut matches = rels.iter().filter(|r| r.id == rid && !r.external);
+        let rel = matches.next().ok_or(PACKAGE)?;
+        if matches.next().is_some() {
+            return Err(PACKAGE);
+        }
+        if rel.kind == "worksheet" && (!parts.insert(rel.target.clone()) || sheets.insert((id, name.to_string()), rel.target.clone()).is_some()) {
+            return Err(PACKAGE);
+        }
+    }
+    Ok(sheets)
+}
+
+struct Element<'a> {
+    start: BytesStart<'a>,
+    whole: Range<usize>,
+    body: Option<Range<usize>>,
+}
+
+/// Walk direct children only, handing out ranges into the unchanged input.
+fn elements(data: &[u8], mut visit: impl FnMut(Element<'_>) -> Result<()>) -> Result<()> {
+    let mut reader = Reader::from_reader(data);
+    loop {
+        let start_at = reader.buffer_position() as usize;
+        match reader.read_event().map_err(|_| WORKSHEET)? {
+            Event::Start(start) => {
+                let body = reader.read_to_end(start.name()).map_err(|_| WORKSHEET)?;
+                visit(Element { start, whole: start_at..reader.buffer_position() as usize, body: Some(body.start as usize..body.end as usize) })?;
+            }
+            Event::Empty(start) => visit(Element { start, whole: start_at..reader.buffer_position() as usize, body: None })?,
+            Event::Eof => return Ok(()),
+            Event::DocType(_) | Event::End(_) => return Err(WORKSHEET),
+            _ => {}
+        }
+    }
+}
+
+fn attr(el: &BytesStart<'_>, key: &[u8]) -> Result<Option<String>> {
+    for a in el.attributes() {
+        let a = a.map_err(|_| WORKSHEET)?;
+        if a.key.as_ref() == key {
+            // Spreadsheet coordinates, cell types, styles and xmlns do not use entities.
+            return std::str::from_utf8(a.value.as_ref()).map(|value| Some(value.to_string())).map_err(|_| WORKSHEET);
+        }
+    }
+    Ok(None)
+}
+
+type Edits<'a> = BTreeMap<CellRef, (Option<&'a Cell>, Option<&'a Cell>)>;
+
+fn edit_sheet(data: &[u8], mut edits: Edits<'_>) -> Result<Vec<u8>> {
+    let mut sheet_data = None;
+    let mut empty_data = None;
+    let mut dimension = None;
+    elements(data, |root| {
+        if sheet_data.is_some()
+            || empty_data.is_some()
+            || root.start.name().as_ref() != b"worksheet"
+            || attr(&root.start, b"xmlns")?.as_deref() != Some(NS_MAIN)
+        {
+            return Err(WORKSHEET);
+        }
+        let body = root.body.ok_or(WORKSHEET)?;
+        elements(&data[body.clone()], |el| {
+            match el.start.name().as_ref() {
+                b"dimension" => {
+                    if dimension.is_some() || el.start.attributes().count() != 1 || el.body.is_some() {
+                        return Err(WORKSHEET);
+                    }
+                    let range = attr(&el.start, b"ref")?.ok_or(WORKSHEET)?;
+                    dimension = Some((RangeRef::parse(&range).ok_or(WORKSHEET)?, absolute(body.start, el.whole)));
+                }
+                b"sheetData" => {
+                    if sheet_data.is_some() || empty_data.is_some() || attr(&el.start, b"xmlns")?.is_some() {
+                        return Err(WORKSHEET);
+                    }
+                    if let Some(span) = el.body {
+                        sheet_data = Some(absolute(body.start, span));
+                    } else if el.start.attributes().next().is_none() {
+                        empty_data = Some(absolute(body.start, el.whole));
+                    } else {
+                        return Err(WORKSHEET);
+                    }
+                }
+                _ => {}
+            }
+            Ok(())
+        })
+    })?;
+    let data_start = empty_data.as_ref().or(sheet_data.as_ref()).ok_or(WORKSHEET)?.start;
+    let dimension = if let Some((original, span)) = dimension {
+        if span.end > data_start {
+            return Err(WORKSHEET);
+        }
+        let mut expanded = original;
+        for (at, (old, _)) in &edits {
+            if original.contains(*at) {
+                continue;
+            }
+            if old.is_some() || !at.is_valid() {
+                return Err(WORKSHEET);
+            }
+            expanded = RangeRef::new(
+                CellRef::new(expanded.start.row.min(at.row), expanded.start.col.min(at.col)),
+                CellRef::new(expanded.end.row.max(at.row), expanded.end.col.max(at.col)),
+            );
+        }
+        (expanded != original).then(|| (span, format!("<dimension ref=\"{}\"/>", expanded.a1())))
+    } else {
+        None
+    };
+    let mut output = Vec::with_capacity(data.len());
+    if let Some(empty) = empty_data {
+        output.extend_from_slice(&data[..empty.start]);
+        output.extend_from_slice(b"<sheetData>");
+        write_new_rows(&mut output, &mut edits, gridcraft_core::MAX_ROWS)?;
+        if !edits.is_empty() {
+            return Err(WORKSHEET);
+        }
+        output.extend_from_slice(b"</sheetData>");
+        output.extend_from_slice(&data[empty.end..]);
+        return Ok(rewrite_dimension(output, dimension));
+    }
+    let sheet_data = sheet_data.ok_or(WORKSHEET)?;
+    let mut written = 0;
+    let part = &data[sheet_data.clone()];
+    let mut last_row = 0;
+    elements(part, |row| {
+        if row.start.name().as_ref() != b"row" || attr(&row.start, b"xmlns")?.is_some() {
+            return Err(WORKSHEET);
+        }
+        let row_index = attr(&row.start, b"r")?
+            .and_then(|r| r.parse::<u32>().ok())
+            .filter(|r| *r > last_row && *r <= gridcraft_core::MAX_ROWS)
+            .ok_or(WORKSHEET)?;
+        last_row = row_index;
+        let at = sheet_data.start + row.whole.start;
+        output.extend_from_slice(&data[written..at]);
+        write_new_rows(&mut output, &mut edits, row_index - 1)?;
+        written = at;
+        if edits.first_key_value().is_none_or(|(at, _)| at.row >= row_index) {
+            return Ok(());
+        }
+        let next_row = edits.split_off(&CellRef::new(row_index, 0));
+        let row_edits = std::mem::replace(&mut edits, next_row);
+        if row_edits.is_empty() {
+            return Ok(());
+        }
+        let body = row.body.ok_or(WORKSHEET)?;
+        let patched = edit_row(&part[body.clone()], row_index - 1, row_edits)?;
+        let body = absolute(sheet_data.start, body);
+        output.extend_from_slice(&data[written..body.start]);
+        output.extend_from_slice(&patched);
+        written = body.end;
+        Ok(())
+    })?;
+    output.extend_from_slice(&data[written..sheet_data.end]);
+    write_new_rows(&mut output, &mut edits, gridcraft_core::MAX_ROWS)?;
+    if !edits.is_empty() {
+        return Err(WORKSHEET);
+    }
+    output.extend_from_slice(&data[sheet_data.end..]);
+    Ok(rewrite_dimension(output, dimension))
+}
+
+fn rewrite_dimension(mut sheet: Vec<u8>, dimension: Option<(Range<usize>, String)>) -> Vec<u8> {
+    if let Some((span, element)) = dimension {
+        sheet.splice(span, element.bytes());
+    }
+    sheet
+}
+
+fn write_new_rows(out: &mut Vec<u8>, edits: &mut Edits<'_>, before_row: u32) -> Result<()> {
+    while let Some((at, _)) = edits.first_key_value().filter(|(at, _)| at.row < before_row) {
+        let row = at.row;
+        out.extend_from_slice(format!("<row r=\"{}\">", row + 1).as_bytes());
+        while edits.first_key_value().is_some_and(|(at, _)| at.row == row) {
+            let (at, (old, new)) = edits.pop_first().ok_or(WORKSHEET)?;
+            out.extend_from_slice(&cell_xml(at, old, new, None, &[])?);
+        }
+        out.extend_from_slice(b"</row>");
+    }
+    Ok(())
+}
+
+fn absolute(base: usize, range: Range<usize>) -> Range<usize> {
+    base + range.start..base + range.end
+}
+
+fn edit_row(data: &[u8], row: u32, mut edits: Edits<'_>) -> Result<Vec<u8>> {
+    let mut output = Vec::with_capacity(data.len());
+    let mut written = 0;
+    let mut last = None;
+    elements(data, |cell| {
+        if cell.start.name().as_ref() != b"c" || attr(&cell.start, b"xmlns")?.is_some() {
+            return Err(WORKSHEET);
+        }
+        let at = attr(&cell.start, b"r")?.as_deref().and_then(CellRef::parse).filter(|at| at.row == row).ok_or(WORKSHEET)?;
+        if last.is_some_and(|last| at <= last) {
+            return Err(WORKSHEET);
+        }
+        last = Some(at);
+        output.extend_from_slice(&data[written..cell.whole.start]);
+        while edits.first_key_value().is_some_and(|(next, _)| *next < at) {
+            let (next, (old, new)) = edits.pop_first().ok_or(WORKSHEET)?;
+            output.extend_from_slice(&cell_xml(next, old, new, None, data)?);
+        }
+        written = cell.whole.end;
+        if let Some((old, new)) = edits.remove(&at) {
+            output.extend_from_slice(&cell_xml(at, old, new, Some(cell), data)?);
+        } else {
+            output.extend_from_slice(&data[cell.whole]);
+        }
+        Ok(())
+    })?;
+    for (at, (old, new)) in edits {
+        output.extend_from_slice(&cell_xml(at, old, new, None, data)?);
+    }
+    output.extend_from_slice(&data[written..]);
+    Ok(output)
+}
+
+fn cell_xml(at: CellRef, old: Option<&Cell>, new: Option<&Cell>, source: Option<Element<'_>>, row: &[u8]) -> Result<Vec<u8>> {
+    let style = |cell: Option<&Cell>| cell.map_or(StyleId::DEFAULT, |cell| cell.style);
+    if style(old) != style(new) || old.is_some_and(|c| c.py.is_some()) || new.is_some_and(|c| c.py.is_some()) {
+        return Err(UNSUPPORTED);
+    }
+    if source.is_none() && old.is_some() {
+        return Err(WORKSHEET);
+    }
+    let mut style_attr = String::new();
+    let mut old_type = String::new();
+    let mut original_formula = None;
+    if let Some(source) = source {
+        for attr in source.start.attributes() {
+            let attr = attr.map_err(|_| WORKSHEET)?;
+            if !matches!(attr.key.as_ref(), b"r" | b"s" | b"t") {
+                return Err(UNSUPPORTED);
+            }
+        }
+        style_attr = attr(&source.start, b"s")?.unwrap_or_default();
+        old_type = attr(&source.start, b"t")?.unwrap_or_default();
+        if !matches!(old_type.as_str(), "" | "n" | "s" | "inlineStr" | "str" | "b" | "e" | "d")
+            || !style_attr.is_empty() && (!style_attr.bytes().all(|b| b.is_ascii_digit()) || style_attr.parse::<u32>().is_err())
+        {
+            return Err(UNSUPPORTED);
+        }
+        if let Some(body) = source.body {
+            let cell = &row[body];
+            let mut seen = HashSet::new();
+            let mut end = 0;
+            elements(cell, |el| {
+                if !cell[end..el.whole.start].iter().all(u8::is_ascii_whitespace) {
+                    return Err(UNSUPPORTED);
+                }
+                end = el.whole.end;
+                let tag = el.start.name();
+                if !matches!(tag.as_ref(), b"f" | b"v" | b"is") || el.start.attributes().next().is_some() {
+                    return Err(UNSUPPORTED);
+                }
+                if !seen.insert(tag.as_ref().to_vec()) {
+                    return Err(WORKSHEET);
+                }
+                if tag.as_ref() == b"f" {
+                    original_formula = Some(&cell[el.whole.clone()]);
+                }
+                if tag.as_ref() != b"is" && el.body.as_ref().is_some_and(|span| cell[span.clone()].contains(&b'<')) {
+                    return Err(UNSUPPORTED);
+                }
+                if tag.as_ref() == b"is" {
+                    let inner = &cell[el.body.ok_or(WORKSHEET)?];
+                    let mut text_end = 0;
+                    elements(inner, |text| {
+                        if text_end != 0
+                            || text.start.name().as_ref() != b"t"
+                            || !inner[..text.whole.start].iter().all(u8::is_ascii_whitespace)
+                            || text.body.is_some_and(|span| inner[span].contains(&b'<'))
+                            || text.start.attributes().any(|a| a.map_or(true, |a| a.key.as_ref() != b"xml:space"))
+                        {
+                            return Err(UNSUPPORTED);
+                        }
+                        text_end = text.whole.end;
+                        Ok(())
+                    })?;
+                    if text_end == 0 || !inner[text_end..].iter().all(u8::is_ascii_whitespace) {
+                        return Err(UNSUPPORTED);
+                    }
+                }
+                Ok(())
+            })?;
+            if !cell[end..].iter().all(u8::is_ascii_whitespace) {
+                return Err(UNSUPPORTED);
+            }
+        }
+    }
+    let old_formula = old.and_then(|c| c.formula.as_deref());
+    let new_formula = new.and_then(|c| c.formula.as_deref());
+    if old_formula.is_some_and(|f| f.array.is_some() || f.dynamic || f.document_value)
+        || new_formula.is_some_and(|f| f.array.is_some() || f.dynamic || f.document_value || f.expr.is_none())
+        || old_formula.is_some() != original_formula.is_some()
+    {
+        return Err(UNSUPPORTED);
+    }
+    let value = new.map_or(&Value::Empty, |cell| &cell.value);
+    let (ty, value_xml) = match value {
+        Value::Empty if new_formula.is_none() => ("", String::new()),
+        Value::Number(n) if n.is_finite() => ("n", format!("<v>{}</v>", num(*n))),
+        Value::Text(s) if new_formula.is_some() => ("str", format!("<v>{}</v>", esc(&encode_xstring(s)))),
+        Value::Text(s) => ("inlineStr", format!("<is><t xml:space=\"preserve\">{}</t></is>", esc(&encode_xstring(s)))),
+        Value::Bool(b) => ("b", format!("<v>{}</v>", u8::from(*b))),
+        Value::Error(e) => ("e", format!("<v>{}</v>", esc(&e.to_string()))),
+        _ => return Err(UNSUPPORTED),
+    };
+    let unchanged_formula = old_formula.is_some() && same_formula(old_formula, new_formula);
+    if unchanged_formula && (ty != if old_type.is_empty() { "n" } else { &old_type } || ty == "e" || value_xml == "<v></v>") {
+        return Err(UNSUPPORTED);
+    }
+    let style_attr = if style_attr.is_empty() { String::new() } else { format!(" s=\"{}\"", esc_attr(&style_attr)) };
+    let ty = if ty.is_empty() || ty == "n" && old_type.is_empty() { String::new() } else { format!(" t=\"{ty}\"") };
+    let mut output = format!("<c r=\"{at}\"{style_attr}{ty}>").into_bytes();
+    if unchanged_formula {
+        output.extend_from_slice(original_formula.ok_or(WORKSHEET)?);
+    } else if let Some(formula) = new_formula {
+        output.extend_from_slice(format!("<f>{}</f>", esc(&crate::fmla::to_file(formula))).as_bytes());
+    }
+    output.extend_from_slice(value_xml.as_bytes());
+    output.extend_from_slice(b"</c>");
+    Ok(output)
+}
+
