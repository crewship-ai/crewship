diff --git a/apps/gridcraft-web/src/draft_state.rs b/apps/gridcraft-web/src/draft_state.rs
new file mode 100644
index 00000000..d11f59ea
--- /dev/null
+++ b/apps/gridcraft-web/src/draft_state.rs
@@ -0,0 +1,126 @@
+//! Bounded host revision pulses include pending native editor drafts.
+
+use std::sync::Arc;
+
+use gridcraft_engine::{core::CellRef, model::Workbook};
+use gridcraft_ui_egui::SheetApp;
+use sha2::{Digest, Sha256};
+
+#[derive(PartialEq)]
+struct Fingerprint {
+    active: Option<(u64, u64, usize)>,
+    cell: Option<(u64, usize, CellRef, [u8; 32])>,
+    text_box: Option<(u32, [u8; 32])>,
+}
+
+fn changed_cell(app: &SheetApp) -> bool {
+    app.cell_draft().is_some_and(|edit| edit.original.as_ref().is_none_or(|original| original != &edit.text))
+}
+
+/// Draft buffers are native editor state, not yet part of `DocState::wb`.
+pub fn dirty(app: &SheetApp) -> bool {
+    app.session.documents().iter().any(|doc| doc.is_dirty()) || app.has_unsaved_drafts()
+}
+
+/// Bounded activity state: one shared workbook identity and fixed-size draft fingerprints.
+/// Holding the Arc forces copy-on-write for serialized view changes too; it also
+/// prevents pointer reuse from making a different workbook look unchanged.
+/// The counter is an opaque equality token, not a JavaScript number or a lease.
+#[derive(Default)]
+pub struct Revisions {
+    previous: Option<Fingerprint>,
+    workbook: Option<Arc<Workbook>>,
+    serial: u64,
+}
+
+impl Revisions {
+    pub fn observe(&mut self, app: &SheetApp) -> bool {
+        let fingerprint = Fingerprint {
+            // ActiveSheet is serialized AtomicUsize interior state: snapshot
+            // its value, since Arc identity alone cannot observe a sheet switch.
+            active: app.session.active().map(|doc| (doc.uid, doc.revision, doc.wb.active_sheet())),
+            cell: app
+                .editor
+                .as_ref()
+                .filter(|_| changed_cell(app))
+                .map(|edit| (edit.doc, edit.sheet, edit.cell, Sha256::digest(edit.text.as_bytes()).into())),
+            text_box: app
+                .text_box_editor
+                .as_ref()
+                .filter(|edit| edit.is_modified())
+                .map(|edit| (edit.id, Sha256::digest(edit.text.as_bytes()).into())),
+        };
+        let workbook = app.session.active().map(|doc| &doc.wb);
+        let same_workbook = match (&self.workbook, workbook) {
+            (Some(previous), Some(current)) => Arc::ptr_eq(previous, current),
+            (None, None) => true,
+            _ => false,
+        };
+        if self.previous.as_ref() == Some(&fingerprint) && same_workbook {
+            return false;
+        }
+        self.previous = Some(fingerprint);
+        self.workbook = workbook.cloned();
+        self.serial = self.serial.wrapping_add(1);
+        true
+    }
+
+    pub fn sequence(&self) -> u64 {
+        self.serial
+    }
+
+    pub fn revision(&self) -> String {
+        self.sequence().to_string()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use gridcraft_engine::Session;
+    use gridcraft_ui_egui::{Services, SheetApp};
+    use serde_json::json;
+
+    fn app() -> SheetApp {
+        let mut session = Session::new();
+        session.new_workbook();
+        let mut app = SheetApp::new(session, Services::default());
+        app.run("cell.set", json!({"cell":"A1", "input":"first"})).unwrap();
+        let doc = app.session.active_mut().unwrap();
+        doc.saved = doc.wb.clone();
+        app
+    }
+
+    #[test]
+    fn unchanged_editor_is_clean_and_invalid_draft_stays_dirty_until_cancelled() {
+        let mut app = app();
+        app.begin_edit(None, false);
+        assert!(!super::dirty(&app));
+        app.editor.as_mut().unwrap().text = "=1+".into();
+        assert!(super::dirty(&app));
+        app.cancel_edit();
+        assert!(!super::dirty(&app));
+    }
+
+    #[test]
+    fn every_draft_change_is_a_new_revision_and_idle_frames_are_not() {
+        let mut app = app();
+        let mut revisions = super::Revisions::default();
+        revisions.observe(&app);
+        assert!(!revisions.observe(&app), "nothing changed");
+        app.begin_edit(Some("typed".into()), false);
+        assert!(revisions.observe(&app));
+        app.editor.as_mut().unwrap().text = "typed more".into();
+        assert!(revisions.observe(&app));
+    }
+
+    #[test]
+    fn draft_counter_wraps_with_a_bounded_opaque_string() {
+        let mut app = app();
+        let mut revisions = super::Revisions::default();
+        revisions.observe(&app);
+        revisions.serial = u64::MAX;
+        app.begin_edit(Some("another".into()), false);
+        assert!(revisions.observe(&app));
+        assert_eq!(revisions.revision(), "0");
+    }
+}
diff --git a/apps/gridcraft-web/src/held_input.rs b/apps/gridcraft-web/src/held_input.rs
new file mode 100644
index 00000000..52d15f96
--- /dev/null
+++ b/apps/gridcraft-web/src/held_input.rs
@@ -0,0 +1,694 @@
+//! Keeps what a person types between their first keystroke in a host-held read-only workbook and
+//! the host's answer, so taking over the edit loses nothing and writes nothing without it.
+//!
+//! The host hears that a write was attempted (never what or where). Until it answers, keyboard
+//! input waits here in order and the workbook does not change. When the host unlocks the editor
+//! the input is replayed through the ordinary input path, one step per UI pass, with anything
+//! typed meanwhile queued behind it. Everything else (a refusal, no answer in time, too much
+//! input, another cell, sheet or workbook, a mouse press) throws the held input away and says so.
+
+use std::collections::VecDeque;
+
+use egui::{Event, Key};
+use gridcraft_ui_egui::SheetApp;
+
+/// Held input is thrown away when the host has not answered after this long.
+pub const TIMEOUT_MS: f64 = 10_000.0;
+pub const MAX_EVENTS: usize = 256;
+pub const MAX_BYTES: usize = 64 * 1024;
+/// UI passes the replay waits for a cell editor it opened to take the keyboard.
+const MAX_FOCUS_WAIT: u32 = 120;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Kind {
+    Pointer,
+    Key,
+}
+
+impl Kind {
+    pub fn name(self) -> &'static str {
+        match self {
+            Self::Pointer => "pointer",
+            Self::Key => "key",
+        }
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Reason {
+    Refused,
+    Timeout,
+    Limit,
+    Pointer,
+    Document,
+    Draft,
+}
+
+impl Reason {
+    pub fn name(self) -> &'static str {
+        match self {
+            Self::Refused => "refused",
+            Self::Timeout => "timeout",
+            Self::Limit => "limit",
+            Self::Pointer => "pointer",
+            Self::Document => "document",
+            Self::Draft => "draft",
+        }
+    }
+}
+
+/// What the host is told, with the uid of the workbook it concerns.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Notice {
+    Attempt(u64, Kind),
+    Dropped(u64, Reason),
+}
+
+/// The place held input was typed at: workbook uid, sheet, row and column.
+type Pin = (u64, usize, u32, u32);
+
+#[derive(Default)]
+enum State {
+    #[default]
+    Idle,
+    Holding {
+        pin: Pin,
+        events: Vec<Event>,
+        bytes: usize,
+        since: f64,
+    },
+    Replaying {
+        document: u64,
+        steps: VecDeque<Vec<Event>>,
+        waited: u32,
+    },
+}
+
+#[derive(Default)]
+pub struct HeldInput {
+    state: State,
+    sent_pointer: bool,
+    sent_key: bool,
+    /// The pass number and event count the last hook handed to egui. eframe keeps a `RawInput`
+    /// that no pass consumed (a hidden tab) and offers it again in front of newer events.
+    emitted: Option<(u64, usize)>,
+}
+
+impl HeldInput {
+    /// Input is being replayed into the unlocked workbook.
+    pub fn replaying(&self) -> bool {
+        matches!(self.state, State::Replaying { .. })
+    }
+
+    /// Looks at this frame's raw input before the app does. `host_read_only` is the access the
+    /// host last applied.
+    pub fn capture(&mut self, app: &mut SheetApp, ctx: &egui::Context, raw: &mut egui::RawInput, host_read_only: bool, now: f64) -> Vec<Notice> {
+        let mut notices = Vec::new();
+        self.expire(app, now, &mut notices);
+        self.check_place(app, &mut notices);
+        let seen = self.emitted.filter(|(pass, _)| *pass == ctx.cumulative_pass_nr()).map_or(0, |(_, count)| count.min(raw.events.len()));
+        let fresh = raw.events.split_off(seen);
+        let mut kept: Vec<Event> = Vec::with_capacity(fresh.len());
+        // A shortcut earlier in this frame owns the text its key typed, as in the grid.
+        let mut shortcut = false;
+        for event in fresh {
+            if let Event::PointerButton { pressed: true, .. } = &event {
+                // Typing after a click would belong to another cell than the held input.
+                self.drop_input(app, Reason::Pointer, &mut notices);
+                self.pointer_attempt(app, ctx, &event, host_read_only, &mut notices);
+                kept.push(event);
+                continue;
+            }
+            if !is_keyboard(&event) {
+                kept.push(event);
+                continue;
+            }
+            match &mut self.state {
+                State::Replaying { steps, .. } => push_step(steps, event),
+                // Copying changes nothing and needs the gesture it was made in.
+                State::Holding { .. } if matches!(event, Event::Copy) => kept.push(event),
+                State::Holding { events, bytes, .. } => {
+                    *bytes += text_len(&event);
+                    events.push(event);
+                    if events.len() > MAX_EVENTS || *bytes > MAX_BYTES {
+                        self.drop_input(app, Reason::Limit, &mut notices);
+                    }
+                }
+                State::Idle => {
+                    if !host_read_only || !app.is_read_only() {
+                        kept.push(event);
+                        continue;
+                    }
+                    if let Event::Key { key, pressed: true, modifiers: m, .. } = &event {
+                        let mac = ctx.os() == egui::os::OperatingSystem::Mac;
+                        shortcut |= !m.alt && (m.ctrl || m.command || (m.shift && *key == Key::Space)) || m.alt && !m.ctrl && !mac;
+                    }
+                    if writes(app, &event, shortcut) && grid_owns_keyboard(app, ctx) {
+                        self.begin(app, event, &mut kept, now, &mut notices);
+                        ctx.request_repaint_after(std::time::Duration::from_millis(TIMEOUT_MS as u64 + 50));
+                    } else {
+                        kept.push(event);
+                    }
+                }
+            }
+        }
+        raw.events.extend(kept);
+        self.offer(app, ctx, &mut notices);
+        notices
+    }
+
+    /// Call after the app's own hook added its input to `raw`.
+    pub fn emitted(&mut self, ctx: &egui::Context, raw: &egui::RawInput) {
+        self.emitted = Some((ctx.cumulative_pass_nr(), raw.events.len()));
+    }
+
+    /// Call before access changes: input that waited too long is not written by a late answer.
+    pub fn before_access(&mut self, app: &mut SheetApp, now: f64) -> Vec<Notice> {
+        let mut notices = Vec::new();
+        self.expire(app, now, &mut notices);
+        notices
+    }
+
+    /// Call after access changed, with the access actually in force.
+    pub fn after_access(&mut self, app: &mut SheetApp) -> Vec<Notice> {
+        let mut notices = Vec::new();
+        self.sent_pointer = false;
+        self.sent_key = false;
+        if app.is_read_only() {
+            self.drop_input(app, Reason::Refused, &mut notices);
+            return notices;
+        }
+        self.check_place(app, &mut notices);
+        if matches!(self.state, State::Holding { .. }) {
+            if app.has_pending_drafts() {
+                self.drop_input(app, Reason::Draft, &mut notices);
+            } else if let State::Holding { pin, events, .. } = std::mem::take(&mut self.state) {
+                let mut steps = VecDeque::new();
+                for event in events {
+                    push_step(&mut steps, event);
+                }
+                self.state = State::Replaying { document: pin.0, steps, waited: 0 };
+            }
+        }
+        notices
+    }
+
+    fn expire(&mut self, app: &mut SheetApp, now: f64, notices: &mut Vec<Notice>) {
+        if let State::Holding { since, .. } = self.state
+            && now - since >= TIMEOUT_MS
+        {
+            self.drop_input(app, Reason::Timeout, notices);
+        }
+    }
+
+    /// Held input belongs to one cell; input being replayed to one workbook it may write to.
+    fn check_place(&mut self, app: &mut SheetApp, notices: &mut Vec<Notice>) {
+        let here = place(app);
+        match &self.state {
+            State::Holding { pin, .. } if here != Some(*pin) => self.drop_input(app, Reason::Document, notices),
+            State::Replaying { document, .. } if here.is_none_or(|pin| pin.0 != *document) => self.drop_input(app, Reason::Document, notices),
+            State::Replaying { .. } if app.is_read_only() => self.drop_input(app, Reason::Refused, notices),
+            _ => {}
+        }
+    }
+
+    fn pointer_attempt(&mut self, app: &SheetApp, ctx: &egui::Context, event: &Event, host_read_only: bool, notices: &mut Vec<Notice>) {
+        let Event::PointerButton { pos, button: egui::PointerButton::Primary, pressed: true, .. } = event else { return };
+        if self.sent_pointer || !host_read_only || !app.is_read_only() {
+            return;
+        }
+        let on_cells = app.grid.cells_rect.is_some_and(|rect| rect.contains(*pos));
+        let covered = app.dialog.is_some()
+            || app.message.is_some()
+            || app.backstage.is_some()
+            || ctx.layer_id_at(*pos).is_some_and(|layer| layer.order != egui::Order::Background);
+        if !on_cells || covered {
+            return;
+        }
+        if let Some((document, ..)) = place(app) {
+            self.sent_pointer = true;
+            notices.push(Notice::Attempt(document, Kind::Pointer));
+        }
+    }
+
+    fn begin(&mut self, app: &SheetApp, event: Event, kept: &mut Vec<Event>, now: f64, notices: &mut Vec<Notice>) {
+        let Some(pin) = place(app) else {
+            kept.push(event);
+            return;
+        };
+        if app.has_pending_drafts() {
+            // The person's own earlier draft waits for the unlock; nothing may be typed over it.
+            if !self.sent_key {
+                self.sent_key = true;
+                notices.push(Notice::Attempt(pin.0, Kind::Key));
+                notices.push(Notice::Dropped(pin.0, Reason::Draft));
+            }
+            return;
+        }
+        if !self.sent_key {
+            self.sent_key = true;
+            notices.push(Notice::Attempt(pin.0, Kind::Key));
+        }
+        let mut events = Vec::new();
+        // The press that typed this text goes with it (Space on a checkbox is a key, not a text).
+        if matches!(event, Event::Text(_))
+            && matches!(kept.last(), Some(Event::Key { pressed: true, modifiers, .. }) if !modifiers.any() || modifiers.shift_only())
+        {
+            events.extend(kept.pop());
+        }
+        let bytes = text_len(&event);
+        events.push(event);
+        self.state = State::Holding { pin, events, bytes, since: now };
+        if bytes > MAX_BYTES {
+            self.state = State::Idle;
+            self.sent_pointer = false;
+            self.sent_key = false;
+            notices.push(Notice::Dropped(pin.0, Reason::Limit));
+        }
+    }
+
+    /// Throws held or not yet replayed input away. The next attempt is reported again.
+    fn drop_input(&mut self, app: &mut SheetApp, reason: Reason, notices: &mut Vec<Notice>) {
+        let document = match std::mem::take(&mut self.state) {
+            State::Idle => return,
+            State::Holding { pin, .. } => pin.0,
+            State::Replaying { document, steps, .. } => {
+                let lost = !steps.is_empty() || !app.synthetic.is_empty();
+                app.synthetic.clear();
+                if !lost {
+                    return;
+                }
+                document
+            }
+        };
+        self.sent_pointer = false;
+        self.sent_key = false;
+        notices.push(Notice::Dropped(document, reason));
+    }
+
+    /// Gives the app the next step once the last one was applied by a real UI pass
+    /// (`SheetApp::synthetic` offers a step again when a pass skipped it).
+    fn offer(&mut self, app: &mut SheetApp, ctx: &egui::Context, notices: &mut Vec<Notice>) {
+        let State::Replaying { steps, waited, .. } = &mut self.state else { return };
+        if !app.synthetic.is_empty() {
+            ctx.request_repaint();
+            return;
+        }
+        if steps.is_empty() {
+            self.state = State::Idle;
+            return;
+        }
+        ctx.request_repaint();
+        // A cell editor opened by the last step takes the keyboard in the pass after it.
+        if app.editor.is_some() && !editor_has_keyboard(ctx) {
+            *waited += 1;
+            if *waited > MAX_FOCUS_WAIT {
+                self.drop_input(app, Reason::Draft, notices);
+            }
+            return;
+        }
+        *waited = 0;
+        if let Some(step) = steps.pop_front() {
+            app.synthetic.push_back(step);
+        }
+    }
+}
+
+fn place(app: &SheetApp) -> Option<Pin> {
+    let doc = app.session.active()?;
+    let active = doc.selection.active;
+    Some((doc.uid, doc.wb.active_sheet(), active.row, active.col))
+}
+
+fn is_keyboard(event: &Event) -> bool {
+    matches!(event, Event::Key { .. } | Event::Text(_) | Event::Paste(_) | Event::Copy | Event::Cut | Event::Ime(_))
+}
+
+fn text_len(event: &Event) -> usize {
+    match event {
+        Event::Text(text) | Event::Paste(text) | Event::Ime(egui::ImeEvent::Commit(text) | egui::ImeEvent::Preedit { text, .. }) => text.len(),
+        _ => 0,
+    }
+}
+
+/// Input that would write into the grid. Moving, selecting, copying and finding do not; Enter
+/// only moves, unless a copied range is marked (it pastes then).
+fn writes(app: &SheetApp, event: &Event, shortcut: bool) -> bool {
+    match event {
+        Event::Text(text) => !shortcut && !text.is_empty() && text.chars().all(|c| !c.is_control()),
+        Event::Paste(text) => !text.is_empty(),
+        Event::Ime(egui::ImeEvent::Commit(text) | egui::ImeEvent::Preedit { text, .. }) => !text.is_empty(),
+        Event::Key { key, pressed: true, modifiers: m, .. } if !m.alt && !m.ctrl && !m.command => match key {
+            Key::F2 | Key::Delete | Key::Backspace => true,
+            Key::Enter => !m.shift && app.session.clipboard.is_some(),
+            _ => false,
+        },
+        _ => false,
+    }
+}
+
+/// The grid would handle a key now: nothing else is open and no other widget has the focus.
+fn grid_owns_keyboard(app: &SheetApp, ctx: &egui::Context) -> bool {
+    let grid = &app.grid;
+    if app.editor.is_some()
+        || app.text_box_editor.is_some()
+        || app.dialog.is_some()
+        || app.message.is_some()
+        || app.backstage.is_some()
+        || app.name_box.is_some()
+        || app.keytips.prefix().is_some()
+        || grid.filter_menu.is_some()
+        || grid.fill_menu.is_some()
+        || grid.context_menu.is_some()
+        || grid.object_menu.is_some()
+        || grid.header_menu.is_some()
+        || grid.list_picker.is_some()
+        || grid.renaming_tab.is_some()
+        || grid.hf_edit.is_some()
+        || egui::Popup::is_any_open(ctx)
+    {
+        return false;
+    }
+    match ctx.memory(|memory| memory.focused()) {
+        None => true,
+        // Focus left on an editor that no longer exists goes back to the grid.
+        Some(id) if is_editor(id) => true,
+        Some(id) => ctx.read_response(id).is_some_and(|response| Some(response.rect) == grid.rect),
+    }
+}
+
+fn is_editor(id: egui::Id) -> bool {
+    id == egui::Id::unique("gridcraft.cell_editor") || id == egui::Id::unique("gridcraft.formula_bar")
+}
+
+fn editor_has_keyboard(ctx: &egui::Context) -> bool {
+    ctx.memory(|memory| memory.focused()).is_some_and(is_editor)
+}
+
+/// Groups events into replay steps: a key press with the text it typed and the releases after it.
+fn push_step(steps: &mut VecDeque<Vec<Event>>, event: Event) {
+    let joins = match &event {
+        Event::Key { pressed: true, .. } => false,
+        Event::Key { .. } => true,
+        _ => steps.back().and_then(|step| step.last()).is_some_and(|last| matches!(last, Event::Key { pressed: true, .. })),
+    };
+    match steps.back_mut() {
+        Some(step) if joins => step.push(event),
+        _ => steps.push_back(vec![event]),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use gridcraft_engine::Session;
+    use gridcraft_engine::core::CellRef;
+    use gridcraft_ui_egui::Services;
+    use serde_json::json;
+
+    struct Rig {
+        ctx: egui::Context,
+        app: SheetApp,
+        held: HeldInput,
+        host_read_only: bool,
+        now: f64,
+        notices: Vec<Notice>,
+    }
+
+    impl Rig {
+        /// A read-only workbook in the real UI, drawn a few times.
+        fn new() -> Self {
+            let ctx = egui::Context::default();
+            ctx.set_fonts(gridcraft_ui_egui::theme::pinned_font_definitions());
+            gridcraft_ui_egui::theme::apply(&ctx, false);
+            let mut session = Session::new();
+            session.new_workbook();
+            let mut app = SheetApp::new(session, Services::default());
+            app.use_prepared_fonts();
+            app.set_read_only(true);
+            let mut rig = Self { ctx, app, held: HeldInput::default(), host_read_only: true, now: 0.0, notices: Vec::new() };
+            rig.frames(4);
+            rig
+        }
+
+        /// The input hook, as `WebShell` runs it.
+        fn hook(&mut self, mut raw: egui::RawInput) -> egui::RawInput {
+            let notices = self.held.capture(&mut self.app, &self.ctx, &mut raw, self.host_read_only, self.now);
+            self.notices.extend(notices);
+            self.app.raw_input_hook(&self.ctx, &mut raw);
+            self.held.emitted(&self.ctx, &raw);
+            raw
+        }
+
+        fn raw(events: Vec<Event>) -> egui::RawInput {
+            let screen = egui::Rect::from_min_size(egui::Pos2::ZERO, egui::vec2(1000.0, 700.0));
+            egui::RawInput { screen_rect: Some(screen), events, ..Default::default() }
+        }
+
+        fn pass(&mut self, raw: egui::RawInput) {
+            let app = &mut self.app;
+            let mut out = self.ctx.run_ui(raw, |ui| {
+                app.logic(ui.ctx());
+                app.ui(ui);
+            });
+            out.textures_delta.clear(); // nothing consumes the atlas in a headless test
+        }
+
+        fn frame(&mut self, events: Vec<Event>) {
+            let raw = self.hook(Self::raw(events));
+            self.pass(raw);
+        }
+
+        fn frames(&mut self, count: usize) {
+            for _ in 0..count {
+                self.frame(Vec::new());
+            }
+        }
+
+        fn access(&mut self, read_only: bool) {
+            let notices = self.held.before_access(&mut self.app, self.now);
+            self.notices.extend(notices);
+            self.app.set_read_only(read_only);
+            self.host_read_only = self.app.is_read_only();
+            let notices = self.held.after_access(&mut self.app);
+            self.notices.extend(notices);
+        }
+
+        fn value(&self, cell: CellRef) -> String {
+            self.app.session.active().unwrap().wb.active().unwrap().input_text(cell)
+        }
+
+        fn document(&self) -> u64 {
+            self.app.session.active().unwrap().uid
+        }
+
+        fn dropped(&self) -> Vec<Reason> {
+            self.notices.iter().filter_map(|notice| if let Notice::Dropped(_, reason) = notice { Some(*reason) } else { None }).collect()
+        }
+
+        fn attempts(&self) -> Vec<Kind> {
+            self.notices.iter().filter_map(|notice| if let Notice::Attempt(_, kind) = notice { Some(*kind) } else { None }).collect()
+        }
+    }
+
+    const A1: CellRef = CellRef { row: 0, col: 0 };
+    const A2: CellRef = CellRef { row: 1, col: 0 };
+
+    fn key(key: Key, pressed: bool) -> Event {
+        Event::Key { key, physical_key: None, pressed, repeat: false, modifiers: egui::Modifiers::NONE }
+    }
+
+    fn typed(text: &str, k: Key) -> Vec<Event> {
+        vec![key(k, true), Event::Text(text.into()), key(k, false)]
+    }
+
+    fn press(k: Key) -> Vec<Event> {
+        vec![key(k, true), key(k, false)]
+    }
+
+    fn click(pos: egui::Pos2) -> Event {
+        Event::PointerButton { pos, button: egui::PointerButton::Primary, pressed: true, modifiers: egui::Modifiers::NONE }
+    }
+
+    #[test]
+    fn held_keys_write_nothing_until_the_unlock_and_then_everything_in_order() {
+        let mut rig = Rig::new();
+        rig.frame(typed("4", Key::Num4));
+        rig.frame(typed("2", Key::Num2));
+        rig.frame(press(Key::Enter));
+        rig.frame(typed("7", Key::Num7));
+        rig.frames(5);
+        assert_eq!(rig.notices, [Notice::Attempt(rig.document(), Kind::Key)], "one message, without content");
+        assert_eq!(rig.value(A1), "");
+        assert!(rig.app.editor.is_none() && !rig.app.has_pending_drafts() && !crate::draft_state::dirty(&rig.app));
+        assert_eq!(place(&rig.app).map(|pin| (pin.2, pin.3)), Some((0, 0)), "the selection waits too");
+        rig.access(false);
+        // Typed while the replay runs: goes behind it.
+        rig.frame(press(Key::Enter));
+        rig.frames(80);
+        assert_eq!(rig.value(A1), "42");
+        assert_eq!(rig.value(A2), "7");
+        assert!(!rig.held.replaying());
+        assert!(rig.dropped().is_empty(), "{:?}", rig.notices);
+        assert_eq!(rig.attempts(), [Kind::Key]);
+    }
+
+    #[test]
+    fn a_refusal_throws_the_input_away_and_says_so() {
+        let mut rig = Rig::new();
+        rig.frame(typed("9", Key::Num9));
+        rig.access(true);
+        assert_eq!(rig.dropped(), [Reason::Refused]);
+        rig.access(false);
+        rig.frames(20);
+        assert_eq!(rig.value(A1), "");
+        assert!(rig.app.editor.is_none());
+    }
+
+    #[test]
+    fn an_answer_after_the_time_limit_writes_nothing() {
+        let mut rig = Rig::new();
+        rig.frame(typed("9", Key::Num9));
+        rig.now = TIMEOUT_MS;
+        rig.access(false);
+        rig.frames(20);
+        assert_eq!(rig.dropped(), [Reason::Timeout]);
+        assert_eq!(rig.value(A1), "");
+        assert!(rig.app.editor.is_none());
+    }
+
+    #[test]
+    fn no_answer_is_reported_without_one() {
+        let mut rig = Rig::new();
+        rig.frame(press(Key::Delete));
+        rig.now = TIMEOUT_MS + 1.0;
+        rig.frame(Vec::new());
+        assert_eq!(rig.dropped(), [Reason::Timeout]);
+        rig.frame(press(Key::Delete));
+        assert_eq!(rig.attempts(), [Kind::Key, Kind::Key], "the next attempt is reported again");
+    }
+
+    #[test]
+    fn too_much_input_is_thrown_away() {
+        let mut rig = Rig::new();
+        rig.frame(vec![Event::Paste("x".repeat(MAX_BYTES + 1))]);
+        assert_eq!(rig.dropped(), [Reason::Limit]);
+        let mut rig = Rig::new();
+        rig.frame((0..=MAX_EVENTS).map(|_| Event::Text("a".into())).collect());
+        assert_eq!(rig.dropped(), [Reason::Limit]);
+        rig.access(false);
+        rig.frames(20);
+        assert_eq!(rig.value(A1), "");
+    }
+
+    #[test]
+    fn a_click_throws_held_input_away_so_it_never_lands_in_another_cell() {
+        let mut rig = Rig::new();
+        let pos = rig.app.grid.cells_rect.unwrap().center();
+        rig.frame(typed("9", Key::Num9));
+        rig.frame(vec![Event::PointerMoved(pos), click(pos)]);
+        assert_eq!(rig.dropped(), [Reason::Pointer]);
+        assert_eq!(rig.attempts(), [Kind::Key, Kind::Pointer]);
+        rig.access(false);
+        rig.frames(20);
+        assert!(rig.app.editor.is_none());
+        assert_eq!(rig.value(A1), "");
+    }
+
+    #[test]
+    fn another_cell_sheet_or_workbook_at_the_unlock_throws_the_input_away() {
+        for workbook in [false, true] {
+            let mut rig = Rig::new();
+            let document = rig.document();
+            rig.frame(typed("9", Key::Num9));
+            if workbook {
+                rig.app.session.new_workbook();
+            } else {
+                rig.app.session.execute("selection.set", json!({"cell":"C3"})).unwrap();
+            }
+            rig.access(false);
+            rig.frames(20);
+            assert_eq!(rig.notices.last(), Some(&Notice::Dropped(document, Reason::Document)), "workbook: {workbook}");
+            assert!(rig.app.editor.is_none());
+        }
+    }
+
+    #[test]
+    fn a_lock_lost_during_the_replay_stops_it() {
+        let mut rig = Rig::new();
+        for _ in 0..10 {
+            rig.frame(typed("1", Key::Num1));
+        }
+        rig.access(false);
+        rig.frames(2);
+        assert!(rig.held.replaying());
+        rig.access(true);
+        rig.frames(20);
+        assert_eq!(rig.dropped(), [Reason::Refused]);
+        assert!(!rig.held.replaying());
+        assert_eq!(rig.value(A1), "", "a half typed cell is a held draft, not a write");
+    }
+
+    #[test]
+    fn an_earlier_draft_is_never_typed_over() {
+        let mut rig = Rig::new();
+        rig.access(false);
+        rig.app.begin_edit(Some("mine".into()), false);
+        rig.access(true);
+        rig.frames(2);
+        rig.frame(typed("9", Key::Num9));
+        rig.frame(typed("9", Key::Num9));
+        assert_eq!(rig.attempts(), [Kind::Key]);
+        assert_eq!(rig.dropped(), [Reason::Draft]);
+        rig.access(false);
+        rig.frames(5);
+        assert_eq!(rig.app.editor.as_ref().unwrap().text, "mine");
+    }
+
+    #[test]
+    fn viewing_is_not_an_attempt() {
+        let mut rig = Rig::new();
+        for k in [Key::ArrowDown, Key::Tab, Key::PageDown, Key::Escape, Key::Enter, Key::Home] {
+            rig.frame(press(k));
+        }
+        let ctrl = egui::Modifiers { ctrl: true, command: true, ..Default::default() };
+        rig.frame(vec![Event::Copy, Event::Key { key: Key::F, physical_key: None, pressed: true, repeat: false, modifiers: ctrl }, Event::Text("f".into())]);
+        rig.app.dialog = None;
+        rig.frame(vec![Event::Key { key: Key::Space, physical_key: None, pressed: true, repeat: false, modifiers: egui::Modifiers::SHIFT }, Event::Text(" ".into())]);
+        rig.frame(vec![click(egui::pos2(5.0, 5.0))]);
+        assert!(rig.notices.is_empty(), "{:?}", rig.notices);
+    }
+
+    #[test]
+    fn a_writable_or_otherwise_read_only_workbook_is_left_alone() {
+        let mut rig = Rig::new();
+        rig.access(false);
+        rig.frame(typed("5", Key::Num5));
+        assert_eq!(rig.app.editor.as_ref().map(|editor| editor.text.as_str()), Some("5"));
+        let mut rig = Rig::new();
+        rig.host_read_only = false; // read-only for a reason the host did not set
+        rig.frame(typed("5", Key::Num5));
+        rig.frame(vec![click(rig.app.grid.cells_rect.unwrap().center())]);
+        assert!(rig.notices.is_empty() && matches!(rig.held.state, State::Idle));
+    }
+
+    #[test]
+    fn input_retained_by_a_hidden_tab_is_held_and_replayed_once() {
+        let mut rig = Rig::new();
+        rig.frame(typed("1", Key::Num1));
+        rig.access(false);
+        // Hidden: the hook runs, no pass does, eframe offers the same input in front of the next.
+        let first = rig.hook(Rig::raw(Vec::new()));
+        assert!(!first.events.is_empty(), "the step was offered");
+        let mut again = first.clone();
+        again.events.extend(typed("2", Key::Num2));
+        let raw = rig.hook(again);
+        assert_eq!(raw.events.len(), first.events.len(), "nothing offered twice, the newer keys wait behind");
+        rig.pass(raw);
+        rig.frames(20);
+        rig.frame(press(Key::Enter));
+        rig.frames(20);
+        assert_eq!(rig.value(A1), "12");
+        assert!(rig.dropped().is_empty(), "{:?}", rig.notices);
+    }
+}
