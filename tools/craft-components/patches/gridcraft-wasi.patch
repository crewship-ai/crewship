+        t.set(&format!("E{r}"), "=SUMIFS($C$2:$C$60,$B$2:$B$60,\"k\"&MOD(ROW(),7))+COUNTIFS($B$2:$B$60,\"K\"&MOD(ROW(),7),$A$2:$A$60,\">2\")");
+    }
+    crate::criteria_index::ANSWERED.with(|n| n.set(0));
+    t.calc.recalc_all(&mut t.wb);
+    let indexed = formula_values(&t);
+    assert!(crate::criteria_index::ANSWERED.with(std::cell::Cell::get) >= 29);
+    crate::criteria_index::OFF.with(|o| o.set(true));
+    t.calc.recalc_all(&mut t.wb);
+    crate::criteria_index::OFF.with(|o| o.set(false));
+    assert_eq!(indexed, formula_values(&t));
+    // An edit that changes the keys and the sums: the incremental pass agrees with the walk.
