+    let shared = rezip(&parts);
+    let (wb, _) = read_xlsx(&shared).unwrap();
+    let saved = unzip(&write_xlsx(&wb).unwrap());
+    let caches = saved.keys().filter(|n| n.starts_with("xl/pivotCache/pivotCacheDefinition") && n.ends_with(".xml")).count();
+    let tables = saved.keys().filter(|n| n.starts_with("xl/pivotTables/pivotTable") && n.ends_with(".xml")).count();
+    assert_eq!((caches, tables), (1, 3));
