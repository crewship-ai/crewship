+
+/// `(position of the value, id)` of each `numFmtId="…"` attribute.
+fn num_fmt_ids(xml: &str) -> impl Iterator<Item = (usize, u32)> + '_ {
+    attr_positions(xml, "numFmtId")
+}
+
+/// `(position of the value, value)` of each numeric attribute of this name.
+fn attr_positions<'a>(xml: &'a str, name: &str) -> impl Iterator<Item = (usize, u32)> + 'a {
+    let key = format!(" {name}=\"");
+    let len = key.len();
+    xml.match_indices(&key).map(|(at, _)| at).collect::<Vec<_>>().into_iter().filter_map(move |at| {
+        let start = at + len;
+        let end = start + xml[start..].find('"')?;
+        xml[start..end].parse::<u32>().ok().map(|id| (start, id))
+    })
+}
+
+fn attr_u32s<'a>(xml: &'a str, name: &str) -> impl Iterator<Item = u32> + 'a {
+    attr_positions(xml, name).map(|(_, v)| v)
+}
+
+/// Each `dxfId` renumbered by `map`; one the file's styles did not have is removed with its
+/// attribute, so no format points at a style it never had.
+fn remap_dxf_ids(xml: &str, map: &HashMap<u32, u32>) -> String {
+    let mut out = String::with_capacity(xml.len());
+    let mut copied = 0;
+    const KEY: &str = " dxfId=\"";
+    for (start, id) in attr_positions(xml, "dxfId").collect::<Vec<_>>() {
+        let end = start + id.to_string().len();
+        match map.get(&id) {
+            Some(new) => {
+                out.push_str(&xml[copied..start]);
+                out.push_str(&new.to_string());
+                copied = end;
+            }
+            None => {
+                out.push_str(&xml[copied..start - KEY.len()]);
+                copied = end + 1;
+            }
+        }
+    }
+    out.push_str(&xml[copied..]);
+    out
+}
+
+/// The part with each custom `numFmtId` (164 and up) renumbered to the id the written styles
+/// part gives its format code; an id the file's styles did not define becomes General (0).
+fn remap_num_fmts(xml: &str, num_fmts: &HashMap<u32, String>, fmt_id: &dyn Fn(&str) -> Option<u32>) -> String {
+    let mut out = String::with_capacity(xml.len());
+    let mut copied = 0;
+    for (start, id) in num_fmt_ids(xml).collect::<Vec<_>>() {
+        if id < 164 {
+            continue;
+        }
+        let new = num_fmts.get(&id).and_then(|code| fmt_id(code)).unwrap_or(0);
+        let end = start + id.to_string().len();
+        out.push_str(&xml[copied..start]);
+        out.push_str(&new.to_string());
+        copied = end;
+    }
+    out.push_str(&xml[copied..]);
+    out
+}
