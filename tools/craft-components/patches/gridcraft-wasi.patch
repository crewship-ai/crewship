+//! Phase timings for opening a workbook, written to stderr when `GRIDCRAFT_TIMINGS` is set.
+//! Diagnostic only: no timing is kept, and nothing is written without the variable.
+
+use std::sync::OnceLock;
+
+fn enabled() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    #[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+    let on = *ON.get_or_init(|| std::env::var_os("GRIDCRAFT_TIMINGS").is_some());
+    #[cfg(all(target_arch = "wasm32", target_os = "unknown"))]
+    let on = *ON.get_or_init(|| false);
+    on
+}
+
+/// Now, when timings are on.
+#[allow(clippy::disallowed_methods)] // a phase timer for GRIDCRAFT_TIMINGS only; no result depends on it
+pub fn start() -> Option<web_time::Instant> {
+    enabled().then(web_time::Instant::now)
+}
+
+/// Writes `phase` and the milliseconds since `started`.
+pub fn lap(phase: &str, started: Option<web_time::Instant>) {
+    if let Some(t) = started {
+        eprintln!("gridcraft-timings {phase} {:.1} ms", t.elapsed().as_secs_f64() * 1000.0);
+    }
+}
