diff --git a/crates/ui-egui/src/c1_commands.rs b/crates/ui-egui/src/c1_commands.rs
new file mode 100644
index 0000000..5a0d054
--- /dev/null
+++ b/crates/ui-egui/src/c1_commands.rs
@@ -0,0 +1,264 @@
+//! Default-off C1 LOCAL command/render seam. Callers own SQL receipts, transport,
+//! current permissions, operation identity and reconciliation. No local Saved.
+use crate::WordApp;
+use serde_json::{Value, json};
+use std::{
+    cell::{Cell, RefCell},
+    rc::Rc,
+};
+use wordcraft_doc::{Document, StoryRef};
+use wordcraft_engine::{Session, io as native_io};
+const MAX: usize = 4 * 1024 * 1024;
+/// Validate the borrowed display input before any copy or selection parse.
+/// Peer data has no authority to supply an own-operation selection.
+pub fn validate_confirmed_selection_input(raw: &str, acknowledges_pending: bool) -> Result<(), String> {
+    if raw.len() > 2048 || (!acknowledges_pending && !raw.is_empty()) {
+        return Err("invalid C1 selection input".into());
+    }
+    Ok(())
+}
+type Capture = Box<dyn Fn(&str) -> Result<(), String>>;
+pub struct CommandBridge {
+    ids: RefCell<Vec<String>>,
+    capture: Capture,
+    can_edit: Box<dyn Fn() -> bool>,
+    pending: Cell<bool>,
+    stopped: Cell<bool>,
+    proposal: RefCell<Option<Value>>,
+}
+pub fn native_document(raw: &str) -> Result<Document, String> {
+    if raw.is_empty() || raw.len() > MAX {
+        return Err("invalid C1 native size".into());
+    }
+    let before: Value = serde_json::from_str(raw).map_err(|_| "invalid C1 native JSON")?;
+    let doc = native_io::open_bytes("state.json", raw.as_bytes()).map_err(|_| "invalid C1 native document")?;
+    let saved = native_io::save_bytes("state.json", &doc).map_err(|_| "invalid C1 native document")?;
+    let after: Value = serde_json::from_slice(&saved).map_err(|_| "invalid C1 native document")?;
+    if before != after || doc.body.is_empty() || doc.body.len() > 4096 || doc.body.iter().any(|b| b.as_para().is_none()) {
+        return Err("lossy or unsupported C1 native document".into());
+    }
+    Ok(doc)
+}
+pub fn validate_ids(raw: &str, doc: &Document) -> Result<Vec<String>, String> {
+    if raw.len() > 1024 * 1024 {
+        return Err("invalid C1 IDs".into());
+    }
+    let ids: Vec<String> = serde_json::from_str(raw).map_err(|_| "invalid C1 IDs")?;
+    if ids.len() != doc.body.len()
+        || ids.iter().any(|s| s.is_empty() || s.len() > 200 || s.contains('\0'))
+        || ids.iter().collect::<std::collections::BTreeSet<_>>().len() != ids.len()
+    {
+        return Err("invalid C1 IDs".into());
+    }
+    Ok(ids)
+}
+impl CommandBridge {
+    pub fn new(doc: &Document, stable_ids_json: &str, can_edit: Box<dyn Fn() -> bool>, capture: Capture) -> Result<Rc<Self>, String> {
+        Ok(Rc::new(Self {
+            ids: RefCell::new(validate_ids(stable_ids_json, doc)?),
+            can_edit,
+            capture,
+            pending: Cell::new(false),
+            stopped: Cell::new(false),
+            proposal: RefCell::new(None),
+        }))
+    }
+    pub fn stopped(&self) -> bool {
+        self.stopped.get()
+    }
+    pub fn pending(&self) -> bool {
+        self.pending.get()
+    }
+    pub fn stop(&self) {
+        self.stopped.set(true);
+    }
+    pub fn stable_ids_json(&self) -> Result<String, String> {
+        serde_json::to_string(&*self.ids.borrow()).map_err(|_| "invalid C1 IDs".into())
+    }
+    fn forward(&self, session: &Session, registry_id: &str, params: &Value) -> Result<Value, String> {
+        if self.stopped.get() || self.pending.get() || !(self.can_edit)() {
+            return Err("C1 command unavailable".into());
+        }
+        if matches!(registry_id, "edit.undo" | "participant.undo") {
+            return Err("Undo is not available in this test editor".into());
+        }
+        let command = if registry_id == "edit.undo" { "participant.undo" } else { registry_id };
+        if !matches!(
+            command,
+            "document.read"
+                | "text.insert"
+                | "text.delete"
+                | "text.backspace"
+                | "text.newParagraph"
+                | "format.bold"
+                | "format.font"
+                | "format.size"
+                | "para.align"
+                | "participant.undo"
+        ) || session.registry.get(registry_id).is_none()
+        {
+            return Err("unsupported C1 command".into());
+        }
+        let target = if matches!(command, "document.read" | "participant.undo") {
+            Value::Null
+        } else {
+            let (start, end) = session.sel.ordered();
+            if start.story != StoryRef::Body || end.story != StoryRef::Body || start.path.0.len() != 1 || start.path != end.path {
+                return Err("unsupported C1 selection".into());
+            }
+            let index = start.path.0[0] as usize;
+            let para = session.doc.body.get(index).and_then(|b| b.as_para()).ok_or("unsupported C1 selection")?;
+            if start.off > end.off || !para.text.is_char_boundary(start.off) || !para.text.is_char_boundary(end.off) {
+                return Err("invalid UTF8 C1 selection".into());
+            }
+            json!({"block_id":self.ids.borrow().get(index).ok_or("invalid C1 block ID")?,"unit":"utf8_bytes","start":start.off,"end":end.off})
+        };
+        let proposal = json!({"registry_id":registry_id,"command":command,"params":params,"target":target});
+        let raw = serde_json::to_string(&proposal).map_err(|_| "invalid C1 command")?;
+        if raw.len() > 65536 {
+            return Err("C1 command capacity".into());
+        }
+        // Reserve the one original BEFORE entering JS so reentrant input is
+        // denied. Capture error/panic is uncertain: retain it and stop, never
+        // claim refusal or silently accept a successor original.
+        *self.proposal.borrow_mut() = Some(proposal);
+        self.pending.set(true);
+        if (self.capture)(&raw).is_err() {
+            self.stop();
+            return Err("C1 command capture failed".into());
+        }
+        if command == "document.read" {
+            self.proposal.borrow_mut().take();
+            self.pending.set(false);
+        }
+        Ok(json!({"command_pending":command!="document.read"}))
+    }
+}
+fn local_navigation(session: &Session, id: &str) -> bool {
+    session.registry.get(id).is_some_and(|s| !s.mutates)
+        && matches!(
+            id,
+            "caret.left"
+                | "caret.right"
+                | "caret.up"
+                | "caret.down"
+                | "caret.wordLeft"
+                | "caret.wordRight"
+                | "caret.home"
+                | "caret.end"
+                | "caret.docStart"
+                | "caret.docEnd"
+                | "caret.set"
+                | "select.all"
+                | "select.range"
+                | "select.collapse"
+                | "select.word"
+                | "select.paragraph"
+                | "view.zoomIn"
+                | "view.zoomOut"
+                | "view.zoom100"
+                | "view.marks"
+                | "view.state"
+                | "format.state"
+                | "document.selection"
+                | "document.layout"
+        )
+}
+impl WordApp {
+    pub fn attach_c1_commands(&mut self, bridge: Rc<CommandBridge>) -> Result<(), String> {
+        if self.c1_commands.is_some() || self.session.path.is_some() || self.session.dirty {
+            return Err("C1 requires a fresh native session".into());
+        }
+        self.c1_commands = Some(bridge);
+        self.autosave = false;
+        Ok(())
+    }
+    pub(crate) fn dispatch_c1(&mut self, id: &str, params: &Value) -> Option<Result<Value, String>> {
+        let bridge = self.c1_commands.clone()?;
+        if local_navigation(&self.session, id) {
+            return None;
+        }
+        let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| bridge.forward(&self.session, id, params))).unwrap_or_else(|_| {
+            bridge.stop();
+            Err("C1 command capture stopped".into())
+        });
+        if result.is_err() && bridge.pending() && !bridge.stopped() {
+            self.status("Another command is pending. This input was not accepted.");
+        } else if result.is_err() {
+            self.status("This command is not available in collaborative mode.");
+        } else {
+            self.status("Waiting for the host command result.");
+        }
+        Some(result)
+    }
+    /// Render only after caller validated canonical native bytes and the original
+    /// pending outcome. Peer-only data passes acknowledges_pending=false, retains
+    /// the original and keeps further edits blocked. Only an exact own committed
+    /// receipt permits true; this display flag is not a host authority proof.
+    /// This method grants no permissions and does not emit Saved or SQL ACK.
+    pub fn project_c1_confirmed(
+        &mut self,
+        native_json: &str,
+        stable_ids_json: &str,
+        acknowledges_pending: bool,
+        confirmed_selection_json: &str,
+    ) -> Result<(), String> {
+        validate_confirmed_selection_input(confirmed_selection_json, acknowledges_pending)?;
+        let bridge = self.c1_commands.clone().ok_or("C1 not attached")?;
+        if bridge.stopped.get() {
+            return Err("C1 stopped".into());
+        }
+        let doc = native_document(native_json)?;
+        let new_ids = validate_ids(stable_ids_json, &doc)?;
+        let old_ids = bridge.ids.borrow().clone();
+        let previous = self.session.sel.clone();
+        let map = |pos: &wordcraft_doc::Pos| {
+            let old = pos.path.0.first().copied().unwrap_or(0) as usize;
+            let index = old_ids.get(old).and_then(|id| new_ids.iter().position(|v| v == id)).unwrap_or(old.min(doc.body.len() - 1));
+            let mut result = pos.clone();
+            result.story = StoryRef::Body;
+            result.path = wordcraft_doc::Path(vec![index as u32]);
+            let text = &doc.body[index].as_para().ok_or("unsupported C1 projection")?.text;
+            result.off = pos.off.min(text.len());
+            while !text.is_char_boundary(result.off) {
+                result.off = result.off.saturating_sub(1);
+            }
+            Ok::<_, String>(result)
+        };
+        let mut anchor = map(&previous.anchor)?;
+        let mut focus = map(&previous.focus)?;
+        if acknowledges_pending && bridge.pending.get() {
+            // Never infer caret from input length: AutoCorrect, deletion and Enter
+            // have native semantics. Caller supplies the ACTUAL committed engine
+            // selection result, bound to the same own operation receipt.
+            let confirmed: wordcraft_engine::Selection =
+                serde_json::from_str(confirmed_selection_json).map_err(|_| "missing confirmed C1 selection")?;
+            for pos in [&confirmed.anchor, &confirmed.focus] {
+                if pos.story != StoryRef::Body || pos.path.0.len() != 1 {
+                    return Err("invalid confirmed C1 selection".into());
+                }
+                let para = doc.body.get(pos.path.0[0] as usize).and_then(|p| p.as_para()).ok_or("invalid confirmed C1 selection")?;
+                if !para.text.is_char_boundary(pos.off) {
+                    return Err("invalid confirmed C1 selection".into());
+                }
+            }
+            anchor = confirmed.anchor;
+            focus = confirmed.focus;
+        }
+        // All checks precede native content/ID replacement; retain Session identity,
+        // path and native history. No local engine mutation or file import runs.
+        let dirty = self.session.dirty;
+        self.session.doc = doc;
+        self.session.sel.anchor = anchor;
+        self.session.sel.focus = focus;
+        self.session.touch();
+        self.session.dirty = dirty;
+        self.session.relayout();
+        *bridge.ids.borrow_mut() = new_ids;
+        if acknowledges_pending {
+            bridge.proposal.borrow_mut().take();
+            bridge.pending.set(false);
+        }
+        Ok(())
+    }
+}
