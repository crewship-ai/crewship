diff --git a/apps/wordcraft-web/src/c1.rs b/apps/wordcraft-web/src/c1.rs
new file mode 100644
index 0000000..df5be4e
--- /dev/null
+++ b/apps/wordcraft-web/src/c1.rs
@@ -0,0 +1,113 @@
+//! LOCAL C1 display/command adapter only. The authenticated parent validates
+//! actual SQL receipts; callbacks are never credentials or Saved authority.
+use js_sys::Function;
+use std::{
+    cell::{Cell, RefCell},
+    rc::Rc,
+};
+use wasm_bindgen::prelude::*;
+use wordcraft_doc::Document;
+use wordcraft_ui_egui::c1_commands::{CommandBridge, native_document, validate_confirmed_selection_input, validate_ids};
+thread_local! { static ATTACHED: Cell<bool> = const { Cell::new(false) }; }
+struct Projection {
+    pub raw: String,
+    pub ids: String,
+    pub acknowledges_pending: bool,
+    pub selection: String,
+}
+pub(crate) struct State {
+    pub initial: Document,
+    pub bridge: Rc<CommandBridge>,
+    pending: RefCell<Option<Projection>>,
+    failed: Function,
+    failure_reported: Cell<bool>,
+}
+fn callback(value: &JsValue, name: &str) -> Result<Function, JsValue> {
+    js_sys::Reflect::get(value, &JsValue::from_str(name))?.dyn_into::<Function>().map_err(|_| JsValue::from_str("missing C1 callback"))
+}
+#[wasm_bindgen]
+pub struct WordCraftC1Handle {
+    state: Rc<State>,
+}
+#[wasm_bindgen]
+impl WordCraftC1Handle {
+    /// Caller first verifies canonical SQL projection and exact own operation
+    /// receipt. Peer-only projection passes false and cannot unblock a local write.
+    pub fn project_confirmed(
+        &self,
+        native_json: &str,
+        ids_json: &str,
+        acknowledges_pending: bool,
+        confirmed_selection_json: &str,
+    ) -> Result<(), JsValue> {
+        validate_confirmed_selection_input(confirmed_selection_json, acknowledges_pending)
+            .map_err(|_| JsValue::from_str("invalid C1 selection input"))?;
+        if self.state.bridge.stopped() {
+            return Err(JsValue::from_str("C1 stopped"));
+        }
+        let doc = native_document(native_json).map_err(|_| JsValue::from_str("invalid C1 native projection"))?;
+        validate_ids(ids_json, &doc).map_err(|_| JsValue::from_str("invalid C1 projection IDs"))?;
+        if self.state.pending.borrow().is_some() {
+            return Err(JsValue::from_str("C1 projection awaiting application"));
+        }
+        *self.state.pending.borrow_mut() =
+            Some(Projection { raw: native_json.into(), ids: ids_json.into(), acknowledges_pending, selection: confirmed_selection_json.into() });
+        Ok(())
+    }
+    pub fn stop(&self) {
+        self.state.bridge.stop();
+    }
+    pub fn command_pending(&self) -> bool {
+        self.state.bridge.pending()
+    }
+    /// Read-only queue observation, never a SQL receipt or paint acknowledgement.
+    pub fn projection_pending(&self) -> bool {
+        self.state.pending.borrow().is_some()
+    }
+}
+impl State {
+    pub fn apply_projection(&self, app: &mut wordcraft_ui_egui::WordApp) {
+        if let Some(p) = self.pending.borrow_mut().take() {
+            if app.project_c1_confirmed(&p.raw, &p.ids, p.acknowledges_pending, &p.selection).is_err() {
+                self.bridge.stop();
+                if !self.failure_reported.replace(true) {
+                    let _ = self.failed.call1(&JsValue::NULL, &JsValue::from_str("native-projection-failed"));
+                }
+            }
+        }
+        if self.bridge.stopped() && !self.failure_reported.replace(true) {
+            let _ = self.failed.call1(&JsValue::NULL, &JsValue::from_str("connection_unavailable"));
+        }
+    }
+}
+/// One attached C1 renderer, selected by this separate bundle's explicit mode.
+/// No Yjs producer, document import endpoint or alternate parent channel exists.
+#[wasm_bindgen]
+pub fn start_c1_commands(native_json: &str, ids_json: &str, callbacks: JsValue) -> Result<WordCraftC1Handle, JsValue> {
+    if !super::web::c1_mode() {
+        return Err(JsValue::from_str("C1 mode not selected"));
+    }
+    let initial = native_document(native_json).map_err(|_| JsValue::from_str("invalid C1 native document"))?;
+    let gate = callback(&callbacks, "can_edit")?;
+    let capture = callback(&callbacks, "command")?;
+    let failed = callback(&callbacks, "failed")?;
+    let bridge = CommandBridge::new(
+        &initial,
+        ids_json,
+        Box::new(move || gate.call0(&JsValue::NULL).ok().and_then(|v| v.as_bool()) == Some(true)),
+        Box::new(move |raw| {
+            if capture.call1(&JsValue::NULL, &JsValue::from_str(raw)).ok().and_then(|v| v.as_bool()) == Some(true) {
+                Ok(())
+            } else {
+                Err("C1 command capture failed".into())
+            }
+        }),
+    )
+    .map_err(|_| JsValue::from_str("invalid C1 command bridge"))?;
+    let state = Rc::new(State { initial, bridge, pending: RefCell::new(None), failed, failure_reported: Cell::new(false) });
+    if ATTACHED.with(|active| active.replace(true)) {
+        return Err(JsValue::from_str("C1 already attached"));
+    }
+    super::web::start_c1(state.clone());
+    Ok(WordCraftC1Handle { state })
+}
