+#[cfg(test)]
+mod c1_host_context_tests {
+    use crate::Session;
+    use wordcraft_doc::Document;
+    use serde_json::json;
+    const A: &str = "2001-02-03T04:05:06Z";
+    const B: &str = "2002-03-04T05:06:07Z";
+    #[test]
+    fn original_records_receive_context_before_command_and_old_records_stay() {
+        let mut s = Session::new(Document::new());
+        s.author = "original".into();
+        s.run("text.insert", &json!({"text":"target"})).unwrap();
+        let id = s
+            .run_with_host_context("review.newComment", &json!({"text":"one"}), "Alice", A)
+            .unwrap()["id"]
+            .as_u64()
+            .unwrap() as u32;
+        let first = serde_json::to_value(&s.doc.comments[&id]).unwrap();
+        assert_eq!(first["author"], "Alice");
+        assert_eq!(first["date"], A);
+        assert_eq!(first["dateUtc"], A);
+        assert_eq!(s.author, "original");
+        s.run_with_host_context("review.newComment", &json!({"text":"two"}), "Bob", B)
+            .unwrap();
+        assert_eq!(serde_json::to_value(&s.doc.comments[&id]).unwrap(), first);
+        assert_eq!(s.author, "original");
+        assert_ne!(super::now_iso(), A);
+    }
+    #[test]
+    fn invalid_and_engine_error_leave_author_clock_and_document_untouched() {
+        let mut s = Session::new(Document::new());
+        s.author = "original".into();
+        let doc = serde_json::to_value(&s.doc).unwrap();
+        for bad in [
+            "not-time",
+            "2001-99-03T04:05:06Z",
+            "2001-02-03T04:05:06+00:00",
+        ] {
+            assert!(
+                s.run_with_host_context("text.insert", &json!({"text":"bad"}), "wrong", bad)
+                    .is_err()
+            );
+        }
+        assert!(
+            s.run_with_host_context("unknown.c1.command", &json!({}), "wrong", A)
+                .is_err()
+        );
+        assert_eq!(s.author, "original");
+        assert_eq!(serde_json::to_value(&s.doc).unwrap(), doc);
+        assert_ne!(super::now_iso(), A);
+    }
+    #[test]
+    fn nested_panic_restores_author_clock_and_does_not_affect_another_thread() {
+        let mut s = Session::new(Document::new());
+        s.author = "original".into();
+        s.with_host_command_context("Alice", A, |s| {
+            assert_eq!(s.author, "Alice");
+            assert_eq!(super::now_iso(), A);
+            std::thread::spawn(|| assert_ne!(super::now_iso(), A))
+                .join()
+                .unwrap();
+            let failure = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+                s.with_host_command_context("Bob", B, |s| {
+                    assert_eq!(s.author, "Bob");
+                    assert_eq!(super::now_iso(), B);
+                    panic!("c1 synthetic unwind")
+                })
+            }));
+            assert!(failure.is_err());
+            assert_eq!(s.author, "Alice");
+            assert_eq!(super::now_iso(), A);
+            s.with_host_command_context("Bob", B, |s| {
+                assert_eq!(s.author, "Bob");
+                assert_eq!(super::now_iso(), B)
+            });
+            assert_eq!(s.author, "Alice");
+            assert_eq!(super::now_iso(), A);
+        });
+        assert_eq!(s.author, "original");
+        assert_ne!(super::now_iso(), A);
+        assert_ne!(super::now_iso(), B);
+    }
+}
