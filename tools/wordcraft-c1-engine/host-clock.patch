+std::thread_local! {
+ static HOST_COMMAND_CLOCK: std::cell::RefCell<Option<String>> = const { std::cell::RefCell::new(None) };
+}
+// Scope includes nested commands; restore on normal return AND unwinding.
+pub(crate) fn with_host_command_clock<T>(time: &str, run: impl FnOnce() -> T) -> T {
+    struct Restore(Option<String>);
+    impl Drop for Restore {
+        fn drop(&mut self) {
+            HOST_COMMAND_CLOCK.with(|clock| {
+                clock.replace(self.0.take());
+            });
+        }
+    }
+    let _restore = Restore(HOST_COMMAND_CLOCK.with(|clock| clock.replace(Some(time.to_owned()))));
+    run()
+}
