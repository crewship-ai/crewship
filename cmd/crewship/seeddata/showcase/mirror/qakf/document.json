  {
   "type": "paragraph",
   "attrs": {
    "id": "prehled-mje9hk5kec2-2094"
   },
   "content": [
    {
     "type": "text",
     "text": "Python:"
    }
   ]
  },
  {
   "type": "codeBlock",
   "attrs": {
    "id": "prehled-mje9hk5kec2-2102",
    "language": "python"
   },
   "content": [
    {
     "type": "text",
     "text": "from dataclasses import dataclass\n\n@dataclass\nclass Task:\n    crew: str\n    done: int\n    failed: int\n\n    @property\n    def success_rate(self) -> float:\n        total = self.done + self.failed\n        return self.done / total if total else 0.0\n\nprint(f\"{Task('Support', 42, 3).success_rate:.0%}\")  # 93%"
    }
   ]
  },
  {
   "type": "paragraph",
   "attrs": {
    "id": "prehled-mje9hk5kec2-2407"
   },
   "content": [
    {
     "type": "text",
     "text": "Go:"
    }
   ]
  },
  {
   "type": "codeBlock",
   "attrs": {
    "id": "prehled-mje9hk5kec2-2411",
    "language": "go"
   },
   "content": [
    {
     "type": "text",
     "text": "package main\n\nimport \"fmt\"\n\ntype Task struct {\n\tCrew   string\n\tDone   int\n\tFailed int\n}\n\nfunc (t Task) SuccessRate() float64 {\n\ttotal := t.Done + t.Failed\n\tif total == 0 {\n\t\treturn 0\n\t}\n\treturn float64(t.Done) / float64(total)\n}\n\nfunc main() {\n\tfmt.Printf(\"%.0f%%\\n\", Task{\"Support\", 42, 3}.SuccessRate()*100)\n}"
    }
   ]
  },
  {
   "type": "paragraph",
   "attrs": {
    "id": "prehled-mje9hk5kec2-2723"
   },
   "content": [
