  {
   "type": "codeBlock",
   "attrs": {
    "id": "prehled-mje9hk5kec2-2735",
    "language": "typescript"
   },
   "content": [
    {
     "type": "text",
     "text": "type Task = { crew: string; done: number; failed: number };\n\nconst successRate = (t: Task): number =>\n  t.done + t.failed === 0 ? 0 : t.done / (t.done + t.failed);"
    }
   ]
  },
