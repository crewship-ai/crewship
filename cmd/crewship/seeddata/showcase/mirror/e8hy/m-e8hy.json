{"entrypoint": "index.html", "files": [{"path": "index.html", "media_type": "text/html", "content": "<!doctype html><html><head><meta charset=utf8><meta name=viewport content=\"width=device-width,initial-scale=1,viewport-fit=cover\"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>\n<title>Template Crewship Showcase</title>\n<meta name=\"claude:viewport-fit-sides\" content=\"cover\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700&family=IBM+Plex+Sans:wght@400;600&family=JetBrains+Mono:wght@400;600&display=swap\">\n<style>\n/* Layout: one sticky tab bar, one stage per feature, each stage = demo on the left, short \"co to umí\" on the right */\n:root {\n  --bg: #E9EEF2; --panel: #F8FAFB; --ink: #0E1B2A; --muted: #4B5B6C; --line: #CBD5DE;\n  --accent: #D9692B; --accent-ink: #FFFFFF; --sea: #2B6C8F; --sea-2: #9CC3D6;\n  --display: \"Bricolage Grotesque\", \"IBM Plex Sans\", Arial, sans-serif;\n  --body: \"IBM Plex Sans\", Arial, sans-serif;\n  --mono: \"JetBrains Mono\", \"Courier New\", monospace;\n}\n@media (prefers-color-scheme: dark) { :root:not([data-theme=\"light\"]) {\n  --bg: #0A141F; --panel: #111F2E; --ink: #E7EDF2; --muted: #9DB0C2; --line: #24384D;\n  --accent: #F0844A; --accent-ink: #0A141F; --sea: #5FA6CC; --sea-2: #1E4A63; color-scheme: dark } }\n:root[data-theme=\"dark\"] {\n  --bg: #0A141F; --panel: #111F2E; --ink: #E7EDF2; --muted: #9DB0C2; --line: #24384D;\n  --accent: #F0844A; --accent-ink: #0A141F; --sea: #5FA6CC; --sea-2: #1E4A63; color-scheme: dark }\nbody { background: var(--bg); color: var(--ink); font: 15px/1.55 var(--body); }\n.wrap { max-width: 1120px; margin: 0 auto; padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); padding-block: 32px 64px; display: flex; flex-direction: column; gap: 28px; }\nheader h1 { font: 700 clamp(32px, 6vw, 56px)/1 var(--display); margin: 0; text-wrap: balance; letter-spacing: -0.02em; }\nheader p { margin: 10px 0 0; color: var(--muted); max-width: 62ch; }\n.eyebrow { font: 600 12px/1 var(--mono); letter-spacing: .14em; text-transform: uppercase; color: var(--accent); }\nbody::before { content: \"\"; position: fixed; inset: 0 0 auto; height: env(safe-area-inset-top, 0px); z-index: 10; background: var(--bg); }\nnav { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 5; background: var(--bg); padding-block: 8px; display: flex; gap: 6px; flex-wrap: wrap; border-bottom: 1px solid var(--line); }\nnav a { font: 600 14px/1 var(--body); color: var(--muted); text-decoration: none; padding: 10px 14px; border-radius: 999px; }\nnav a:hover { color: var(--ink); }\nnav a[aria-current=\"page\"] { background: var(--ink); color: var(--bg); }\na:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }\n.stage { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 24px; align-items: start; }\n@media (max-width: 760px) { .stage { grid-template-columns: minmax(0, 1fr); } }\n.demo { background: var(--panel); border: 1px solid var(--line); border-radius: 14px; padding: 20px; min-width: 0; }\n.about h2 { font: 700 28px/1.1 var(--display); margin: 8px 0 10px; text-wrap: balance; }\n.about p { margin: 0 0 10px; color: var(--muted); }\n.about ul { margin: 0; padding-left: 18px; color: var(--muted); display: flex; flex-direction: column; gap: 6px; }\n.about b { color: var(--ink); }\n#ship { width: 100%; aspect-ratio: 16 / 10; max-width: 100%; display: block; border-radius: 10px; cursor: grab; touch-action: none; }\n.hint { font: 12px/1.4 var(--mono); color: var(--muted); margin-top: 10px; }\n.mermaid-box { overflow-x: auto; }\n.pair-ctl { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }\n.pair-ctl label { display: flex; flex-direction: column; gap: 4px; font: 600 12px/1 var(--mono); color: var(--muted); }\nselect, input[type=\"search\"] { font: 15px var(--body); color: var(--ink); background: var(--bg); border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; min-height: 44px; }\n.swatches { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 8px; margin-bottom: 16px; }\n.sw { height: 72px; border-radius: 10px; border: 1px solid var(--line); cursor: pointer; padding: 0; }\n.sw[aria-pressed=\"true\"] { outline: 3px solid var(--ink); outline-offset: 2px; }\n.specimen { border-radius: 12px; padding: 24px; display: flex; flex-direction: column; gap: 8px; }\n.specimen .big { font-size: clamp(28px, 5vw, 44px); line-height: 1.05; text-wrap: balance; }\n.specimen .small { font-size: 15px; max-width: 52ch; }\n.contrast { font: 12px/1 var(--mono); margin-top: 10px; color: var(--muted); }\n.chips { display: flex; gap: 6px; flex-wrap: wrap; margin: 12px 0; }\n.chip { font: 600 13px/1 var(--body); padding: 10px 14px; border-radius: 999px; border: 1px solid var(--line); background: transparent; color: var(--ink); cursor: pointer; min-height: 40px; }\n.chip[aria-pressed=\"true\"] { background: var(--ink); color: var(--bg); border-color: var(--ink); }\n.list { display: flex; flex-direction: column; gap: 8px; }\n.row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 4px 12px; padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); }\n.row .t { font-weight: 600; min-width: 0; }\n.row .m { font: 12px/1.4 var(--mono); color: var(--muted); grid-column: 1 / -1; }\n.pill { font: 600 12px/1 var(--body); padding: 6px 10px; border-radius: 999px; align-self: start; }\n.pill.work { background: color-mix(in srgb, var(--sea) 18%, transparent); color: var(--sea); }\n.pill.rev { background: color-mix(in srgb, var(--accent) 18%, transparent); color: var(--accent); }\n.pill.done { background: color-mix(in srgb, #2F8A5B 20%, transparent); color: #3FA36F; }\n.empty { color: var(--muted); padding: 12px 0; }\n.mail { border: 1px solid var(--line); border-radius: 12px; overflow: hidden; background: var(--bg); }\n.mail-h { padding: 12px 16px; border-bottom: 1px solid var(--line); font: 13px/1.6 var(--mono); color: var(--muted); overflow-wrap: anywhere; }\n.mail-h b { color: var(--ink); font-weight: 600; }\n.mail-b { padding: 20px 16px; }\n.mail-b h3 { font: 700 22px/1.2 var(--display); margin: 0 0 10px; }\n.mail-b p { margin: 0 0 12px; max-width: 60ch; }\n.mail-b table { border-collapse: collapse; width: 100%; font-variant-numeric: tabular-nums; margin: 6px 0 14px; }\n.mail-b td, .mail-b th { text-align: left; padding: 8px 6px; border-bottom: 1px solid var(--line); }\n.mail-b td:last-child, .mail-b th:last-child { text-align: right; }\n.btn { font: 600 14px/1 var(--body); padding: 12px 16px; min-height: 44px; border-radius: 10px; border: none; background: var(--accent); color: var(--accent-ink); cursor: pointer; }\n.btn.ghost { background: transparent; color: var(--ink); border: 1px solid var(--line); }\n.mail-actions { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 14px; align-items: center; }\n#copied { font: 12px var(--mono); color: var(--muted); }\ntextarea#mailtext { width: 100%; box-sizing: border-box; min-height: 120px; font: 12px/1.5 var(--mono); color: var(--ink); background: var(--bg); border: 1px solid var(--line); border-radius: 10px; padding: 10px; margin-top: 10px; }\n@media (prefers-reduced-motion: reduce) { * { transition: none !important; } }\n</style>\n\n<div class=\"wrap\">\n  <header>\n    <div class=\"eyebrow\">Template · Claude Artifacts</div>\n    <h1>Template Crewship Showcase</h1>\n    <p>Jedna stránka, pět věcí, které běžná HTML artefakt stránka zvládne: 3D scénu, diagram, párování barev a písma, filtry a e-mail. Všechno je klikací.</p>\n  </header>\n\n  <nav aria-label=\"Ukázky\">\n    <a href=\"#model-3d\" data-tab=\"model-3d\">3D objekt</a>\n    <a href=\"#diagram\" data-tab=\"diagram\">Diagram</a>\n    <a href=\"#barvy\" data-tab=\"barvy\">Barvy a písmo</a>\n    <a href=\"#filtry\" data-tab=\"filtry\">Filtry</a>\n    <a href=\"#email\" data-tab=\"email\">E-mail</a>\n  </nav>\n\n  <section class=\"stage\" id=\"model-3d\" data-view>\n    <div class=\"demo\">\n      <canvas id=\"ship\" aria-label=\"3D model lodi Crewship na vlnách, otáčí se tažením myši\"></canvas>\n      <div class=\"hint\">Táhni myší nebo prstem pro otočení · kolečko přibližuje</div>\n    </div>\n    <div class=\"about\">\n      <div class=\"eyebrow\">WebGL · three.js</div>\n      <h2>3D objekty přímo ve stránce</h2>\n      <p>Artefakt načte knihovnu z povoleného CDN a vykreslí živou scénu. Loď je poskládaná z geometrie v kódu, vlny se hýbou každý snímek.</p>\n      <ul>\n        <li><b>Použití:</b> náhled produktu, vizualizace architektury, hra.</li>\n        <li><b>Ovládání:</b> tažení, zoom, animace.</li>\n        <li><b>Bez serveru:</b> běží celé v prohlížeči.</li>\n      </ul>\n    </div>\n  </section>\n\n  <section class=\"stage\" id=\"diagram\" data-view hidden>\n    <div class=\"demo mermaid-box\">\n<pre class=\"mermaid\">\nflowchart LR\n  U[Uživatel] -->|zadání v CLI| K(Kapitán crew)\n  K --> R[Research agent]\n  K --> F[Frontend agent]\n  K --> O[Ops agent]\n  R --> V{Review}\n  F --> V\n  O --> V\n  V -->|schváleno| D[(Výsledek)]\n  V -->|oprava| K\n</pre>\n    </div>\n    <div class=\"about\">\n      <div class=\"eyebrow\">Mermaid · nativně</div>\n      <h2>Diagramy z textu</h2>\n      <p>Diagram se píše jako pár řádků textu a artefakt ho vykreslí sám, bez knihovny. Změníš řádek, změní se obrázek.</p>\n      <ul>\n        <li><b>Typy:</b> flowchart, sekvence, stavy, Gantt, ER.</li>\n        <li><b>V Docs:</b> diagramy s editovatelnými popisky a komentáři.</li>\n      </ul>\n    </div>\n  </section>\n\n  <section class=\"stage\" id=\"barvy\" data-view hidden>\n    <div class=\"demo\">\n      <div class=\"swatches\" role=\"group\" aria-label=\"Barva pozadí ukázky\">\n        <button class=\"sw\" type=\"button\" data-bg=\"#0F1F33\" data-fg=\"#F4F1EA\" style=\"background:#0F1F33\" aria-label=\"Hlubina\" aria-pressed=\"true\"></button>\n        <button class=\"sw\" type=\"button\" data-bg=\"#2B6C8F\" data-fg=\"#FFFFFF\" style=\"background:#2B6C8F\" aria-label=\"Moře\"></button>\n        <button class=\"sw\" type=\"button\" data-bg=\"#D9692B\" data-fg=\"#0E1B2A\" style=\"background:#D9692B\" aria-label=\"Signál\"></button>\n        <button class=\"sw\" type=\"button\" data-bg=\"#E4ECEF\" data-fg=\"#0E1B2A\" style=\"background:#E4ECEF\" aria-label=\"Mlha\"></button>\n        <button class=\"sw\" type=\"button\" data-bg=\"#1F5E40\" data-fg=\"#EAF6EF\" style=\"background:#1F5E40\" aria-label=\"Řasa\"></button>\n      </div>\n      <div class=\"pair-ctl\">\n        <label for=\"f-head\">Nadpis\n          <select id=\"f-head\">\n            <option value=\"'Bricolage Grotesque', Arial, sans-serif\">Bricolage Grotesque</option>\n            <option value=\"'IBM Plex Sans', Arial, sans-serif\">IBM Plex Sans</option>\n            <option value=\"'JetBrains Mono', 'Courier New', monospace\">JetBrains Mono</option>\n            <option value=\"Georgia, serif\">Georgia</option>\n          </select>\n        </label>\n        <label for=\"f-body\">Text\n          <select id=\"f-body\">\n            <option value=\"'IBM Plex Sans', Arial, sans-serif\">IBM Plex Sans</option>\n            <option value=\"'JetBrains Mono', 'Courier New', monospace\">JetBrains Mono</option>\n            <option value=\"Georgia, serif\">Georgia</option>\n          </select>\n        </label>\n      </div>\n      <div class=\"specimen\" id=\"specimen\" style=\"background:#0F1F33;color:#F4F1EA\">\n        <div class=\"big\" id=\"spec-big\" style=\"font-family:'Bricolage Grotesque', Arial, sans-serif;font-weight:700\">Posádka vyplouvá v 6:00</div>\n        <div class=\"small\" id=\"spec-small\">Kapitán rozdělil 12 úkolů mezi tři agenty. Ranní report dorazí do schránky, jakmile review schválí výsledek.</div>\n      </div>\n      <div class=\"contrast\" id=\"contrast\">Kontrast —</div>\n    </div>\n    <div class=\"about\">\n      <div class=\"eyebrow\">Barvy · typografie</div>\n      <h2>Párování barev a písma</h2>\n      <p>Vyber pozadí a dvojici písem; ukázka se hned přebarví a spočítá kontrast textu podle WCAG.</p>\n      <ul>\n        <li><b>Google Fonts:</b> jediný povolený zdroj písma.</li>\n        <li><b>Světlý i tmavý režim:</b> stránka sleduje motiv prohlížeče.</li>\n        <li><b>Design System</b> artefakt ukládá tokeny pro další práci.</li>\n      </ul>\n    </div>\n  </section>\n\n  <section class=\"stage\" id=\"filtry\" data-view hidden>\n    <div class=\"demo\">\n      <label for=\"q\" class=\"eyebrow\" style=\"display:block;margin-bottom:6px\">Hledat úkol</label>\n      <input type=\"search\" id=\"q\" placeholder=\"např. stage, redesign\" style=\"width:100%;box-sizing:border-box\">\n      <div class=\"chips\" role=\"group\" aria-label=\"Stav\">\n        <button class=\"chip\" type=\"button\" data-st=\"\" aria-pressed=\"true\">Vše</button>\n        <button class=\"chip\" type=\"button\" data-st=\"work\" aria-pressed=\"false\">Pracuje</button>\n        <button class=\"chip\" type=\"button\" data-st=\"rev\" aria-pressed=\"false\">Review</button>\n        <button class=\"chip\" type=\"button\" data-st=\"done\" aria-pressed=\"false\">Hotovo</button>\n      </div>\n      <div class=\"chips\" role=\"group\" aria-label=\"Crew\">\n        <button class=\"chip\" type=\"button\" data-crew=\"\" aria-pressed=\"true\">Všechny crew</button>\n        <button class=\"chip\" type=\"button\" data-crew=\"Research\" aria-pressed=\"false\">Research</button>\n        <button class=\"chip\" type=\"button\" data-crew=\"Frontend\" aria-pressed=\"false\">Frontend</button>\n        <button class=\"chip\" type=\"button\" data-crew=\"Ops\" aria-pressed=\"false\">Ops</button>\n      </div>\n      <div class=\"list\" id=\"list\" aria-live=\"polite\"></div>\n    </div>\n    <div class=\"about\">\n      <div class=\"eyebrow\">Interaktivita</div>\n      <h2>Filtry a vyhledávání</h2>\n      <p>Seznam se filtruje okamžitě podle textu, stavu a crew. Úkoly jsou ukázková data.</p>\n      <ul>\n        <li><b>V Dashboardu:</b> filtr přepočítá i grafy a dotazy na živá data.</li>\n        <li><b>Sdílený stav:</b> s databází artefaktu vidí změny všichni.</li>\n      </ul>\n    </div>\n  </section>\n\n  <section class=\"stage\" id=\"email\" data-view hidden>\n    <div class=\"demo\">\n      <div class=\"mail\">\n        <div class=\"mail-h\"><b>Komu:</b> tym@example.com<br><b>Předmět:</b> Týdenní report Crewship · 2.–8. listopadu</div>\n        <div class=\"mail-b\">\n          <h3>Crew tento týden dokončily 38 úkolů</h3>\n          <p>Ahoj týme, posílám krátký přehled. Nejvíc práce odvedla crew Frontend, Ops dokončila kontrolu nasazení na stage.</p>\n          <table>\n            <thead><tr><th>Crew</th><th>Hotovo</th></tr></thead>\n            <tbody><tr><td>Frontend</td><td>17</td></tr><tr><td>Research</td><td>12</td></tr><tr><td>Ops</td><td>9</td></tr></tbody>\n          </table>\n          <p>Celý přehled je v dashboardu. [Tvůj podpis]</p>\n        </div>\n      </div>\n      <div class=\"mail-actions\">\n        <button class=\"btn\" type=\"button\" id=\"copy\">Zkopírovat text e-mailu</button>\n        <span id=\"copied\" aria-live=\"polite\"></span>\n      </div>\n      <textarea id=\"mailtext\" readonly aria-label=\"Text e-mailu ke zkopírování\"></textarea>\n    </div>\n    <div class=\"about\">\n      <div class=\"eyebrow\">Šablona · ukázková data</div>\n      <h2>Návrh e-mailu</h2>\n      <p>Claude připraví e-mail jako náhled; tlačítko zkopíruje text do schránky. Odeslat ho umí přes Gmail konektor, až ho připojíš.</p>\n      <ul>\n        <li><b>Použití:</b> týdenní reporty, newslettery, odpovědi klientům.</li>\n        <li><b>Odeslání:</b> stránka sama e-mail neodešle.</li>\n      </ul>\n    </div>\n  </section>\n</div>\n\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js\"></script>\n<script>\n(() => {\n  const views = ['model-3d', 'diagram', 'barvy', 'filtry', 'email'];\n  const show = () => {\n    const id = views.includes(location.hash.slice(1)) ? location.hash.slice(1) : 'model-3d';\n    document.querySelectorAll('[data-view]').forEach((s) => { s.hidden = s.id !== id; });\n    document.querySelectorAll('nav a').forEach((a) => a.setAttribute('aria-current', a.dataset.tab === id ? 'page' : 'false'));\n    if (id === 'model-3d' && window.cxResize) window.cxResize();\n  };\n  window.addEventListener('hashchange', show);\n  show();\n\n  // ---- 3D ship ----\n  const canvas = document.getElementById('ship');\n  if (window.THREE && canvas) {\n    const css = (n) => getComputedStyle(document.documentElement).getPropertyValue(n).trim();\n    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });\n    renderer.setPixelRatio(Math.min(2, window.devicePixelRatio || 1));\n    const scene = new THREE.Scene();\n    const camera = new THREE.PerspectiveCamera(38, 1.6, 0.1, 200);\n    scene.add(new THREE.HemisphereLight(0xffffff, 0x334455, 0.9));\n    const sun = new THREE.DirectionalLight(0xffffff, 0.8); sun.position.set(6, 10, 4); scene.add(sun);\n\n    const ship = new THREE.Group();\n    const hullShape = new THREE.Shape();\n    hullShape.moveTo(-4.2, 0.9); hullShape.lineTo(4.6, 0.9); hullShape.quadraticCurveTo(4.4, 0.1, 3.6, -0.5);\n    hullShape.lineTo(-3.8, -0.5); hullShape.quadraticCurveTo(-4.3, 0.1, -4.2, 0.9);\n    const hullGeo = new THREE.ExtrudeGeometry(hullShape, { depth: 1.8, bevelEnabled: true, bevelSize: 0.12, bevelThickness: 0.12, bevelSegments: 2 });\n    hullGeo.translate(0, 0, -0.9);\n    const navy = new THREE.MeshStandardMaterial({ color: 0x14304f, roughness: 0.6 });\n    const white = new THREE.MeshStandardMaterial({ color: 0xf2f4f6, roughness: 0.5 });\n    const orange = new THREE.MeshStandardMaterial({ color: 0xe8833a, roughness: 0.45 });\n    const glass = new THREE.MeshStandardMaterial({ color: 0x2b6c8f, roughness: 0.2, metalness: 0.3 });\n    ship.add(new THREE.Mesh(hullGeo, navy));\n    const stripe = new THREE.Mesh(new THREE.BoxGeometry(8.4, 0.14, 2.16), orange); stripe.position.set(0.2, 0.7, 0); ship.add(stripe);\n    const decks = [[6.6, 0.6, 1.7, -0.3, 1.3], [5.0, 0.55, 1.5, -0.4, 1.88], [3.2, 0.5, 1.3, -0.6, 2.4]];\n    for (const [w, h, d, x, y] of decks) {\n      const m = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), white); m.position.set(x, y, 0); ship.add(m);\n      const win = new THREE.Mesh(new THREE.BoxGeometry(w * 0.92, h * 0.28, d + 0.02), glass); win.position.set(x, y + 0.04, 0); ship.add(win);\n    }\n    const bridge = new THREE.Mesh(new THREE.BoxGeometry(1.2, 0.5, 1.5), white); bridge.position.set(1.4, 2.4, 0); ship.add(bridge);\n    for (const x of [-1.6, -0.5]) {\n      const f = new THREE.Mesh(new THREE.CylinderGeometry(0.3, 0.38, 1.1, 20), orange); f.position.set(x, 3.15, 0); ship.add(f);\n      const cap = new THREE.Mesh(new THREE.CylinderGeometry(0.31, 0.31, 0.16, 20), navy); cap.position.set(x, 3.74, 0); ship.add(cap);\n    }\n    scene.add(ship);\n\n    const seaGeo = new THREE.PlaneGeometry(40, 40, 60, 60); seaGeo.rotateX(-Math.PI / 2);\n    const seaMat = new THREE.MeshStandardMaterial({ color: 0x2b6c8f, roughness: 0.35, metalness: 0.1, flatShading: true, transparent: true, opacity: 0.92 });\n    const sea = new THREE.Mesh(seaGeo, seaMat); sea.position.y = -0.1; scene.add(sea);\n    const base = seaGeo.attributes.position.array.slice();\n\n    let yaw = -0.7, pitch = 0.32, dist = 15, drag = null;\n    canvas.addEventListener('pointerdown', (e) => { drag = { x: e.client