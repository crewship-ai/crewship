{"entrypoint": "index.html", "files": [{"path": "index.html", "media_type": "text/html", "content": "<title>Kalkulačka návratnosti</title><style>\n:root{--bg:#f7f8fb;--card:#fff;--ink:#14213d;--mut:#5c677d;--acc:#2563eb;--ok:#16a34a;--line:#e3e7ef}\n@media (prefers-color-scheme:dark){:root{--bg:#0f1420;--card:#171e2e;--ink:#e8ecf5;--mut:#9aa6bf;--acc:#60a5fa;--ok:#4ade80;--line:#2a3348}}\n*{box-sizing:border-box}body{margin:0;font:15px/1.5 system-ui,-apple-system,Segoe UI,Roboto,sans-serif;background:var(--bg);color:var(--ink);padding:24px}\nh1{font-size:24px;margin:0 0 4px}.sub{color:var(--mut);margin:0 0 20px}\n.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;margin-bottom:16px}\n.card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:16px}\n.k{color:var(--mut);font-size:13px}.v{font-size:26px;font-weight:700}\nbutton{font:inherit;border:0;border-radius:8px;padding:8px 14px;background:var(--acc);color:#fff;cursor:pointer}\nbutton:disabled{opacity:.5}\n.bar{display:flex;align-items:center;gap:8px;margin:6px 0}.bar span:first-child{width:150px;color:var(--mut);font-size:13px}\n.bar .t{flex:1;background:var(--line);border-radius:6px;height:22px;overflow:hidden}.bar .f{height:100%;background:var(--acc);border-radius:6px;transition:width .4s}\n.bar b{width:110px;text-align:right;font-variant-numeric:tabular-nums}\n#status{color:var(--mut);font-size:13px;min-height:1.5em}\n</style>\n<h1 id=\"artifact-title\">Kalkulačka návratnosti Crewship</h1><p class=\"sub\">Interaktivní aplikace bez serveru. Posuňte jezdce a sledujte úsporu.</p>\n<div class=\"card\">\n<label class=\"k\">Hodin ruční práce týdně: <b id=\"hv\">38</b></label><br><input id=\"h\" type=\"range\" min=\"5\" max=\"200\" value=\"38\" style=\"width:100%\">\n<label class=\"k\">Cena hodiny práce (Kč): <b id=\"cv\">650</b></label><br><input id=\"c\" type=\"range\" min=\"300\" max=\"2000\" step=\"50\" value=\"650\" style=\"width:100%\">\n<label class=\"k\">Měsíční cena Crewship (Kč): <b id=\"pv\">92500</b></label><br><input id=\"p\" type=\"range\" min=\"10000\" max=\"300000\" step=\"2500\" value=\"92500\" style=\"width:100%\">\n</div>\n<div class=\"grid\" style=\"margin-top:12px\"><div class=\"card\"><div class=\"k\">Úspora měsíčně</div><div class=\"v\" id=\"save\">…</div></div>\n<div class=\"card\"><div class=\"k\">Čistý přínos měsíčně</div><div class=\"v\" id=\"net\">…</div></div>\n<div class=\"card\"><div class=\"k\">Návratnost</div><div class=\"v\" id=\"pay\">…</div></div></div>\n<script>\nconst fmt=n=>new Intl.NumberFormat('cs-CZ',{style:'currency',currency:'CZK',maximumFractionDigits:0}).format(n)\nfunction calc(){const h=+hEl.value,c=+cEl.value,p=+pEl.value;hv.textContent=h;cv.textContent=c;pv.textContent=p.toLocaleString('cs-CZ')\nconst s=h*c*4.33;save.textContent=fmt(s);net.textContent=fmt(s-p);pay.textContent=s>p?(p/s*30).toFixed(0)+' dní':'nevyplatí se'}\nconst hEl=document.getElementById('h'),cEl=document.getElementById('c'),pEl=document.getElementById('p');[hEl,cEl,pEl].forEach(e=>e.oninput=calc);calc()\n</script>"}, {"path": "interactive.json", "media_type": "application/json", "content": "{\"schema_version\": 1}"}], "message": "Ukázka pro proklik"}