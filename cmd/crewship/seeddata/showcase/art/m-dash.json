{"entrypoint": "index.html", "files": [{"path": "index.html", "media_type": "text/html", "content": "<title>Obchod Q4 2026</title><style>\n:root{--bg:#f7f8fb;--card:#fff;--ink:#14213d;--mut:#5c677d;--acc:#2563eb;--ok:#16a34a;--line:#e3e7ef}\n@media (prefers-color-scheme:dark){:root{--bg:#0f1420;--card:#171e2e;--ink:#e8ecf5;--mut:#9aa6bf;--acc:#60a5fa;--ok:#4ade80;--line:#2a3348}}\n*{box-sizing:border-box}body{margin:0;font:15px/1.5 system-ui,-apple-system,Segoe UI,Roboto,sans-serif;background:var(--bg);color:var(--ink);padding:24px}\nh1{font-size:24px;margin:0 0 4px}.sub{color:var(--mut);margin:0 0 20px}\n.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;margin-bottom:16px}\n.card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:16px}\n.k{color:var(--mut);font-size:13px}.v{font-size:26px;font-weight:700}\nbutton{font:inherit;border:0;border-radius:8px;padding:8px 14px;background:var(--acc);color:#fff;cursor:pointer}\nbutton:disabled{opacity:.5}\n.bar{display:flex;align-items:center;gap:8px;margin:6px 0}.bar span:first-child{width:150px;color:var(--mut);font-size:13px}\n.bar .t{flex:1;background:var(--line);border-radius:6px;height:22px;overflow:hidden}.bar .f{height:100%;background:var(--acc);border-radius:6px;transition:width .4s}\n.bar b{width:110px;text-align:right;font-variant-numeric:tabular-nums}\n#status{color:var(--mut);font-size:13px;min-height:1.5em}\n</style>\n<h1 id=\"artifact-title\">Obchod Q4 2026</h1><p class=\"sub\">Živý dashboard. Data jsou v kolekci <code>pipeline</code> a agent je umí aktualizovat bez zásahu do kódu.</p>\n<div class=\"grid\"><div class=\"card\"><div class=\"k\">Pipeline celkem</div><div class=\"v\" id=\"total\">…</div></div>\n<div class=\"card\"><div class=\"k\">Vážená hodnota</div><div class=\"v\" id=\"weighted\">…</div></div>\n<div class=\"card\"><div class=\"k\">Uzavřeno</div><div class=\"v\" id=\"won\">…</div></div>\n<div class=\"card\"><div class=\"k\">Příležitostí</div><div class=\"v\" id=\"count\">…</div></div></div>\n<div class=\"card\"><div class=\"k\" style=\"margin-bottom:8px\">Vážená hodnota podle zákazníka</div><div id=\"bars\"></div></div>\n<p id=\"status\"></p>\n<script>\nconst fmt=n=>new Intl.NumberFormat('cs-CZ',{style:'currency',currency:'CZK',maximumFractionDigits:0}).format(n)\nasync function load(){\n  try{\n    const res=await crewship.data.get(\"pipeline\"); const rows=res.documents.map(d=>d.value)\n    const total=rows.reduce((s,r)=>s+r.value,0), weighted=rows.reduce((s,r)=>s+r.value*r.probability,0)\n    const won=rows.filter(r=>r.stage===\"Uzavřeno\").reduce((s,r)=>s+r.value,0)\n    document.getElementById('total').textContent=fmt(total);document.getElementById('weighted').textContent=fmt(weighted)\n    document.getElementById('won').textContent=fmt(won);document.getElementById('count').textContent=rows.length\n    const max=Math.max(...rows.map(r=>r.value*r.probability),1)\n    document.getElementById('bars').innerHTML=rows.sort((a,b)=>b.value*b.probability-a.value*a.probability).map(r=>`<div class=\"bar\"><span>${r.customer}</span><div class=\"t\"><div class=\"f\" style=\"width:${(r.value*r.probability/max*100).toFixed(1)}%\"></div></div><b>${fmt(r.value*r.probability)}</b></div>`).join('')\n    document.getElementById('status').textContent='Aktualizováno '+new Date().toLocaleTimeString('cs-CZ')\n  }catch(e){document.getElementById('status').textContent=e.message}\n}\nload();setInterval(load,15000)\n</script>"}, {"path": "interactive.json", "media_type": "application/json", "content": "{\"schema_version\": 1}"}, {"path": "dashboard.json", "media_type": "application/json", "content": "{\"schema_version\": 1, \"collections\": [\"pipeline\"]}"}], "message": "Ukázka pro proklik"}