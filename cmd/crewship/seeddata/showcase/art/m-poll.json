{"entrypoint": "index.html", "files": [{"path": "index.html", "media_type": "text/html", "content": "<title>Hlasování: kam na firemní akci</title><style>\n:root{--bg:#f7f8fb;--card:#fff;--ink:#14213d;--mut:#5c677d;--acc:#2563eb;--ok:#16a34a;--line:#e3e7ef}\n@media (prefers-color-scheme:dark){:root{--bg:#0f1420;--card:#171e2e;--ink:#e8ecf5;--mut:#9aa6bf;--acc:#60a5fa;--ok:#4ade80;--line:#2a3348}}\n*{box-sizing:border-box}body{margin:0;font:15px/1.5 system-ui,-apple-system,Segoe UI,Roboto,sans-serif;background:var(--bg);color:var(--ink);padding:24px}\nh1{font-size:24px;margin:0 0 4px}.sub{color:var(--mut);margin:0 0 20px}\n.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;margin-bottom:16px}\n.card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:16px}\n.k{color:var(--mut);font-size:13px}.v{font-size:26px;font-weight:700}\nbutton{font:inherit;border:0;border-radius:8px;padding:8px 14px;background:var(--acc);color:#fff;cursor:pointer}\nbutton:disabled{opacity:.5}\n.bar{display:flex;align-items:center;gap:8px;margin:6px 0}.bar span:first-child{width:150px;color:var(--mut);font-size:13px}\n.bar .t{flex:1;background:var(--line);border-radius:6px;height:22px;overflow:hidden}.bar .f{height:100%;background:var(--acc);border-radius:6px;transition:width .4s}\n.bar b{width:110px;text-align:right;font-variant-numeric:tabular-nums}\n#status{color:var(--mut);font-size:13px;min-height:1.5em}\n</style>\n<h1 id=\"artifact-title\">Kam vyrazíme na vánoční akci?</h1><p class=\"sub\">Interaktivní artefakt se sdílenými daty. Hlasy vidí všichni členové workspace.</p>\n<div class=\"card\" id=\"opts\"></div><p id=\"status\"></p>\n<script>\nconst OPTIONS=[[\"krkonose\",\"Chata v Krkonoších\"],[\"vinarstvi\",\"Degustace na Moravě\"],[\"escape\",\"Escape room a večeře\"],[\"lodicky\",\"Plavba po Vltavě\"]]\nlet docs={}\nasync function load(){\n  const res=await crewship.data.get(\"votes\"); docs=Object.fromEntries(res.documents.map(d=>[d.id,d]))\n  const total=OPTIONS.reduce((s,[id])=>s+(docs[id]?.value.count||0),0)||1\n  document.getElementById('opts').innerHTML=OPTIONS.map(([id,label])=>{const c=docs[id]?.value.count||0;return `<div class=\"bar\"><span>${label}</span><div class=\"t\"><div class=\"f\" style=\"width:${c/total*100}%\"></div></div><b>${c}</b> <button data-id=\"${id}\">Hlasovat</button></div>`}).join('')\n  document.querySelectorAll('button[data-id]').forEach(b=>b.onclick=()=>vote(b.dataset.id))\n}\nasync function vote(id){\n  const d=docs[id]\n  try{await crewship.data.batch(\"votes\",[{id,ifVersion:d?d.version:0,value:{count:(d?d.value.count:0)+1}}]);document.getElementById('status').textContent='Díky, hlas započten.'}\n  catch(e){document.getElementById('status').textContent='Někdo hlasoval současně, zkuste to znovu. ('+e.message+')'}\n  await load()\n}\nload();setInterval(load,10000)\n</script>"}, {"path": "interactive.json", "media_type": "application/json", "content": "{\"schema_version\": 1}"}, {"path": "dashboard.json", "media_type": "application/json", "content": "{\"schema_version\": 1, \"collections\": [\"votes\"]}"}], "message": "Ukázka pro proklik"}