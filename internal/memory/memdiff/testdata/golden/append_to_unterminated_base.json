      "kind": "delete",
      "start_line": 2,
      "line_count": 1,
      "lines": [
        "beta"
      ]
    },
    {
      "kind": "insert",
      "start_line": 2,
      "line_count": 2,
      "lines": [
        "beta\n",
        "gamma\n"
      ]
    }
  ],
  "removals": [
