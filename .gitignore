# Internal — not for public repo (Mintlify is the canonical docs source)
CLAUDE.md
internal-docs/

# Claude Code workspace — default-deny, explicit-allow.
# Ignore everything dropped under .claude/ so future PRDs, wireframes,
# scratch notes, prompts, per-user state, etc. don't accidentally land
# in the public repo. Add a `!` exception below for anything the team
# genuinely wants tracked.
.claude/*
!.claude/audits/
!.claude/commands/
!.claude/settings.json
# PRDs are forward-looking roadmap docs — tracked so they survive
# across machines and are visible to teammates. Other subdirs under
# .claude/context/ (wireframes, scratch) stay ignored by default;
# add further `!.claude/context/<subdir>/` exceptions when needed.
!.claude/context/
.claude/context/*
!.claude/context/prd/
!.claude/context/prd/**
# .claude/context/notes/ is NOT tracked in this public repo. It holds
# internal working notes (infra recon, live-instance findings) that must
# stay private — they live in the private GitLab `infrastructure/crewship-notes`.
# Do not re-add a `!` exception for it here.
.claude/context/notes/

# Local mockups / audit artifacts (kept untracked per user preference)
audit-final/
mockups/
.pentest-*/
audit/

# Byte-compiled Python from the api-contract harness (summary.py and its
# test are run directly, so nothing else creates these).
__pycache__/

# Schemathesis drops a per-project cache directory in the working dir when
# scripts/api-contract/run.sh is run from the repo root (the toml's
# in-memory example database does not cover it). Build artifact, not input.
.schemathesis/
api-contract-artifacts/
