# Build profile read by the tests (e2e/build-profile.ts). main keeps every
# experimental artifact surface off; a shared dev release switches this file to
# CREWSHIP_BUILD_PROFILE=release with the accepted flags on, and nothing else,
# and a slot build may carry a declared preview:<name> from e2e/preview-profiles/.
# The Artifacts library is on in every profile: Pages is never shown to users.
CREWSHIP_BUILD_PROFILE=main
NEXT_PUBLIC_ARTIFACTS_LIBRARY=true
NEXT_PUBLIC_CHAT_ARTIFACT_PROJECTS=false
NEXT_PUBLIC_CHAT_CRAFT_LEASE=false
