# Release profile for the A+B candidate. Accepted functions on, unaccepted off.
CREWSHIP_BUILD_PROFILE=release
NEXT_PUBLIC_ARTIFACTS_LIBRARY=true
NEXT_PUBLIC_PAGES_OPEN_ARTIFACTS=true
NEXT_PUBLIC_CHAT_ARTIFACT_CONTEXT=true
NEXT_PUBLIC_CHAT_ARTIFACT_PROJECTS=true
NEXT_PUBLIC_CHAT_CRAFT_LEASE=true
NEXT_PUBLIC_ARTIFACTS_DESIGN=true
NEXT_PUBLIC_ARTIFACT_DASHBOARDS=true
NEXT_PUBLIC_ARTIFACT_SLIDES=false
NEXT_PUBLIC_ARTIFACT_DESIGN_SYSTEM=false
NEXT_PUBLIC_ARTIFACTS_SHARING_MOCK=false
# Owner walkthrough 2026-11-07: explicitly enabled for the catalog, interactive and export check.
NEXT_PUBLIC_ARTIFACTS_SERVER_CATALOG=true
NEXT_PUBLIC_ARTIFACTS_DESIGN_EXPORT=true
