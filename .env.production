# Preview build only (branch preview/fe-artifacts-chat-20261020, never main):
# turns on every frontend Artifacts + Chat surface that is still behind a flag,
# so the owner can review them on dev1. Surfaces whose backend does not exist
# yet show their "not available" state; SMART_SECTIONS and SEARCH_FILES_FIXTURES
# run on labelled fixture data.
NEXT_PUBLIC_CHAT_ARTIFACT_CONTEXT=true
NEXT_PUBLIC_ARTIFACT_COPY_MOVE=true
NEXT_PUBLIC_CHAT_SEARCH_FILES_FIXTURES=true
NEXT_PUBLIC_CHAT_SIDEBAR_SMART_SECTIONS=true
NEXT_PUBLIC_CHAT_SIDEBAR_VIEWS=true
NEXT_PUBLIC_SLIDES_EDITOR=true
NEXT_PUBLIC_STATIC_APP_PREVIEW=true
