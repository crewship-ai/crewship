# Declared preview profile for the shared dev2 slot (#5261): the release flags,
# plus the kinds the mirrored reference artifacts need (Dashboards, Slides, the
# Design System preview) and the reviewed Design controls. A dev2 build copies
# this file to .env.production unchanged; lib/__tests__/build-profile.test.ts
# requires an exact match and refuses it on anything bound for main.
CREWSHIP_BUILD_PROFILE=preview:dev2
NEXT_PUBLIC_ARTIFACTS_LIBRARY=true
NEXT_PUBLIC_CHAT_ARTIFACT_CONTEXT=true
NEXT_PUBLIC_CHAT_ARTIFACT_PROJECTS=true
NEXT_PUBLIC_CHAT_CRAFT_LEASE=true
NEXT_PUBLIC_ARTIFACTS_DESIGN=true
NEXT_PUBLIC_ARTIFACT_DASHBOARDS=true
NEXT_PUBLIC_ARTIFACT_SLIDES=true
NEXT_PUBLIC_ARTIFACT_DESIGN_SYSTEM=true
NEXT_PUBLIC_ARTIFACTS_SHARING_MOCK=false
NEXT_PUBLIC_ARTIFACTS_DESIGN_TEXT_STYLE=true
NEXT_PUBLIC_ARTIFACTS_DESIGN_PROTOTYPE=true
NEXT_PUBLIC_ARTIFACTS_DESIGN_EXPORT=true
# Activate only with a qualified compatible Design backend and recovery binary.
NEXT_PUBLIC_ARTIFACTS_DESIGN_HIDE_LOCK=true
NEXT_PUBLIC_ARTIFACTS_DESIGN_SHAPE_STYLE=true
