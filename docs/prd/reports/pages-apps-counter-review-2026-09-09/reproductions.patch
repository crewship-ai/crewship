+func TestCountercheckRetentionKeepsAncestorAndCanShrink(t *testing.T) {
+ ctx := context.Background()
+ store := &ProjectStore{Directory:t.TempDir()}
+ p := testSourceProject()
+ var first, last string
+ for revision := int64(1); revision <= 70; revision++ {
+  p.Files[0].Content = strings.Repeat("many repeated lines for delta compression\n", 1000) + strings.Repeat("x", int(revision))
+  commit, err := store.Checkpoint(ctx,"ws","page",last,"{}","actor",revision,p)
+  if err != nil { t.Fatal(err) }; last = commit; if first == "" { first = commit }
+ }
+ repo,err := store.gitPath(ctx,"ws","page",false); if err != nil {t.Fatal(err)}
+ size := func() int64 { var n int64; err := filepath.Walk(repo,func(_ string, info os.FileInfo,err error)error{if err!=nil{return err};if !info.IsDir(){n+=info.Size()};return nil});if err!=nil{t.Fatal(err)};return n }
+ before := size()
+ release,err := store.Lease(ctx,"ws",true);if err!=nil{t.Fatal(err)};defer release()
+ if err:=store.Prune(ctx,"ws",map[string]bool{},map[string][]string{"page":{last}});err!=nil{t.Fatal(err)}
+ after:=size()
+ if _,_,err:=store.ReadCheckpoint(ctx,"ws","page",first);err!=nil{t.Fatal("ancestor unexpectedly removed",err)}
+ if after>=before{t.Fatalf("expected fixture to compact: %d -> %d",before,after)}
+ t.Logf("COUNTERCHECK retained only newest pin: earliest ancestor readable; bytes %d -> %d",before,after)
+}
