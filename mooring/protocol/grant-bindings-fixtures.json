{
  "profile": "mooring-host-grant-bindings-v1",
  "status": "pure pending request/reply metadata checks; no channel authentication, gate registration or content delivery integration",
  "rules": {
    "first_send": "Create pending once for a NEW nonce. Retries use identical bytes and original private first-send timestamp. Controller must enforce nonce freshness; never reconstruct pending for the same nonce at a newer time.",
    "clock": "Native timestamps must be CLOCK_BOOTTIME. Expiry is exclusive first_send+granted duration; reply arrival never restarts it.",
    "initial_assignment": "OwnerAcquire assigns session/fence; ticket validation assigns participant/gate/current permissions. Subsequent owner renewals retain exact identity/fence/nonce and may advance the known permission floor; delivery renewals retain exact participant permission version."
