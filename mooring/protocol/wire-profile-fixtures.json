{
  "profile": "mooring-e3-bounded-json-v1",
  "status": "proposed negotiated implementation profile; not generic PRD maxima or full wire conformance",
  "limits": {
    "raw_bytes": 262144,
    "canonical_bytes": 262144,
    "container_depth": 64,
    "structural_tokens": 32768,
    "identifier_scalars": 200
  },
  "rules": {
    "framing": "UTF-8 body bytes exclude transport length prefix or NDJSON delimiter; count all body whitespace. Every incoming and outgoing body is bounded, including base64 and envelope.",
    "depth": "Outer object/array has depth 1; only containers count.",
    "structural_tokens": "Count each opening object/array delimiter and each comma/colon outside JSON strings, including object keys; closing delimiters do not count.",
    "strict_json": "Reject duplicate keys, malformed UTF-8, unpaired surrogate escapes, nonfinite binary64. JCS binary64 normalization precedes application semantics.",
    "identifiers": "1..200 Unicode scalar values excluding U+0000; no Unicode normalization. Only schema Identifier fields, never arbitrary payload fields inferred by key name.",
    "versions": "Frozen schema Versions grammar unchanged; syntax acceptance does not imply negotiated support.",
    "expansion": "segments concatenate strings or repeat text count times; utf8_hex supplies exact bytes; expected counts MUST be verified before acceptance assertions."
  },
