    },
    "DeliveryRenew": {
      "type": "object",
      "properties": {
        "type": {
          "const": "delivery_renew"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "participant_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "fence": {
          "$ref": "#/$defs/Fence"
        },
        "permission_version": {
          "$ref": "#/$defs/Counter"
        },
        "renewal_nonce": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "type",
        "request_id",
        "scope",
        "session_id",
        "participant_ref",
        "fence",
        "permission_version",
        "renewal_nonce"
