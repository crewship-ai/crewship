        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "fence": {
          "$ref": "#/$defs/Fence"
        }
      },
      "required": [
        "type",
        "request_id",
        "scope",
        "session_id",
        "fence"
      ],
      "additionalProperties": false
    },
    "OwnerGrant": {
      "type": "object",
      "properties": {
        "type": {
          "const": "owner_grant"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "runtime_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "fence": {
          "$ref": "#/$defs/Fence"
        },
        "lease_duration_ms": {
          "$ref": "#/$defs/Counter"
        },
        "revision": {
          "$ref": "#/$defs/Counter"
        }
      },
      "required": [
        "type",
        "request_id",
        "scope",
        "session_id",
        "runtime_ref",
        "fence",
        "lease_duration_ms",
        "revision"
      ],
