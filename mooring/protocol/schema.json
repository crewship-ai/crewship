    "DeliveryGrant": {
      "type": "object",
      "properties": {
        "type": {
          "const": "delivery_grant"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "participant_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "generation": {
          "$ref": "#/$defs/Counter"
        },
        "permission_version": {
          "$ref": "#/$defs/Counter"
        },
        "renewal_nonce": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "duration_ms": {
