{
  "profile": "mooring-host-boundary-v1",
  "status": "pure validator fixtures; trusted context is caller-attested, not cryptographic evidence or live integration",
  "rules": {
    "receipts": "Host transport independent of issuer; exact pending atomic membership; continuous per-op revisions inside each atomic range; old/new ranges may have gaps and reorder; no overlapping saved ranges.",
    "durability": "Outer node permits replicated members without rewriting them; outer replicated requires all saved members replicated. All-rejected label is no Saved claim.",
    "provenance": "crewship is logical host identity, stable across process restart; different issuer imports require a future provenance protocol."
  },
