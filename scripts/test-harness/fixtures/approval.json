{
  "dsl_version": "1.0",
  "name": "approval",
  "description": "Explicit integration harness prerequisite; not part of the demo seed.",
  "steps": [
    {
      "id": "approve",
      "type": "wait",
      "wait": {
        "kind": "approval",
        "approval_title": "Harness approval",
        "approval_prompt": "Approve this local harness probe?"
      },
      "timeout_seconds": 120
    },
    {
      "id": "done",
      "type": "transform",
      "needs": [
        "approve"
      ],
      "transform": {
        "input": "approved",
        "expression": "."
      }
    }
  ],
  "agentless": true,
  "inputs": [
    {
      "name": "action",
      "type": "string",
      "default": "harness probe"
    }
  ]
}
