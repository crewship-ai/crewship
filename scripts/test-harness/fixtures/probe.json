{
  "dsl_version": "1.0",
  "name": "probe",
  "description": "Explicit integration harness prerequisite; not part of the demo seed.",
  "steps": [
    {
      "id": "probe",
      "type": "code",
      "code": {
        "runtime": "expr",
        "code": "{{ inputs.spend_usd }} > {{ inputs.threshold_usd }}"
      },
      "timeout_seconds": 15
    }
  ],
  "agentless": true,
  "inputs": [
    {
      "name": "spend_usd",
      "type": "number",
      "default": 3
    },
    {
      "name": "threshold_usd",
      "type": "number",
      "default": 5
    }
  ]
}
