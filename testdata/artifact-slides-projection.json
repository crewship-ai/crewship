{
  "deck": {
    "schema_version": 1, "deck_id": "page", "width": 1920, "height": 1080,
    "theme": { "background": "#FFFFFF", "color": "#111111", "font_family": "Go Regular", "font_size": 32 },
    "slide_order": ["intro", "details"],
    "slides": [
      { "id": "intro", "notes": "Opening note", "elements": [
        { "id": "title", "type": "text", "x": 40, "y": 40, "width": 1000, "height": 100,
          "text": { "value": "Revenue", "font_family": "Go Regular", "font_size": 32, "color": "#111111", "align": "left" } },
        { "id": "ornament", "type": "shape", "x": 1200, "y": 40, "width": 100, "height": 100,
          "shape": { "kind": "ellipse", "fill": "#FFFFFF", "stroke": "#111111", "stroke_width": 2 } }
      ] },
      { "id": "details", "notes": "", "elements": [
        { "id": "constructor", "type": "table", "x": 40, "y": 40, "width": 1000, "height": 200,
          "table": { "cells": [["North", "12"]], "font_family": "Go Regular", "font_size": 24, "color": "#111111", "fill": "#FFFFFF", "border": "#111111" } }
      ] }
    ]
  },
  "anchors": {
    "title": { "slide_id": "intro", "path": "slides/intro.html", "selector": "#title", "quote": "Revenue" },
    "constructor": { "slide_id": "details", "path": "slides/details.html", "selector": "#constructor", "quote": "North12" }
  }
}
